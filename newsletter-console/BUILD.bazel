load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":newsletter-console",
        "//.github/actions:release-newsletter-console/action.yml",
        "//newsletter-console/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://newsletter-console:newsletter-console",
        "release:worker:newsletter-console",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//newsletter-console/deploy:check",
        "//newsletter-console/web:check",
        "//newsletter-console/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "newsletter-console",
    srcs = [
        ":config",
        "//newsletter-console/web:bundle",
        "//newsletter-console/worker:application_sources",
        "//newsletter-console/worker:edge_auth_types_link",
        "//newsletter-console/worker:proto_types_link",
        "//newsletter-console/worker/src:lib",
    ],
    bundle_visibility = ["//newsletter-console:__subpackages__"],
    tool = "//newsletter-console/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//newsletter-console/web:bundle",
)

source_audit_files()
