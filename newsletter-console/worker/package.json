{
  "name": "newsletter-console-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Newsletter console: owner authentication and the read-only newsletter.ui.v1 transport",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //newsletter-console/worker:typecheck_tests",
    "lint": "bazel test //newsletter-console/worker:lint",
    "test": "bazel test //newsletter-console/worker:unit_tests",
    "test:runtime": "bazel test //newsletter-console/worker:runtime_tests --nocache_test_results",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //newsletter-console/web:bundle && wrangler dev --assets ../../bazel-bin/newsletter-console/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8796 --local-upstream 127.0.0.1:8796",
    "check": "bazel test //newsletter-console:check"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
