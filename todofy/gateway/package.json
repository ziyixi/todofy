{
  "name": "todofy-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Todofy edge gateway (Worker \"todofy\"): routing, auth and assets; the work runs in todofy-core.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/runtime/tsconfig.json",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "pretest:runtime": "node ../../proto/tools/ensure.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  }
}
