{
  "name": "todofy-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Todofy edge gateway (Worker \"todofy\"): routing, auth and assets; the work runs in todofy-core.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //todofy/gateway:typecheck_tests",
    "test": "bazel test //todofy/gateway:unit_tests",
    "test:runtime": "bazel test //todofy/gateway:runtime_tests --nocache_test_results",
    "lint": "bazel test //todofy/gateway:lint",
    "check": "bazel test //todofy:check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  }
}
