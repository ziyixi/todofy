load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//todofy/gateway:eslint/package_json.bzl", eslint = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//todofy:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.runtime.config.ts",
        "wrangler.toml",
    ],
    visibility = ["//todofy:__subpackages__"],
)

alias(
    name = "package_json",
    actual = ":package_metadata",
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "runtime_test_config",
    srcs = ["vitest.runtime.config.ts"],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "proto_types_package",
    deps = [
        "//proto/common/errors/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/todofy/mail/v1:ts",
        "//proto/todofy/ui/v1:ts",
        "//proto/ts:http-client",
        "//proto/ts:http-transcoder",
        "//proto/ts:page-token",
        "//proto/ts:protobuf",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
        "//todofy/gateway/src:lib",
    ],
)

workspace_package_link(
    name = "proto_types_link",
    src = ":proto_types_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_types_link",
    src = "//packages/edge-auth:pkg",
)

ts_project(
    name = "types",
    srcs = [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
        "//todofy/gateway/src:types_srcs",
        "//todofy/gateway/test:types_srcs",
    ],
    data = [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
        "//todofy/gateway/test:types_data",
    ],
    no_emit = True,
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/vitest",
        ":proto_types_link",
        "//contracts:ops-v1/fixtures/CanaryResult/processing-paused.json_data",
        "//contracts:ops-v1/fixtures/GuardState/shed-todofy.json_data",
        "//contracts:ops-v1/fixtures/OpsStatus/todofy-degraded.json_data",
        "//todofy/gateway/src:lib",
        "//todofy/worker/todofy/core:gateway_error_contract",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

js_library(
    name = "application_sources",
    srcs = ["//todofy/gateway/src:application_sources_srcs"] + glob([
        "package.json",
        "tsconfig.json",
        "wrangler.toml",
    ]),
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
        "//todofy/gateway/test:check",
    ],
)

js_run_binary(
    name = "bundle",
    srcs = [
        ":application_sources",
        ":edge_auth_types_link",
        ":proto_types_link",
        "//todofy/gateway/src:lib",
        "//todofy/web:bundle",
    ],
    args = [
        "deploy",
        "--dry-run",
        "--config",
        "wrangler.toml",
        "--assets",
        "../web/dist",
        "--outdir",
        "gateway_bundle",
    ],
    chdir = "todofy/gateway",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["gateway_bundle"],
    tool = "//tools/bazel:wrangler",
)

ts_config(
    name = "worker_config",
    src = ":tsconfig.json",
)

ts_config(
    name = "runtime_config",
    src = "//todofy/gateway/test:source_runtime_tsconfig_json",
    deps = [":worker_config"],
)

ts_project(
    name = "runtime_types",
    srcs = [":proto_types_package_wire_types"] + ["//todofy/gateway/test:runtime_types_srcs"],
    extends = ":runtime_config",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":proto_types_link",
        "//:node_modules/@cloudflare/workers-types",
        "//contracts:ops-v1/fixtures/CanaryResult/processing-paused.json_data",
        "//contracts:ops-v1/fixtures/GuardState/shed-todofy.json_data",
        "//contracts:ops-v1/fixtures/OpsStatus/todofy-degraded.json_data",
        "//todofy/gateway/src:lib",
        "//todofy/gateway/test:test_support",
        "//todofy/worker/todofy/core:gateway_error_contract",
        "//tools/workerd-cpu:types",
    ],
)

js_library(
    name = "config",
    srcs = [":wrangler.toml"],
    visibility = ["//visibility:public"],
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/miniflare",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":package.json",
        ":proto_types_link",
        ":tsconfig.json",
        "//:node_modules/@cloudflare/workers-types",
        "//contracts:ops-v1/fixtures/CanaryResult/processing-paused.json_data",
        "//contracts:ops-v1/fixtures/GuardState/shed-todofy.json_data",
        "//contracts:ops-v1/fixtures/OpsStatus/todofy-degraded.json_data",
        "//todofy/gateway/src:lib",
        "//todofy/gateway/test:lint_data",
        "//todofy/gateway/test:runtime_helpers",
        "//todofy/gateway/test:test_support",
        "//todofy/worker/todofy/core:gateway_error_contract",
        "//tools/workerd-cpu:types",
    ],
    runner = eslint.eslint_binary,
    sources = ["//todofy/gateway/src:lint_sources"] + ["//todofy/gateway/test:lint_sources"] + glob(
        [
            "scripts/**/*.mjs",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

js_library(
    name = "package_metadata",
    srcs = [":package.json"],
)

filegroup(
    name = "runtime_test_inputs",
    srcs = [
        ":application_sources",
        ":edge_auth_types_link",
        ":proto_types_link",
        "//todofy/gateway/src:lib",
    ] + glob(["wrangler.test*.toml"]),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//todofy/gateway/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
    ],
)

test_suite(
    name = "runtime_tests",
    tests = ["//todofy/gateway/test:runtime_tests"],
)

alias(
    name = "lib",
    actual = "//todofy/gateway/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
        "test/**",
    ],
    deps = [
        "//todofy/gateway/src:source_audit_files",
        "//todofy/gateway/test:source_audit_files",
    ],
)
