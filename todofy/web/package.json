{
  "name": "todofy-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Todofy owner UI, served by the Worker from ../uiassets/dist.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "typecheck": "bazel test //todofy/web:typecheck_tests",
    "test": "bazel test //todofy/web:unit_tests",
    "build": "bazel build //todofy/web:bundle",
    "check": "bazel test //todofy:check"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@ziyixi/proto": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
