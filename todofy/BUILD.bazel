load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:packaging.bzl", "py_package")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release",
    srcs = [
        ":todofy",
        "//.github/actions:release-todofy/action.yml",
        "//todofy/deploy:release_wrapper",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://todofy:todofy",
        "release:worker:todofy",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "migrations",
    srcs = glob(["migrations/*.sql"]),
)

py_package(
    name = "core_proto_sources",
    packages = ["proto/python/src"],
    deps = ["//proto:python"],
)

py_package(
    name = "core_client_sources",
    packages = ["packages/model-router-client/python/src"],
    deps = ["//packages/model-router-client/python/src/model_router_client:package"],
)

copy_to_directory(
    name = "core_python_modules",
    srcs = [
        ":core_client_sources",
        ":core_proto_sources",
        "//tools/bazel/python:pyvenv.cfg",
        "@workers_runtime_sdk//:files",
    ],
    out = "python_modules",
    exclude_srcs_patterns = [
        "BUILD.bazel",
        "WORKSPACE",
        "WORKSPACE.bazel",
        "REPO.bazel",
    ],
    include_external_repositories = ["*"],
    root_paths = [
        "proto/python/src",
        "packages/model-router-client/python/src",
        "tools/bazel/python",
    ],
)

js_library(
    name = "core_application_sources",
    srcs = [
        "pylock.toml",
        "pyproject.toml",
        "wrangler.toml",
    ] + glob(["migrations/*.sql"]) + ["//todofy/worker:node_sources"],
)

js_run_binary(
    name = "core_bundle",
    srcs = [
        ":core_application_sources",
        ":core_python_modules",
    ],
    args = [
        "deploy",
        "--dry-run",
        "--config",
        "wrangler.toml",
        "--outdir",
        "core_bundle",
    ],
    chdir = "todofy",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    out_dirs = ["core_bundle"],
    tool = "//tools/bazel:wrangler",
)

pkg_files(
    name = "core_release_files",
    srcs = [":core_bundle"],
    prefix = "core",
    renames = {":core_bundle": REMOVE_BASE_DIRECTORY},
)

pkg_files(
    name = "gateway_release_files",
    srcs = ["//todofy/gateway:bundle"],
    prefix = "gateway",
    renames = {"//todofy/gateway:bundle": REMOVE_BASE_DIRECTORY},
)

pkg_files(
    name = "web_release_files",
    srcs = ["//todofy/web:bundle"],
    prefix = "assets",
    renames = {"//todofy/web:bundle": REMOVE_BASE_DIRECTORY},
)

filegroup(
    name = "config",
    srcs = [
        "app.toml",
        "pylock.toml",
        "pyproject.toml",
        "wrangler.toml",
        ":migrations",
        "//todofy/gateway:config",
    ],
)

pkg_files(
    name = "release_config_files",
    srcs = [":config"],
    prefix = "config",
    strip_prefix = strip_prefix.from_root("todofy"),
)

pkg_tar(
    name = "todofy",
    srcs = [
        ":core_release_files",
        ":gateway_release_files",
        ":release_config_files",
        ":web_release_files",
    ],
    extension = "tar.gz",
    tags = ["manual"],
)

test_suite(
    name = "check",
    tests = [
        ":host_python_tests",
        ":legacy_d1_roundtrip_test",
        ":ruff_check_test",
        ":ruff_format_test",
        ":runtime_tests",
        ":tests",
        "//todofy/deploy:check",
        "//todofy/gateway:check",
        "//todofy/tests:check",
        "//todofy/tools:check",
        "//todofy/web:check",
        "//tools/bazel/python:worker_runtime_lock_test",
    ],
)

source_audit_files(
    patterns = [
        "*",
        "docs/**",
        "migrations/**",
    ],
    deps = [
        "//todofy/api:source_audit_files",
        "//todofy/checks:source_audit_files",
        "//todofy/tests:source_audit_files",
        "//todofy/tools:source_audit_files",
        "//todofy/worker:source_audit_files",
    ],
)

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "python_lint_inputs",
    srcs = [
        "pyproject.toml",
        "//todofy/deploy:python_lint_inputs",
    ] + [
        "//todofy/api:python_sources",
        "//todofy/tests:python_sources",
        "//todofy/tools:python_sources",
        "//todofy/worker:python_sources",
    ],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)

test_suite(
    name = "host_python_tests",
    tests = ["//todofy/tests:host_python_tests"],
)

test_suite(
    name = "legacy_d1_roundtrip_test",
    tests = ["//todofy/tools/legacy_migration:legacy_d1_roundtrip_test"],
)

alias(
    name = "library",
    actual = "//todofy/worker/todofy:library",
)

test_suite(
    name = "ruff_check_test",
    tests = ["//todofy/checks:ruff_check_test"],
)

test_suite(
    name = "ruff_format_test",
    tests = ["//todofy/checks:ruff_format_test"],
)

test_suite(
    name = "runtime_test_routing",
    tests = ["//todofy/tests/runtime:test_routing"],
)

test_suite(
    name = "runtime_tests",
    tests = ["//todofy/tests/runtime:runtime_tests"],
)

test_suite(
    name = "tests",
    tests = ["//todofy/tests/unit:tests"],
)

exports_files([
    "pyproject.toml",
    "conftest.py",
])
