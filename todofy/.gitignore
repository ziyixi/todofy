# Node toolchain (wrangler) and the UI
node_modules/
web/node_modules/
uiassets/dist/

# Python toolchain; pywrangler recreates the vendored SDK
.venv/
.venv-workers/
python_modules/
__pycache__/
.pytest_cache/
.ruff_cache/

# Local workerd/D1 state and dev values (see .dev.vars.example)
.wrangler/
.dev.vars*
!.dev.vars.example
# Per-test core configs written by tests/runtime/harness.py (removed when the test server stops)
wrangler.test-run-*.json

# Written by the retired CI config generator (production is the committed wrangler.toml files now); a
# local copy may still hold owner emails or the Todoist project, so keep ignoring them
wrangler.production.ci.json
wrangler.production.secrets.json
gateway/wrangler.production.ci.json
gateway/wrangler.production.secrets.json

# Migration output and snapshots hold mail content
tools/legacy_migration/out/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Scratch output of local checks
/tmp/
