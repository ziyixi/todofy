load("@rules_python//python:defs.bzl", "py_library")
load("//todofy/tests/runtime:defs.bzl", "todofy_runtime_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/python:tests.bzl", "pytest_test")

package(default_visibility = ["//todofy:__subpackages__"])

py_library(
    name = "legacy_migration_tools",
    srcs = [
        "fixtures/synthetic.py",
        "legacy_to_d1.py",
        "snapshot.py",
        "verify_d1.py",
    ],
    imports = ["."],
)

pytest_test(
    name = "host_legacy_to_d1_test",
    srcs = ["test_legacy_to_d1.py"],
    args = ["$(rootpath test_legacy_to_d1.py)"],
    config = "//todofy:pyproject.toml",
    data = [
        "conftest.py",
        "fixtures/inbox_schema.sql",
        "fixtures/todofy_schema.sql",
        "//todofy:config",
        "//todofy:conftest.py",
        "//todofy:migrations",
        "//todofy/api:api_schemas",
    ],
    env = {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
        "BAZEL_COPY_WORKSPACE": "1",
    },
    imports = [
        ".",
        "../..",
        "../../worker",
    ],
    plugins = [
        "xdist.plugin",
        "xdist.looponfail",
    ],
    deps = [
        ":legacy_migration_tools",
        "//todofy/worker/todofy/core:render",
        "//todofy/worker/todofy/core:vocab",
        "@python_deps//pytest_xdist",
    ],
)

pytest_test(
    name = "host_legacy_snapshot_test",
    srcs = ["test_snapshot.py"],
    args = ["$(rootpath test_snapshot.py)"],
    config = "//todofy:pyproject.toml",
    data = [
        "conftest.py",
        "fixtures/inbox_schema.sql",
        "fixtures/todofy_schema.sql",
        "//todofy:config",
        "//todofy:conftest.py",
        "//todofy:migrations",
        "//todofy/api:api_schemas",
    ],
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    imports = [
        ".",
        "../..",
        "../../worker",
    ],
    plugins = [
        "xdist.plugin",
        "xdist.looponfail",
    ],
    deps = [
        ":legacy_migration_tools",
        "@python_deps//pytest_xdist",
    ],
)

todofy_runtime_test(
    name = "legacy_d1_roundtrip_test",
    size = "large",
    data = [
        "conftest.py",
        "fixtures/inbox_schema.sql",
        "fixtures/todofy_schema.sql",
        "//todofy/tests/runtime:runtime_data",
        "//tools/bazel:wrangler",
        "//tools/bazel/python:workerd_path",
        "@todofy_pyodide//file",
    ],
    env = {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
        "BAZEL_WRANGLER": "$(rootpath //tools/bazel:wrangler)",
        "BAZEL_WORKERD": "$(rootpath //tools/bazel/python:workerd_path)",
        "BAZEL_PYODIDE": "$(rootpath @todofy_pyodide//file)",
    },
    imports = [
        ".",
        "../..",
        "../../worker",
    ],
    source = "test_roundtrip_d1.py",
    tags = [
        "exclusive",
        "workerd",
    ],
    deps = [
        ":legacy_migration_tools",
        "@python_deps//pytest",
        "@python_deps//pytest_xdist",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":host_legacy_snapshot_test",
        ":host_legacy_to_d1_test",
        ":legacy_d1_roundtrip_test",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
