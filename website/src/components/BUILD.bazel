    name = "ExpandableArticleImage",
    srcs = [
        ":ExpandableArticleImage.tsx",
        "//website/src/styles:article_css",
    ],
    deps = [
        "//website:node_modules/next",
        "//website:node_modules/photoswipe",
        "//website:node_modules/react-photoswipe-gallery",
    ],
)

js_library(
    name = "ArticleToc",
