        "//website/src/styles:site_css",
    ],
    deps = ["//website/src/lib/content:index"],
)

js_library(
    name = "ArticleBody",
    srcs = [
        ":ArticleBody.tsx",
        "//website/src/styles:article_css",
    ],
    deps = [
        ":ArticleToc",
        ":ExpandableArticleImage",
        "//website:node_modules/katex",
        "//website:node_modules/react",
        "//website:node_modules/shiki",
        "//website/src/lib/content:equation",
        "//website/src/lib/content:index",
        "//website/src/lib/content:video-embed",
