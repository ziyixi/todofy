{
  "name": "ziyixi-personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ziyi Xi's personal academic and engineering website.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "content:prepare": "node --import tsx scripts/content/prepare.ts",
    "content:prepare:empty": "node --import tsx scripts/content/prepare.ts --source=empty --baseline=tests/fixtures/baseline-empty.json",
    "content:prepare:fixture": "node --import tsx scripts/content/prepare.ts --source=fixture --baseline=tests/fixtures/baseline-empty.json",
    "content:validate": "node --import tsx scripts/content/validate.ts",
    "dev": "next dev",
    "build": "pnpm content:validate && pnpm build:site",
    "build:site": "next build && node --import tsx scripts/export/finalize.ts",
    "start": "wrangler dev --config wrangler.toml --ip 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:deployment": "DEPLOYMENT_TEST_REQUIRED=1 playwright test tests/e2e/deployment.spec.ts --project=desktop-chromium",
    "test": "pnpm test:unit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "images:prepare": "node --import tsx scripts/images/prepare.ts",
    "release": "node --import tsx scripts/release/cli.ts",
    "postinstall": "node ../proto/tools/ensure.mjs",
    "pretypecheck": "node ../proto/tools/ensure.mjs",
    "pretest:unit": "node ../proto/tools/ensure.mjs",
    "prelint": "node ../proto/tools/ensure.mjs",
    "prestart": "node ../proto/tools/ensure.mjs"
  },
  "dependencies": {
    "@notionhq/client": "catalog:",
    "katex": "catalog:",
    "next": "catalog:",
    "photoswipe": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-photoswipe-gallery": "catalog:",
    "sharp": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@types/katex": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "smol-toml": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@cloudflare/workers-types": "catalog:"
  }
}
