# Required for make sync / make preview and production blogSource: "notion".
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2026-03-11

# Optional build identity supplied by CI.
CODE_SHA=

# When set, this must exactly match content/site.config.ts canonicalOrigin.
SITE_URL=

# The relay Worker's secrets (GITHUB_DISPATCH_TOKEN, NOTION_WEBHOOK_SECRET, NOTION_TOKEN,
# NOTION_DATA_SOURCE_ID) are Worker secrets set with `wrangler secret put`; the relay deploys only
# from GitHub Actions (docs/cutover.md). Keep any local copies in .env.local, never in git.
