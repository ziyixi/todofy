# Required for make sync / make preview and production blogSource: "notion".
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2026-03-11

# Optional build identity supplied by CI.
CODE_SHA=

# When set, this must exactly match content/site.config.ts canonicalOrigin.
SITE_URL=

# Optional: only for deploying the Cloudflare Notion publish button relay.
# These are not website/Vercel variables. Keep actual values in .env.local.
GITHUB_DISPATCH_TOKEN=
NOTION_WEBHOOK_SECRET=
