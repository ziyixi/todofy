# Required for make sync / make preview and production blogSource: "notion".
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2026-03-11

# Optional build identity supplied by CI.
CODE_SHA=

# When set, this must exactly match content/site.config.ts canonicalOrigin.
SITE_URL=

# The relay holds only GITHUB_DISPATCH_TOKEN (Actions read/write, Deployments read).
# Actions holds the content-reading Notion credentials. The relay deploys only from GitHub Actions.
