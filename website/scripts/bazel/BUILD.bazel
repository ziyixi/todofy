load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//website:eslint/package_json.bzl", eslint = "bin")
load("@npm//website:prettier/package_json.bzl", prettier = "bin")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel:js.bzl", "copied_source_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")
load("//website:bazel.bzl", "website_sources")

package(default_visibility = ["//website:__subpackages__"])

exports_files(
    glob(
        ["*.ts"],
        allow_empty = True,
    ),
    visibility = ["//website:__subpackages__"],
)

js_library(
    name = "prepare-empty",
    srcs = [":prepare-empty.ts"],
    deps = ["//website/scripts/content:prepare"],
)

js_library(
    name = "snapshot",
    srcs = [":snapshot.ts"],
    deps = ["//website/scripts/content:validate"],
)

tsx.tsx_test(
    name = "types_test",
    size = "large",
    args = ["scripts/bazel/typecheck.ts"],
    chdir = "website",
    data = [
        ":check_sources",
        "//:node_modules/@types/react",
        "//website:node_modules/@axe-core/playwright",
        "//website:node_modules/@cloudflare/workers-types",
        "//website:node_modules/@notionhq/client",
        "//website:node_modules/@playwright/test",
        "//website:node_modules/@types/katex",
        "//website:node_modules/@types/node",
        "//website:node_modules/@types/react",
        "//website:node_modules/@types/react-dom",
        "//website:node_modules/katex",
        "//website:node_modules/next",
        "//website:node_modules/photoswipe",
        "//website:node_modules/react",
        "//website:node_modules/react-dom",
        "//website:node_modules/react-photoswipe-gallery",
        "//website:node_modules/sharp",
        "//website:node_modules/shiki",
        "//website:node_modules/smol-toml",
        "//website:node_modules/tsx",
        "//website:node_modules/typescript",
        "//website:node_modules/vitest",
        "//website:node_modules/zod",
        "//website:prepare_empty",
        "//website:relay_proto_link",
        "//website/content:data",
    ],
    env = {
        "CI": "true",
        "NEXT_TELEMETRY_DISABLED": "1",
    },
    tags = ["typecheck"],
)

prettier.prettier_binary(name = "prettier")

js_library(
    name = "source-identity",
    srcs = [":source-identity.ts"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":types_test"],
)

copied_source_files(
    name = "check_sources",
    srcs = [
        "//website/content:files",
        "//website/relay:files",
        "//website/scripts:files",
        "//website/src:files",
        "//website/tests:files",
    ] + [
        "//website:eslint_config",
        "//website:next_config",
        "//website:next_env",
        "//website:package_metadata",
        "//website:playwright_config",
        "//website:prettier_config",
        "//website:typescript_config",
        "//website:vitest_config",
    ],
)

eslint_test(
    name = "lint",
    args = ["--max-warnings=0"],
    config = "//website:eslint_config",
    data = [
        ":check_sources",
        "//:node_modules/next",
        "//website:node_modules/eslint",
        "//website:node_modules/eslint-config-next",
        "//website:node_modules/eslint-config-prettier",
        "//website:node_modules/next",
        "//website:node_modules/react",
        "//website:node_modules/typescript",
        "//website:package_metadata",
        "//website:relay_proto_link",
        "//website:typescript_config",
        "//website/content:data",
    ],
    project = "website",
    runner = eslint.eslint_binary,
    sources = [
        "//website:lint_sources",
        "//website/content:lint_sources",
        "//website/relay:lint_sources",
        "//website/scripts:lint_sources",
        "//website/src:lint_sources",
        "//website/tests:lint_sources",
    ],
)

