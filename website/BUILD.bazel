load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "copied_source_files", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")

package(default_visibility = ["//website:__subpackages__"])

exports_files(
    [
        ".prettierignore",
        "app.toml",
        "eslint.config.mjs",
        "next-env.d.ts",
        "next.config.ts",
        "package.json",
        "playwright.config.ts",
        "prettier.config.mjs",
        "tsconfig.json",
        "vitest.config.ts",
        "wrangler.toml",
    ],
    visibility = ["//website:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

tsx.tsx_binary(name = "tsx")

js_run_binary(
    name = "prepare_empty",
    srcs = [
        ":package.json",
        ":tsconfig.json",
        "//website/content:data",
        "//website/scripts/bazel:prepare-empty",
    ],
    outs = [".generated/images.json"],
    args = ["scripts/bazel/prepare-empty.ts"],
    chdir = "website",
    env = {"NEXT_TELEMETRY_DISABLED": "1"},
    include_transitive_types = True,
    include_types = True,
    out_dirs = [
        ".generated/content",
        "public/media",
        "public/_img",
    ],
    tool = ":tsx",
)

js_library(
    name = "public_config",
    srcs = [":wrangler.toml"],
)

js_run_binary(
    name = "empty_site",
    srcs = [
        ":next.config.ts",
        ":next-env.d.ts",
        ":node_modules/@axe-core/playwright",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@notionhq/client",
        ":node_modules/@playwright/test",
        ":node_modules/@types/katex",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/eslint",
        ":node_modules/eslint-config-next",
        ":node_modules/eslint-config-prettier",
        ":node_modules/katex",
        ":node_modules/next",
        ":node_modules/photoswipe",
        ":node_modules/prettier",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-photoswipe-gallery",
        ":node_modules/sharp",
        ":node_modules/shiki",
        ":node_modules/smol-toml",
        ":node_modules/tsx",
        ":node_modules/typescript",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":node_modules/zod",
        ":package.json",
        ":prepare_empty",
        ":tsconfig.json",
        "//:node_modules/@types/react",
        "//website/content:data",
        "//website/src:application_sources",
    ],
    args = ["scripts/bazel/build-site.ts"],
    chdir = "website",
    env = {
        "NEXT_TELEMETRY_DISABLED": "1",
        "CI": "true",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = [
        ".next",
        "out",
    ],
    tool = ":tsx",
    use_execroot_entry_point = True,
)

copy_to_directory(
    name = "prepared_snapshot",
    srcs = ["@website_content//:files"],
    include_external_repositories = ["*"],
    root_paths = ["."],
)

js_run_binary(
    name = "site",
    srcs = [
        ":next.config.ts",
        ":next-env.d.ts",
        ":node_modules/@axe-core/playwright",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@notionhq/client",
        ":node_modules/@playwright/test",
        ":node_modules/@types/katex",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/eslint",
        ":node_modules/eslint-config-next",
        ":node_modules/eslint-config-prettier",
        ":node_modules/katex",
        ":node_modules/next",
        ":node_modules/photoswipe",
        ":node_modules/prettier",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-photoswipe-gallery",
        ":node_modules/sharp",
        ":node_modules/shiki",
        ":node_modules/smol-toml",
        ":node_modules/tsx",
        ":node_modules/typescript",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":node_modules/zod",
        ":package.json",
        ":prepared_snapshot",
        ":site_identity",
        ":tsconfig.json",
        "//:node_modules/@types/react",
        "//website/content:data",
        "//website/src:application_sources",
    ],
    args = [
        "scripts/bazel/build-prepared.ts",
        "$(location :prepared_snapshot)",
    ],
    chdir = "website",
    env = {
        "NEXT_TELEMETRY_DISABLED": "1",
        "CI": "true",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["site"],
    tool = ":tsx",
    use_execroot_entry_point = True,
)

filegroup(
    name = "config",
    srcs = [
        ":app.toml",
        ":wrangler.toml",
        "//website/relay:wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "website",
    srcs = [
        ":site",
        ":site_config",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

expand_template(
    name = "site_identity",
    out = "site_identity.json",
    stamp = -1,
    stamp_substitutions = {"__CODE_SHA__": "{{BUILD_EMBED_LABEL}}"},
    substitutions = {"__CODE_SHA__": "local-development"},
    template = ['{"code_sha":"__CODE_SHA__"}'],
)

js_run_binary(
    name = "relay_bundle",
    srcs = [
        ":node_modules/wrangler",
        ":package.json",
        ":relay_proto_link",
        "//website/relay:proto_link",
        "//website/relay:sources",
        "//website/relay/src:index",
        "//website/scripts/bazel:build-relay_source",
    ],
    args = ["scripts/bazel/build-relay.ts"],
    chdir = "website",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    out_dirs = ["relay_bundle"],
    tool = ":tsx",
)

pkg_files(
    name = "relay_worker_files",
    srcs = [":relay_bundle"],
    prefix = "worker",
    strip_prefix = strip_prefix.from_pkg("relay_bundle"),
)

pkg_files(
    name = "relay_config_files",
    srcs = ["//website/relay:wrangler.toml"],
    strip_prefix = strip_prefix.from_root("website"),
)

pkg_tar(
    name = "relay_artifact",
    srcs = [
        ":relay_config_files",
        ":relay_worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

alias(
    name = "relay",
    actual = ":relay_artifact",
    visibility = ["//visibility:public"],
)

js_library(
    name = "site_config",
    srcs = [
        ":app.toml",
        ":wrangler.toml",
    ],
)

filegroup(
    name = "release",
    srcs = [
        ":website",
        "//.github/workflows:website-release.yml",
        "//website/scripts/release:cli",
        "//website/tests/e2e:verify_deployment",
    ],
    tags = [
        "artifact://website:website",
        "release:website:website",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "relay_release",
    srcs = [
        ":relay",
        "//.github/actions:release-website-relay/action.yml",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
        "//website/relay/deploy:vars",
    ],
    tags = [
        "artifact://website:relay",
        "release:worker:website-relay",
    ],
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "fixture_site",
    srcs = [
        ":next.config.ts",
        ":next-env.d.ts",
        ":node_modules/@axe-core/playwright",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@notionhq/client",
        ":node_modules/@playwright/test",
        ":node_modules/@types/katex",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/eslint",
        ":node_modules/eslint-config-next",
        ":node_modules/eslint-config-prettier",
        ":node_modules/katex",
        ":node_modules/next",
        ":node_modules/photoswipe",
        ":node_modules/prettier",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-photoswipe-gallery",
        ":node_modules/sharp",
        ":node_modules/shiki",
        ":node_modules/smol-toml",
        ":node_modules/tsx",
        ":node_modules/typescript",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":node_modules/zod",
        ":package.json",
        ":tsconfig.json",
        "//:node_modules/@types/react",
        "//website/content:data",
        "//website/scripts/bazel:build-fixture_source",
        "//website/src:application_sources",
    ],
    outs = ["fixture_manifest.json"],
    args = ["scripts/bazel/build-fixture.ts"],
    chdir = "website",
    env = {
        "NEXT_TELEMETRY_DISABLED": "1",
        "CI": "true",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["fixture_site"],
    patch_node_fs = False,
    tool = ":tsx",
    use_execroot_entry_point = True,
)

copied_source_files(
    name = "public_assets",
    srcs = glob(
        ["public/**"],
        exclude = [
            "public/media/**",
            "public/_img/**",
        ],
    ),
)

source_audit_files(
    exclude = SOURCE_AUDIT_EXCLUDES + [
        "public/media/**",
        "public/_img/**",
    ],
    patterns = [
        "*",
        "doc/**",
        "docs/**",
        "public/**",
    ],
    deps = [
        "//website/content:source_audit_files",
        "//website/relay:source_audit_files",
        "//website/scripts:source_audit_files",
        "//website/src:source_audit_files",
        "//website/tests:source_audit_files",
    ],
)

test_suite(
    name = "check",
    tests = [
        "//website/scripts/bazel:format_test",
        "//website/scripts/bazel:lint",
        "//website/scripts/bazel:types_test",
        "//website/tests/e2e:tests",
        "//website/tests/unit:tests",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "verify_deployment",
    actual = "//website/tests/e2e:verify_deployment",
    visibility = ["//visibility:public"],
)

copied_source_files(
    name = "lint_sources",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "*.mts",
            "*.mjs",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES + ["next-env.d.ts"],
    ),
)

js_library(
    name = "package_metadata",
    srcs = ["package.json"],
)

js_library(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "playwright_config",
    srcs = ["playwright.config.ts"],
)

js_library(
    name = "prettier_config",
    srcs = ["prettier.config.mjs"],
)

js_library(
    name = "prettier_ignore",
    srcs = [".prettierignore"],
)

js_library(
    name = "eslint_config",
    srcs = ["eslint.config.mjs"],
)

js_library(
    name = "typescript_config",
    srcs = ["tsconfig.json"],
)

copied_source_files(
    name = "next_env",
    srcs = ["next-env.d.ts"],
)

js_library(
    name = "next_config",
    srcs = ["next.config.ts"],
)

copied_source_files(
    name = "audit_sources",
    srcs = glob(
        [
            "*",
            "doc/**",
            "docs/**",
            "public/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES + [
            "public/media/**",
            "public/_img/**",
        ],
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ) + [
        "//website/content:audit_sources",
        "//website/relay:audit_sources",
        "//website/scripts:audit_sources",
        "//website/src:audit_sources",
        "//website/tests:audit_sources",
    ],
)

test_suite(
    name = "unit_tests",
    tests = ["//website/tests/unit:tests"],
)

test_suite(
    name = "browser_tests",
    tests = ["//website/tests/e2e:tests"],
)

test_suite(
    name = "lint",
    tests = ["//website/scripts/bazel:lint"],
)

test_suite(
    name = "typecheck_tests",
    tests = ["//website/scripts/bazel:types_test"],
)

test_suite(
    name = "format_test",
    tests = ["//website/scripts/bazel:format_test"],
)

proto_package(
    name = "relay_proto",
    deps = ["//website/relay/src:index"],
)

workspace_package_link(
    name = "relay_proto_link",
    src = ":relay_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)
