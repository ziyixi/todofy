load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":mail-hero",
        "//.github/actions:release-mail-hero/action.yml",
        "//mail-hero/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://mail-hero:mail-hero",
        "release:worker:mail-hero",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
        "//mail-hero/cloudflare:migrations",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//mail-hero/cloudflare:check",
        "//mail-hero/deploy:check",
        "//mail-hero/deploy/backup:check",
        "//mail-hero/web:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "mail-hero",
    srcs = [
        ":config",
        "//mail-hero/cloudflare:application_sources",
        "//mail-hero/cloudflare:edge_auth_link",
        "//mail-hero/cloudflare:proto_link",
        "//mail-hero/cloudflare/src:lib",
        "//mail-hero/web:bundle",
    ],
    args = [
        "--assets",
        "web/dist",
    ],
    bundle_visibility = ["//mail-hero:__subpackages__"],
    tool = "//mail-hero/cloudflare:wrangler",
    visibility = ["//visibility:public"],
    web = "//mail-hero/web:bundle",
    web_prefix = "uiassets/dist",
)

source_audit_files(patterns = [
    "*",
    "docs/**",
])
