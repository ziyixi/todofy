load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":mail-hero",
        "//:.github/actions/release-mail-hero/action.yml",
        "//mail-hero/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://mail-hero:mail-hero",
        "release:worker:mail-hero",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
        "//mail-hero/cloudflare:migrations",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//mail-hero/cloudflare:check",
        "//mail-hero/deploy:check",
        "//mail-hero/deploy/backup:check",
        "//mail-hero/web:check",
    ],
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "worker_bundle",
    srcs = [
        ":config",
        "//mail-hero/cloudflare:application_sources",
        "//mail-hero/cloudflare:edge_auth_link",
        "//mail-hero/cloudflare:lib",
        "//mail-hero/cloudflare:proto_link",
        "//mail-hero/web:bundle",
    ],
    args = [
        "deploy",
        "--dry-run",
        "--config",
        "wrangler.toml",
        "--outdir",
        "worker_bundle",
        "--assets",
        "web/dist",
    ],
    chdir = "mail-hero",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["worker_bundle"],
    tool = "//mail-hero/cloudflare:wrangler",
    visibility = ["//mail-hero:__subpackages__"],
)

pkg_files(
    name = "worker_files",
    srcs = [":worker_bundle"],
    prefix = "worker",
    strip_prefix = strip_prefix.from_pkg("worker_bundle"),
)

pkg_files(
    name = "config_files",
    srcs = [":config"],
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "web_files",
    srcs = ["//mail-hero/web:bundle"],
    prefix = "uiassets/dist",
    strip_prefix = strip_prefix.from_root("mail-hero/web/dist"),
)

pkg_tar(
    name = "mail-hero",
    srcs = [
        ":config_files",
        ":web_files",
        ":worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "docs/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
