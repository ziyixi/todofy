{
  "name": "mail-hero-native",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "node --test test/*.test.mjs",
    "pretest:cpu": "node ../../proto/tools/ensure.mjs",
    "test:cpu": "node --test --test-concurrency=1 test/cpu/*.test.mjs",
    "contract:update": "node test/contract-fixtures.mjs --write",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "wrangler dev --config ../wrangler.toml --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "esbuild": "catalog:",
    "jose": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*",
    "parse5": "catalog:",
    "postal-mime": "catalog:"
  }
}
