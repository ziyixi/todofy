{
  "name": "mail-hero-native",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "test": "bazel test //mail-hero/cloudflare:unit_tests",
    "test:cpu": "bazel test //mail-hero/cloudflare:cpu_tests --nocache_test_results",
    "contract:update": "node test/contract-fixtures.mjs --write",
    "typecheck": "bazel test //mail-hero/cloudflare:typecheck_tests",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //mail-hero/web:bundle && wrangler dev --assets ../../bazel-bin/mail-hero/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "check": "bazel test //mail-hero:check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "esbuild": "catalog:",
    "jose": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*",
    "parse5": "catalog:",
    "postal-mime": "catalog:"
  }
}
