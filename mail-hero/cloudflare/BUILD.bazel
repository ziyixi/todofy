load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//mail-hero/cloudflare:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//mail-hero:__subpackages__"])

exports_files(
    ["package.json"],
    visibility = ["//mail-hero:__subpackages__"],
)

alias(
    name = "package_json",
    actual = ":package_metadata",
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "proto_package",
    deps = [
        "//mail-hero/cloudflare/src:lib",
        "//proto/ts:filter",
        "//proto/ts:http-client",
    ],
)

workspace_package_link(
    name = "proto_link",
    src = ":proto_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_link",
    src = "//packages/edge-auth:pkg",
)

js_library(
    name = "migrations",
    srcs = glob(["migrations/*.sql"]),
)

ts_project(
    name = "typecheck_project",
    srcs = ["//mail-hero/cloudflare/src:typecheck_project_srcs"],
    no_emit = True,
    deps = [
        ":edge_auth_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@noble/hashes",
        ":node_modules/parse5",
        ":node_modules/postal-mime",
        ":proto_link",
        "//mail-hero/cloudflare/src:lib",
    ],
)

alias(
    name = "typecheck",
    actual = ":typecheck_project_typecheck",
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = ["//mail-hero/cloudflare/src:application_sources_srcs"] + glob([
        "package.json",
        "tsconfig.json",
    ]),
)

test_suite(
    name = "check",
    tests = [
        ":typecheck_project_typecheck_test",
        "//mail-hero/cloudflare/test:check",
    ],
)

js_library(
    name = "package_metadata",
    srcs = [":package.json"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//mail-hero/cloudflare/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":typecheck_project_typecheck_test"],
)

test_suite(
    name = "cpu_tests",
    tags = ["cpu"],
    tests = ["//mail-hero/cloudflare/test:cpu_tests"],
)

alias(
    name = "lib",
    actual = "//mail-hero/cloudflare/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "migrations/**",
        "src/**",
        "test/**",
    ],
    deps = [
        "//mail-hero/cloudflare/src:source_audit_files",
        "//mail-hero/cloudflare/test:source_audit_files",
    ],
)
