# deploy/bootstrap-cloudflare.sh generates deploy/runtime.env and secret files.
# This example contains no credentials. Never commit the generated runtime.env.
MAIL_HERO_RECEIVE_ADDRESS=random-local-part@in.example.org
MAIL_HERO_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
MAIL_HERO_ACCESS_AUDIENCE=replace-with-access-application-audience
MAIL_HERO_ACCESS_OWNER=owner@example.org
MAIL_HERO_FORCE_SEND_PAUSED=true
MAIL_HERO_ALLOWED_INTERNAL_TARGETS=
MAIL_HERO_UID=10001
MAIL_HERO_GID=10001
