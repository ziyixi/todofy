load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//mail-hero:__subpackages__"])

js_library(
    name = "configure-webhook",
    srcs = ["configure-webhook.mjs"],
    deps = [
        "//mail-hero/cloudflare:native_api-common",
        "//mail-hero/cloudflare:native_api-endpoints",
        "//mail-hero/cloudflare:native_security",
    ],
)

js_library(
    name = "vars",
    srcs = ["deploy-vars.mjs"],
    deps = ["//tools/cloud-config:worker-deploy"],
)

tsx.tsx_test(
    name = "deploy-vars_test",
    args = [
        "--test",
        "test/deploy-vars.test.mjs",
    ],
    chdir = "mail-hero/deploy",
    data = [
        "test/deploy-vars.test.mjs",
        ":source_deploy_vars_mjs",
        "//mail-hero:config",
        "//mail-hero/cloudflare:package_metadata",
    ],
)

tsx.tsx_test(
    name = "wrangler-config_test",
    args = [
        "--test",
        "test/wrangler-config.test.mjs",
    ],
    chdir = "mail-hero/deploy",
    data = [
        "test/wrangler-config.test.mjs",
        ":source_cloudflare_admin_py",
        ":source_deploy_vars_mjs",
        "//mail-hero:config",
        "//mail-hero/cloudflare:entry_metadata",
        "//mail-hero/cloudflare:node_modules/wrangler",
        "//mail-hero/cloudflare:package_metadata",
        "//mail-hero/cloudflare:test_config_sources",
    ],
)

tsx.tsx_test(
    name = "bundle-size_test",
    args = [
        "--test",
        "test/bundle-size.test.mjs",
    ],
    chdir = "mail-hero/deploy",
    data = [
        "test/bundle-size.test.mjs",
        ":source_bundle_size_mjs",
        "//mail-hero/cloudflare:package_metadata",
        "//tools/bundle-size:library",
    ],
)

tsx.tsx_test(
    name = "cloudflare-admin_test",
    args = [
        "--test",
        "test/cloudflare-admin.test.mjs",
    ],
    chdir = "mail-hero/deploy",
    data = [
        "test/cloudflare-admin.test.mjs",
        ":source_cloudflare_admin_py",
        "//mail-hero/cloudflare:package_metadata",
        "@python_3_14//:files",
        "@python_3_14//:python3",
    ],
    env = {"MAILHERO_TEST_PYTHON": "$(rootpath @python_3_14//:python3)"},
    no_copy_to_bin = [
        "@python_3_14//:python3",
        "@python_3_14//:files",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":bundle-size_test",
        ":bundle_budget_test",
        ":cloudflare-admin_test",
        ":deploy-vars_test",
        ":wrangler-config_test",
    ],
)

js_test(
    name = "bundle_budget_test",
    args = ["$(rootpath //mail-hero:worker_bundle)"],
    data = [
        ":source_bundle_size_mjs",
        "//mail-hero:worker_bundle",
    ],
    entry_point = "bundle-size.mjs",
    preserve_symlinks_main = False,
)

js_library(
    name = "source_deploy_vars_mjs",
    srcs = ["deploy-vars.mjs"],
    visibility = [
        "//mail-hero:__subpackages__",
        "//tools/cloud-config:__pkg__",
    ],
    deps = ["//tools/cloud-config:worker-secrets"],
)

js_library(
    name = "source_bundle_size_mjs",
    srcs = ["bundle-size.mjs"],
    deps = ["//tools/bundle-size:library"],
)

js_library(
    name = "source_cloudflare_admin_py",
    srcs = ["cloudflare-admin.py"],
    deps = [],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
