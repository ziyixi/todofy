# Create /etc/mail-hero-backup/credentials.env as root:root mode 0600.
# systemd reads this file before switching to the unprivileged service account.
MAIL_HERO_ORIGIN=https://mail-hero.example.com
BACKUP_RECIPIENT=REPLACE_WITH_VERIFIED_FULL_PUBLIC_KEY_FINGERPRINT
BACKUP_TOKEN=REPLACE_WITH_DEDICATED_BACKUP_TOKEN
BACKUP_RECEIPT_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CF_ACCESS_CLIENT_ID=REPLACE_WITH_DEDICATED_ACCESS_SERVICE_ID
CF_ACCESS_CLIENT_SECRET=REPLACE_WITH_DEDICATED_ACCESS_SERVICE_SECRET
