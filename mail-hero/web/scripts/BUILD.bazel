load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//mail-hero/web:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "proto_vitest_test")
load("//tools/bazel/audit:sources.bzl", "source_audit_files", SOURCE_AUDIT_EXCLUDES = "SOURCE_SUBPACKAGE_AUDIT_EXCLUDES")

package(default_visibility = ["//mail-hero:__subpackages__"])

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//mail-hero:__subpackages__"],
)

js_library(
    name = "build_checks",
    srcs = [
        ":js-budget.mjs",
        ":js-budget.test.mjs",
    ],
    deps = ["//tools/bundle-size:library"],
)

proto_vitest_test(
    name = "scripts_js_budget_test",
    config = "//mail-hero/web:test_config",
    data = [
        "//mail-hero/web:node_modules/@vitejs/plugin-react",
        "//mail-hero/web:node_modules/jsdom",
        "//mail-hero/web:node_modules/vite",
        "//mail-hero/web:package_json",
        "//mail-hero/web:test_config",
    ],
    project = "mail-hero/web",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [":js-budget.test.mjs"],
    deps = [":build_checks"],
)

source_audit_files(
    exclude = SOURCE_AUDIT_EXCLUDES,
    patterns = ["**"],
)

test_suite(name = "check")

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)
