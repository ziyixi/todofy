{
  "name": "mail-hero-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "prebuild": "node ../../proto/tools/ensure.mjs",
    "build": "tsc --noEmit && vite build && node scripts/js-budget.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "check:budget": "node scripts/js-budget.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@ziyixi/proto": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "26.x"
  }
}
