load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//mail-hero/web:vite/package_json.bzl", vite = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "vite_bundle", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//mail-hero:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
    visibility = ["//mail-hero:__subpackages__"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "test_config",
    srcs = ["vite.config.ts"],
)

npm_link_all_packages(name = "node_modules")

js_library(
    name = "application_sources",
    srcs = ["//mail-hero/web/src:application_sources_srcs"] + glob(
        [
            "public/**",
            "index.html",
            "_headers",
            "_redirects",
        ],
        allow_empty = True,
    ),
)

proto_package(
    name = "bundle_proto",
    deps = [
        "//mail-hero/web/src:lib",
        "//proto/common/errors/v1:ts",
        "//proto/mailhero/ui/v2:ts",
        "//proto/ts:filter",
        "//proto/ts:http-client",
        "//proto/ts:http-transcoder",
        "//proto/ts:protobuf",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
    ],
)

workspace_package_link(
    name = "bundle_proto_link",
    src = ":bundle_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

vite.vite_binary(name = "vite")

vite_bundle(
    name = "bundle",
    out_dir = "dist",
    postbuild = "//mail-hero/web/scripts:js-budget.mjs",
    tool = ":vite",
    deps = [
        ":application_sources",
        ":bundle_proto_link",
        ":node_modules/@tanstack/react-query",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-router",
        ":node_modules/vite",
        ":node_modules/vitest",
        "//mail-hero/web/scripts:build_checks",
        "//mail-hero/web/src:lib",
    ],
)

ts_project(
    name = "typecheck_project",
    srcs = [
        ":bundle_proto_wire_types",
        ":vite.config.ts",
        "//mail-hero/web/src:typecheck_project_srcs",
    ],
    extends = ":tsconfig.json",
    no_emit = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":bundle_proto_link",
        ":node_modules/@tanstack/react-query",
        ":node_modules/@testing-library/react",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-router",
        ":node_modules/vite",
        ":node_modules/vitest",
        "//:node_modules/@types/react",
    ],
)

alias(
    name = "typecheck",
    actual = ":typecheck_project_typecheck",
)

test_suite(
    name = "check",
    tests = [
        ":typecheck_project_typecheck_test",
        "//mail-hero/web/scripts:check",
        "//mail-hero/web/src:check",
    ],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = [
        "//mail-hero/web/scripts:unit_tests",
        "//mail-hero/web/src:unit_tests",
    ],
)

test_suite(
    name = "typecheck_tests",
    tests = [":typecheck_project_typecheck_test"],
)

alias(
    name = "lib",
    actual = "//mail-hero/web/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "scripts/**",
        "src/**",
    ],
    deps = [
        "//mail-hero/web/scripts:source_audit_files",
        "//mail-hero/web/src:source_audit_files",
    ],
)
