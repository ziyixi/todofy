load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/python:tests.bzl", "ruff_binary", "ruff_test")

package(default_visibility = ["//newsletter:__subpackages__"])

ruff_test(
    name = "ruff_check_test",
    command = "check",
    config = "//newsletter:pyproject.toml",
    data = ["//newsletter:python_lint_inputs"],
    paths = [
        "src",
        "tests",
        "scripts",
    ],
)

ruff_test(
    name = "ruff_format_test",
    command = "format",
    config = "//newsletter:pyproject.toml",
    data = ["//newsletter:python_lint_inputs"],
    paths = [
        "src",
        "tests",
        "scripts",
    ],
)

py_test(
    name = "python_structure_test",
    srcs = ["//newsletter/scripts:check_python_structure.py"],
    data = ["//newsletter:python_lint_inputs"],
    legacy_create_init = False,
    main = "//newsletter/scripts:check_python_structure.py",
)

py_console_script_binary(
    name = "mypy_test",
    args = [
        "--config-file",
        "$(rootpath //newsletter:pyproject.toml)",
        "--cache-dir=/dev/null",
        "newsletter/src/newsletter",
        "newsletter/scripts",
        "newsletter/tests/support",
    ],
    binary_rule = py_test,
    config_settings = {"@rules_python//python/config_settings:venvs_site_packages": "yes"},
    data = [
        "//newsletter:pyproject.toml",
        "//newsletter:python_lint_inputs",
    ],
    legacy_create_init = False,
    pkg = "@python_deps//mypy",
    script = "mypy",
    deps = [
        "//newsletter/src/newsletter:library",
        "@python_deps//pytest",
        "@python_deps//types_protobuf",
        "@python_deps//types_pyyaml",
    ],
)

ruff_binary(
    name = "format",
    command = "format",
    config = "//newsletter:pyproject.toml",
    data = [],
    paths = [
        "src",
        "tests",
        "scripts",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
