load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_attributes", "pkg_files", "pkg_mkdirs", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("@rules_python//python:pip.bzl", "whl_filegroup")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/images:images.bzl", "newsletter_healthcheck", "newsletter_image_identity", "python_runtime_tree")
load("//tools/bazel/python:container_test.bzl", "container_image_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release",
    srcs = [
        ":newsletter",
        "//.github/actions:check-newsletter-image/action.yml",
        "//.github/actions:publish-newsletter/action.yml",
        "//tools/container-release:release_inputs",
    ],
    tags = [
        "artifact://newsletter:newsletter",
        "release:image:newsletter",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "python_sources",
    srcs = [
        "//newsletter/scripts:python_sources",
        "//newsletter/src/newsletter:python_sources",
        "//newsletter/tests:python_sources",
    ],
)

filegroup(
    name = "build_test_data",
    srcs = glob(
        [
            "content-config/**",
            "BUILD.bazel",
            "container-healthcheck.json",
            ".gitignore",
            "Makefile",
            "MANIFEST.in",
        ],
        allow_empty = True,
    ) + [
        "//newsletter/checks:BUILD.bazel",
        "//newsletter/scripts:BUILD.bazel",
        "//newsletter/src/newsletter:BUILD.bazel",
        "//newsletter/src/newsletter/collection:BUILD.bazel",
        "//newsletter/src/newsletter/workflow:BUILD.bazel",
        "//newsletter/tests:BUILD.bazel",
        "//newsletter/tests/support:BUILD.bazel",
    ],
)

py_package(
    name = "image_dependencies",
    packages = ["site-packages"],
    tags = ["manual"],
    deps = ["//newsletter/src/newsletter:library"],
)

pkg_files(
    name = "image_dependency_files",
    srcs = [":image_dependencies"],
    prefix = "opt/newsletter/.venv/lib/python3.14/site-packages",
    strip_prefix = strip_prefix.from_root("site-packages"),
    tags = ["manual"],
)

pkg_tar(
    name = "image_dependency_layer",
    srcs = [":image_dependency_files"],
    tags = ["manual"],
)

py_package(
    name = "wheel_files",
    packages = ["newsletter/src"],
    tags = ["manual"],
    deps = ["//newsletter/src/newsletter:library"],
)

py_wheel(
    name = "wheel",
    distribution = "personal-newsletter",
    entry_points = {"console_scripts": [
        "newsletter = newsletter.cli:main",
        "newsletter-trigger = newsletter.trigger:main",
    ]},
    python_requires = ">=3.14",
    requires = [
        "fastapi",
        "uvicorn",
        "httpx",
        "protobuf",
        "jinja2",
        "pillow",
        "pyyaml",
        "PyJWT",
        "cryptography",
        "ziyixi-protos",
        "ziyixi-proto",
        "ziyixi-model-router-client",
    ],
    stamp = 0,
    strip_path_prefixes = ["newsletter/src"],
    tags = ["manual"],
    version = "0.1.0",
    deps = [":wheel_files"],
)

whl_filegroup(
    name = "image_source",
    tags = ["manual"],
    whl = ":wheel",
)

pkg_files(
    name = "image_source_files",
    srcs = [":image_source"],
    prefix = "opt/newsletter/.venv/lib/python3.14/site-packages",
    renames = {":image_source": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

whl_filegroup(
    name = "image_client",
    tags = ["manual"],
    whl = "//packages/model-router-client/python:wheel",
)

pkg_files(
    name = "image_client_files",
    srcs = [":image_client"],
    prefix = "opt/newsletter/.venv/lib/python3.14/site-packages",
    renames = {":image_client": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

whl_filegroup(
    name = "image_proto",
    tags = ["manual"],
    whl = "//proto:python_wheel",
)

pkg_files(
    name = "image_proto_files",
    srcs = [":image_proto"],
    prefix = "opt/newsletter/.venv/lib/python3.14/site-packages",
    renames = {":image_proto": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_files(
    name = "image_public_config",
    srcs = [
        "//config:cloud.toml",
        "//config:resources.toml",
    ],
    prefix = "opt/newsletter/public-build-config",
    strip_prefix = strip_prefix.from_root("config"),
    tags = ["manual"],
)

pkg_tar(
    name = "image_source_layer",
    srcs = [
        ":image_public_config",
        ":image_source_files",
    ],
    tags = ["manual"],
)

pkg_tar(
    name = "image_proto_layer",
    srcs = [":image_proto_files"],
    tags = ["manual"],
)

pkg_tar(
    name = "image_client_layer",
    srcs = [":image_client_files"],
    tags = ["manual"],
)

pkg_tar(
    name = "image_font_layer",
    tags = ["manual"],
    deps = ["@newsletter_fonts//:data.tar.xz"],
)

python_runtime_tree(
    name = "image_runtime",
    base = "@python_base_linux_amd64",
    service = "newsletter",
    tags = ["manual"],
)

pkg_files(
    name = "image_runtime_files",
    srcs = [":image_runtime"],
    renames = {":image_runtime": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_files(
    name = "image_entrypoints",
    srcs = [
        "//tools/bazel/images:newsletter-entrypoint",
        "//tools/bazel/images:newsletter-trigger-entrypoint",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "opt/newsletter/.venv/bin",
    renames = {
        "//tools/bazel/images:newsletter-entrypoint": "newsletter",
        "//tools/bazel/images:newsletter-trigger-entrypoint": "newsletter-trigger",
    },
    tags = ["manual"],
)

pkg_mkdirs(
    name = "image_directories",
    attributes = pkg_attributes(
        gid = 10001,
        mode = "0755",
        uid = 10001,
    ),
    dirs = [
        "home/newsletter",
        "var/lib/newsletter",
    ],
    tags = ["manual"],
)

pkg_tar(
    name = "image_runtime_layer",
    srcs = [
        ":image_directories",
        ":image_entrypoints",
        ":image_runtime_files",
    ],
    symlinks = {
        "opt/newsletter/.venv/bin/python": "/usr/local/bin/python3.14",
        "opt/newsletter/.venv/bin/python3": "python",
        "opt/newsletter/.venv/bin/python3.14": "python",
    },
    tags = ["manual"],
)

newsletter_image_identity(
    name = "image_identity",
    profile = "//config:cloud.toml",
    resources = "//config:resources.toml",
    tags = ["manual"],
)

pkg_files(
    name = "image_identity_files",
    srcs = [":image_identity"],
    renames = {":image_identity": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_tar(
    name = "image_identity_layer",
    srcs = [":image_identity_files"],
    tags = ["manual"],
)

filegroup(
    name = "image_labels",
    srcs = [":image_identity"],
    output_group = "labels",
    tags = ["manual"],
)

oci_image(
    name = "image_raw",
    base = "@python_base_linux_amd64",
    cmd = [
        "serve",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
    ],
    entrypoint = ["newsletter"],
    env = {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": "/opt/newsletter/.venv/bin:$PATH",
        "NEWSLETTER_DATA_DIR": "/var/lib/newsletter",
        "NEWSLETTER_CHART_FONT": "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    },
    exposed_ports = [
        "8080",
        "8081",
    ],
    labels = ":image_labels",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tars = [
        ":image_runtime_layer",
        ":image_font_layer",
        ":image_dependency_layer",
        ":image_proto_layer",
        ":image_client_layer",
        ":image_source_layer",
        ":image_identity_layer",
    ],
    user = "newsletter",
    workdir = "/opt/newsletter",
)

newsletter_healthcheck(
    name = "image",
    base = ":image_raw",
    config = "container-healthcheck.json",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "image.digest",
    srcs = [":image"],
    output_group = "digest",
    tags = ["manual"],
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["todofy-newsletter:bazel"],
    tags = ["manual"],
)

filegroup(
    name = "image_tar",
    srcs = [":image_load"],
    output_group = "tarball",
    tags = ["manual"],
)

alias(
    name = "newsletter",
    actual = ":image_tar",
    tags = ["manual"],
)

test_suite(
    name = "check",
    tests = [
        ":container_test",
        ":mypy_test",
        ":python_structure_test",
        ":ruff_check_test",
        ":ruff_format_test",
        ":smoke_codex_startup_test",
        ":smoke_http_test",
        ":tests",
        ":wheel_smoke_test",
        "//tools/container-release:build_identity_test",
    ],
)

filegroup(
    name = "config",
    srcs = [
        "MANIFEST.in",
        "app.toml",
        "container-healthcheck.json",
        "pyproject.toml",
        "//config:cloud.toml",
        "//config:resources.toml",
    ] + glob(["content-config/**"]),
)

source_audit_files(
    patterns = [
        "*",
        "content-config/**",
        "docs/**",
        "scripts/**",
        "src/**",
        "tests/**",
    ],
    deps = [
        "//newsletter/checks:source_audit_files",
        "//newsletter/scripts:source_audit_files",
        "//newsletter/src/newsletter:source_audit_files",
        "//newsletter/tests:source_audit_files",
    ],
)

filegroup(
    name = "python_lint_inputs",
    srcs = [
        "pyproject.toml",
        "//newsletter/scripts:python_sources",
        "//newsletter/src/newsletter:python_sources",
        "//newsletter/tests:python_sources",
    ],
)

pkg_files(
    name = "source_distribution_files",
    srcs = [
        "MANIFEST.in",
        "README.md",
        "pyproject.toml",
        ":wheel_files",
    ],
    strip_prefix = strip_prefix.from_root("newsletter"),
)

pkg_tar(
    name = "source_distribution",
    srcs = [":source_distribution_files"],
    extension = "tar.gz",
    package_dir = "personal_newsletter-0.1.0",
)

filegroup(
    name = "container_probe_inputs",
    srcs = [
        "container-healthcheck.json",
        ":content_configuration_sources",
        ":wheel_files",
        "//:.python-version",
        "//config:resources.toml",
        "//newsletter/scripts:publish_content_config.py",
        "//newsletter/scripts:smoke_codex_startup.py",
        "//newsletter/scripts:smoke_image.py",
        "//newsletter/scripts:smoke_image_probe.py",
    ],
)

container_image_test(
    name = "container_test",
    service = "newsletter",
    sources = ":container_probe_inputs",
)

filegroup(
    name = "content_configuration_sources",
    srcs = glob(["content-config/**"]),
)

alias(
    name = "bootstrap_settings",
    actual = "//newsletter/src/newsletter:bootstrap_settings",
)

alias(
    name = "evaluate_prompts",
    actual = "//newsletter/scripts:evaluate_prompts",
)

alias(
    name = "format",
    actual = "//newsletter/checks:format",
)

alias(
    name = "library",
    actual = "//newsletter/src/newsletter:library",
)

test_suite(
    name = "mypy_test",
    tests = ["//newsletter/checks:mypy_test"],
)

test_suite(
    name = "python_structure_test",
    tests = ["//newsletter/checks:python_structure_test"],
)

test_suite(
    name = "ruff_check_test",
    tests = ["//newsletter/checks:ruff_check_test"],
)

test_suite(
    name = "ruff_format_test",
    tests = ["//newsletter/checks:ruff_format_test"],
)

test_suite(
    name = "smoke_codex_startup_test",
    tests = ["//newsletter/scripts:smoke_codex_startup_test"],
)

test_suite(
    name = "smoke_http_test",
    tests = ["//newsletter/scripts:smoke_http_test"],
)

test_suite(
    name = "tests",
    tests = ["//newsletter/tests"],
)

test_suite(
    name = "wheel_smoke_test",
    tests = ["//newsletter/scripts:wheel_smoke_test"],
)
