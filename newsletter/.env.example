# Documentation only. Python never auto-loads .env; preserve the existing legacy .env.
# Export these variables or configure your private service manager.
NEWSLETTER_MODE=mock
NEWSLETTER_EDITOR=mock
NEWSLETTER_DATA_DIR=.data
NEWSLETTER_TIME_ZONE=America/Los_Angeles
# Generate two DIFFERENT values locally with: newsletter token
NEWSLETTER_EDITOR_TOKEN=
NEWSLETTER_SEND_TOKEN=
NEWSLETTER_JOB_TIMEOUT_SECONDS=900
NEWSLETTER_COLLECTION_TIMEOUT_SECONDS=600
NEWSLETTER_WORKFLOW=dag
# Optional in development; production mounts this dedicated config directory read-only.
# Anonymous config-sync seeds it explicitly, then follows this public repo's published bundle.
# NEWSLETTER_CONTENT_CONFIG_DIR=/var/lib/newsletter-config
NEWSLETTER_WORKFLOW_TIMEOUT_SECONDS=5400
# Live default: packaged DAG + eight discovery instructions. Mock remains fake-only.
# NEWSLETTER_WORKFLOW_FILE=/etc/newsletter/workflows/daily.yaml
# NEWSLETTER_DISCOVERY_DIR=/etc/newsletter/instructions/discovery
# Default: packaged src/newsletter/instructions/*.md. Optional operator-owned directory:
# NEWSLETTER_INSTRUCTIONS_DIR=/etc/newsletter/instructions
NEWSLETTER_NOTION=disabled
NEWSLETTER_MAIL=fake
NEWSLETTER_ALLOW_SEND=false
NEWSLETTER_TODOFY=disabled
# Use fake for offline personal events, or todofy only in live mode.
NEWSLETTER_TODOFY_MODE=recommendation
NEWSLETTER_TODOFY_TOP=5
# Maximum displayed events after filtering; recommendation fetches up to 10 candidates once.
# Existing Todofy env names remain supported; never copied from .env implicitly.
# TODO_API_BASE=https://daily.ziyixi.science
# TODO_API_USER=
# TODO_API_PASSWORD=

# Later, after explicit integration approval, use a NEW live data directory.
# NEWSLETTER_MODE=live
# NEWSLETTER_EDITOR=codex
# NEWSLETTER_CODEX_HOME=/var/lib/newsletter-auth
# NEWSLETTER_MODEL=gpt-6-sol
# A Notion link alone is not authorization: share both databases with the connection.
# NEWSLETTER_NOTION=notion
# NOTION_TOKEN=
# Dual databases require NEWSLETTER_WORKFLOW=dag. Use data source IDs, not
# database/page IDs. Set both or neither.
# NOTION_MATERIALS_DATA_SOURCE_ID=
# NOTION_EDITIONS_DATA_SOURCE_ID=
# Private Todofy events stay out of the material library. This opt-in allows them
# in the full daily archive; leave false unless that database is authorized for them.
# NEWSLETTER_NOTION_ARCHIVE_PRIVATE=false
# Initialize the managed columns explicitly before the first dual-database startup.
# Startup validates existing schemas without creating pages, columns, or email.
# Legacy one-database packet projection remains available when both new IDs are unset:
# NOTION_DATA_SOURCE_ID=
# Real mail is a separate opt-in; never configure it for fixture storage.
# NEWSLETTER_MAIL=resend
# NEWSLETTER_ALLOW_SEND=true
# RESEND_API_KEY=
# NEWSLETTER_FROM_EMAIL=
# RECIPIENT_EMAIL=
