load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":watch",
        "//.github/actions:release-watch/action.yml",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
        "//watch/deploy:source_deploy_vars_mjs",
    ],
    tags = [
        "artifact://watch:watch",
        "release:worker:watch",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//watch/deploy:check",
        "//watch/tools:check",
        "//watch/web:check",
        "//watch/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "watch",
    srcs = [
        ":config",
        "//watch/web:bundle",
        "//watch/worker:application_sources",
        "//watch/worker:edge_auth_types_link",
        "//watch/worker:proto_types_link",
        "//watch/worker/src:lib",
    ],
    bundle_visibility = ["//watch:__subpackages__"],
    tool = "//watch/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//watch/web:bundle",
)

source_audit_files(patterns = [
    "*",
    "docs/**",
])
