load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//watch/web:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "copied_source_files", "proto_vitest_test")
load("//tools/bazel/audit:sources.bzl", "source_audit_files", SOURCE_AUDIT_EXCLUDES = "SOURCE_SUBPACKAGE_AUDIT_EXCLUDES")

package(default_visibility = ["//watch:__subpackages__"])

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//watch:__subpackages__"],
)

copied_source_files(
    name = "application_sources_srcs",
    srcs = [
        "fakeServer.ts",
        "no-external.test.ts",
        "setup.ts",
    ],
)

copied_source_files(
    name = "typecheck_project_srcs",
    srcs = [
        "fakeServer.ts",
        "no-external.test.ts",
        "setup.ts",
    ],
)

copied_source_files(
    name = "lint_sources",
    srcs = [
        "fakeServer.ts",
        "no-external.test.ts",
        "setup.ts",
    ],
)

proto_vitest_test(
    name = "src__test__no-external_test",
    config = "//watch/web:test_config",
    data = [
        ":setup.ts",
        "//watch/web:application_sources",
        "//watch/web:node_modules/jsdom",
        "//watch/web:node_modules/vite",
        "//watch/web:package_json",
        "//watch/web:source_index_html",
        "//watch/web:test_config",
    ],
    project = "watch/web",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [":no-external.test.ts"],
    deps = ["//watch/web:node_modules/vitest"],
)

source_audit_files(
    exclude = SOURCE_AUDIT_EXCLUDES,
    patterns = ["**"],
)

test_suite(name = "check")

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)

js_library(
    name = "source_fakeServer_ts",
    srcs = ["fakeServer.ts"],
)

js_library(
    name = "source_setup_ts",
    srcs = ["setup.ts"],
)
