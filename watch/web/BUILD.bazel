    data = [
        "package.json",
        "src/test/setup.ts",
        "vite.config.ts",
        ":node_modules/jsdom",
        ":node_modules/vite",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["src/api.test.ts"],
    deps = [
        ":node_modules/vitest",
        ":src__api",
        "//proto/ts:rpc-status",
    ],
)

