load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//watch/web:eslint/package_json.bzl", eslint = "bin")
load("@npm//watch/web:vite/package_json.bzl", vite = "bin")
load("@npm//watch/web:vitest/package_json.bzl", vitest = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "proto_vitest_test", "vite_bundle", "workspace_link", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//watch:__subpackages__"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "src__api",
    srcs = ["src/api.ts"],
    types = ["src/api.ts"],
    deps = [
        "//proto/common/errors/v1:ts",
        "//proto/ts:http-client",
        "//proto/ts:rpc-status",
        "//proto/watch/ui/v1:ts",
    ],
)

js_library(
    name = "src__dom",
    srcs = ["src/dom.ts"],
    types = ["src/dom.ts"],
    deps = [],
)

js_library(
    name = "src__format",
    srcs = ["src/format.ts"],
    types = ["src/format.ts"],
    deps = [
        "//proto/ts:protobuf-wkt",
        "//proto/watch/ui/v1:ts",
    ],
)

js_library(
    name = "src__settings",
    srcs = ["src/settings.ts"],
    types = ["src/settings.ts"],
    deps = [
        ":src__dom",
        ":src__format",
        "//proto/ts:protobuf",
        "//proto/watch/ui/v1:ts",
    ],
)

js_library(
    name = "src__evidence",
    srcs = ["src/evidence.ts"],
    types = ["src/evidence.ts"],
    deps = [
        ":src__api",
        ":src__dom",
        ":src__format",
        "//proto/watch/ui/v1:ts",
    ],
)

js_library(
    name = "src__app",
    srcs = [
        "src/app.ts",
        "src/views/add.ts",
        "src/views/changes.ts",
        "src/views/detail.ts",
        "src/views/health.ts",
        "src/views/inbox.ts",
        "src/views/watches.ts",
    ],
    types = [
        "src/app.ts",
        "src/views/add.ts",
        "src/views/changes.ts",
        "src/views/detail.ts",
        "src/views/health.ts",
        "src/views/inbox.ts",
        "src/views/watches.ts",
    ],
    deps = [
        ":src__api",
        ":src__dom",
        ":src__evidence",
        ":src__format",
        ":src__settings",
        "//proto/ts:filter",
        "//proto/watch/ui/v1:ts",
    ],
)

js_library(
    name = "src__main",
    srcs = [
        "src/main.ts",
        "src/styles.css",
    ],
    types = ["src/main.ts"],
    deps = [":src__app"],
)

js_library(
    name = "lib",
    deps = [
        ":src__api",
        ":src__app",
        ":src__dom",
        ":src__evidence",
        ":src__format",
        ":src__main",
        ":src__settings",
    ],
)

