    data = [
        "index.html",
        "package.json",
        "src/test/setup.ts",
        "vite.config.ts",
        ":application_sources",
        ":node_modules/jsdom",
        ":node_modules/vite",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["src/test/no-external.test.ts"],
    deps = [":node_modules/vitest"],
)

js_library(
    name = "application_sources",
    srcs = glob(
        [
            "src/**",
            "public/**",
            "index.html",
            "_headers",
            "_redirects",
        ],
        allow_empty = True,
    ),
)

js_library(
    name = "build_checks",
    srcs = [
        "scripts/finish-dist.mjs",
        "scripts/js-budget.mjs",
    ],
    deps = ["//tools/bundle-size:library"],
)

proto_package(
    name = "bundle_proto",
    deps = [
        ":lib",
        "//proto/common/errors/v1:ts",
        "//proto/ts:field-mask",
        "//proto/ts:filter",
        "//proto/ts:http-client",
        "//proto/ts:http-transcoder",
        "//proto/ts:protobuf",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
        "//proto/watch/ui/v1:ts",
    ],
)

workspace_package_link(
    name = "bundle_proto_link",
    src = ":bundle_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

vite.vite_binary(name = "vite")

vite_bundle(
    name = "bundle",
    out_dir = "dist",
    postbuild = "scripts/finish-dist.mjs",
    tool = ":vite",
    deps = [
        ":application_sources",
        ":build_checks",
        ":bundle_proto_link",
        ":lib",
        ":node_modules/vite",
        ":node_modules/vitest",
    ],
)

ts_project(
    name = "typecheck_project",
    srcs = [
        "src/api.test.ts",
        "src/api.ts",
        "src/app.test.ts",
        "src/app.ts",
        "src/dom.ts",
        "src/evidence.test.ts",
        "src/evidence.ts",
        "src/format.test.ts",
        "src/format.ts",
        "src/main.ts",
        "src/owner-flows.test.ts",
        "src/settings.ts",
        "src/test/fakeServer.ts",
        "src/test/no-external.test.ts",
        "src/test/setup.ts",
        "src/views/add.ts",
        "src/views/changes.ts",
        "src/views/detail.ts",
        "src/views/health.ts",
        "src/views/inbox.ts",
        "src/views/watches.ts",
        "vite.config.ts",
        ":bundle_proto_wire_types",
    ],
    extends = "tsconfig.json",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":bundle_proto_link",
        ":node_modules/@types/node",
        ":node_modules/vite",
        ":node_modules/vitest",
    ],
)

alias(
    name = "typecheck",
    actual = ":typecheck_project_typecheck",
)

test_suite(name = "check")

eslint_test(
    name = "lint",
    data = [
        "package.json",
        "tsconfig.json",
        ":application_sources",
        ":build_checks",
        ":bundle_proto_link",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/eslint",
        ":node_modules/jsdom",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vite",
        ":node_modules/vitest",
    ],
    runner = eslint.eslint_test,
    sources = glob(
        [
            "src/**/*.ts",
            "src/**/*.tsx",
            "test/**/*.ts",
            "test/**/*.mts",
            "scripts/**/*.mjs",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "scripts/**",
            "src/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":typecheck_project_typecheck_test"],
)
