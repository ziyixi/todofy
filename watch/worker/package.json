{
  "name": "watch-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"watch\": the owner's web watches (WatchState, one SQLite Durable Object that schedules itself) and their owner API (watch.ui.v1) behind Access.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //watch/worker:typecheck_tests",
    "lint": "bazel test //watch/worker:lint",
    "test": "bazel test //watch/worker:unit_tests",
    "test:runtime": "bazel test //watch/worker:runtime_tests --nocache_test_results",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //watch/web:bundle && wrangler dev --assets ../../bazel-bin/watch/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8791 --local-upstream 127.0.0.1:8791",
    "check": "bazel test //watch:check"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "catalog:",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
