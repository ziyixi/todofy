load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//tasks/worker:eslint/package_json.bzl", eslint = "bin")
load("@npm//tasks/worker:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//tasks:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.runtime.config.ts",
    ],
    visibility = ["//tasks:__subpackages__"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "runtime_test_config",
    srcs = ["vitest.runtime.config.ts"],
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
        "//tasks/worker/test:check",
    ],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "runtime_proto",
    deps = ["//tasks/worker/test:runtime_harness"],
)

workspace_package_link(
    name = "typecheck_proto_link",
    src = "//tasks/worker:runtime_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

ts_project(
    name = "types",
    srcs = ["//tasks/worker/src:types_srcs"] + ["//tasks/worker/test:types_srcs"] + [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
    ],
    no_emit = True,
    deps = [
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@ziyixi/edge-auth",
        ":node_modules/@ziyixi/task-dates",
        ":node_modules/vitest",
        ":typecheck_proto_link",
        "//tasks/worker/src:index",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = ["//tasks/worker/src:application_sources_srcs"],
)

eslint_test(
    name = "lint",
    data = [
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/@ziyixi/edge-auth",
        ":node_modules/@ziyixi/task-dates",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/miniflare",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":package.json",
        ":tsconfig.json",
        ":typecheck_proto_link",
        "//:node_modules/@cloudflare/workers-types",
        "//tasks/tools:backup_restore",
        "//tasks/worker/src:index",
        "//tasks/worker/test:lint_data",
        "//tasks/worker/test:runtime_harness",
        "//tools/workerd-cpu:lib",
    ],
    runner = eslint.eslint_binary,
    sources = ["//tasks/worker/src:lint_sources"] + ["//tasks/worker/test:lint_sources"] + glob([
        "*.ts",
        "*.js",
    ]),
)

ts_config(
    name = "worker_compiler_profile",
    src = ":tsconfig.json",
)

ts_config(
    name = "runtime_compiler_profile",
    src = "//tasks/worker/test:source_runtime_tsconfig_json",
    deps = [":worker_compiler_profile"],
)

ts_project(
    name = "runtime_types",
    srcs = ["//tasks/worker/test:runtime_types_srcs"] + ["//tasks/worker:runtime_proto_wire_types"],
    extends = ":runtime_compiler_profile",
    no_emit = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/@ziyixi/edge-auth",
        ":node_modules/@ziyixi/task-dates",
        ":node_modules/esbuild",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":typecheck_proto_link",
        "//:node_modules/@cloudflare/workers-types",
        "//tasks/tools:backup_restore",
        "//tasks/worker/src:index",
        "//tasks/worker/test:runtime_harness",
        "//tools/workerd-cpu:types",
    ],
)

alias(
    name = "runtime_typecheck",
    actual = ":runtime_types_typecheck",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//tasks/worker/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
    ],
)

test_suite(
    name = "runtime_tests",
    tests = ["//tasks/worker/test:runtime_tests"],
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
        "test/**",
    ],
    deps = [
        "//tasks/worker/src:source_audit_files",
        "//tasks/worker/test:source_audit_files",
    ],
)
