[
    vitest_test(
        name = "runtime_" + test.removeprefix("test/runtime/").removesuffix(".test.ts") + "_test",
        size = "large",
        config = "vitest.runtime.config.ts",
        data = [
            "package.json",
            "vitest.runtime.config.ts",
            ":edge-auth_link",
            ":runtime_harness",
            ":runtime_proto_link",
            ":task-dates_link",
            "//tasks:migrations",
        ] + ([
            ":wrangler",
            "//tasks/tools:backup_restore",
            "//tasks:public_config",
        ] if test.endswith("/backup-runner.test.ts") else []),
        env = {"BAZEL_WRANGLER": "$(rootpath :wrangler)"} if test.endswith("/backup-runner.test.ts") else {},
        runner = vitest.vitest_test,
        tags = ["workerd"] + ([
            "cpu",
            "exclusive",
        ] if test.endswith("/cpu.test.ts") else []),
        tests = [test],
    )
    for test in glob(["test/runtime/*.test.ts"])
]

