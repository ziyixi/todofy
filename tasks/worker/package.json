{
  "name": "tasks-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //tasks/worker:typecheck_tests",
    "test": "bazel test //tasks/worker:unit_tests",
    "test:runtime": "bazel test //tasks/worker:runtime_tests --nocache_test_results",
    "dev": "bazel build //tasks/web:bundle && wrangler dev --assets ../../bazel-bin/tasks/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8798 --local-upstream 127.0.0.1:8798",
    "lint": "bazel test //tasks/worker:lint",
    "predev": "node ../../proto/tools/ensure.mjs",
    "check": "bazel test //tasks:check"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*",
    "@ziyixi/task-dates": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "prettier": "catalog:"
  }
}
