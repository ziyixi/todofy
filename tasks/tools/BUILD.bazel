load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//tasks:__subpackages__"])

js_library(
    name = "backup_restore",
    srcs = [
        "backup-restore.ts",
        "todoist-export.mjs",
    ],
    visibility = ["//tasks:__subpackages__"],
)

js_library(
    name = "todoist_export",
    srcs = ["todoist-export.mjs"],
)

js_library(
    name = "goals_import",
    srcs = ["prepare-goals-import.ts"],
    deps = [
        ":todoist_export",
        "//tasks/worker/src:goal-model",
        "//tasks/worker/src:goal-validation",
    ],
)

js_library(
    name = "import_model",
    srcs = ["import-model.ts"],
    deps = [
        "//packages/task-dates:lib",
        "//tasks/shared:build",
        "//tasks/shared:colors",
        "//tasks/worker/src:catalog",
        "//tasks/worker/src:model",
        "//tasks/worker/src:task-validation",
    ],
)

_D1_DATA = [
    "//tasks/worker/test:runtime_harness",
    "//tasks/worker:typecheck_proto_link",
    "//tasks/worker:node_modules/@ziyixi/edge-auth",
    "//tasks/worker:node_modules/@ziyixi/task-dates",
    "//tasks:migrations",
]

js_test(
    name = "goals_import_test",
    size = "large",
    args = [
        "$(rootpath //tools/bazel:tsx)",
        "--test",
        "--no-preserve-symlinks-main",
        "tasks/tools/test/goals-import.test.mjs",
    ],
    data = [
        "test/goals-import.test.mjs",
        ":goals_import",
        "//tools/bazel:tsx",
    ] + _D1_DATA,
    entry_point = "test/run-tsx.mjs",
    patch_node_fs = False,
    tags = ["workerd"],
)

js_test(
    name = "import_snapshot_test",
    size = "large",
    args = [
        "$(rootpath //tools/bazel:tsx)",
        "--test",
        "--no-preserve-symlinks-main",
        "tasks/tools/test/import-snapshot.test.mjs",
    ],
    data = [
        "test/import-snapshot.test.mjs",
        ":import_model",
        "//tools/bazel:tsx",
    ] + _D1_DATA,
    entry_point = "test/run-tsx.mjs",
    patch_node_fs = False,
    tags = ["workerd"],
)

js_test(
    name = "backup_restore_test",
    data = [
        ":backup_restore",
        "//tasks:migrations",
        "//tasks:public_config",
    ],
    entry_point = "test/backup-restore.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
    preserve_symlinks_main = False,
)

js_test(
    name = "todoist_export_test",
    data = [":todoist_export"],
    entry_point = "test/todoist-export.test.mjs",
    node_options = ["--test"],
    patch_node_fs = False,
    preserve_symlinks_main = False,
)

test_suite(name = "check")

source_audit_files(patterns = [
    "*",
    "test/**",
])
