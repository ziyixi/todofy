load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ] + glob(["migrations/*.sql"]),
)

test_suite(
    name = "check",
    tests = [
        "//tasks/deploy:check",
        "//tasks/tools:check",
        "//tasks/web:check",
        "//tasks/worker:check",
    ],
)

pkg_files(
    name = "worker_files",
    srcs = [":worker_bundle"],
    prefix = "worker",
    strip_prefix = strip_prefix.from_pkg("worker_bundle"),
)

pkg_files(
    name = "web_files",
    srcs = ["//tasks/web:bundle"],
    prefix = "web/dist",
    strip_prefix = strip_prefix.from_root("tasks/web/dist"),
)

pkg_files(
    name = "config_files",
    srcs = [":config"],
    strip_prefix = strip_prefix.from_pkg(),
)

# Public application entry point: a complete compiled Worker, assets and deployment inputs.
pkg_tar(
    name = "tasks",
    srcs = [
        ":config_files",
        ":web_files",
        ":worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
)

js_library(
    name = "public_config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
)

js_library(
    name = "migrations",
    srcs = glob(["migrations/*.sql"]),
)

exports_files([
    "wrangler.toml",
    "app.toml",
])

js_run_binary(
    name = "worker_bundle",
    srcs = [
        ":migrations",
        ":public_config",
        "//tasks/web:bundle",
        "//tasks/worker:application_sources",
        "//tasks/worker:index",
        "//tasks/worker:node_modules/@ziyixi/edge-auth",
        "//tasks/worker:node_modules/@ziyixi/task-dates",
        "//tasks/worker:typecheck_proto_link",
    ],
    args = [
        "deploy",
        "--dry-run",
        "--config",
        "wrangler.toml",
        "--outdir",
        "worker_bundle",
    ],
    chdir = "tasks",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["worker_bundle"],
    tool = "//tasks/worker:wrangler",
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "docs/**",
            "migrations/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
