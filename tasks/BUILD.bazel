load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release",
    srcs = [
        ":tasks",
        "//.github/actions:release-tasks/action.yml",
        "//tasks/deploy:deploy_vars",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://tasks:tasks",
        "release:worker:tasks",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ] + glob(["migrations/*.sql"]),
)

test_suite(
    name = "check",
    tests = [
        "//tasks/deploy:check",
        "//tasks/shared:check",
        "//tasks/tools:check",
        "//tasks/web:check",
        "//tasks/worker:check",
    ],
)

worker_artifact(
    name = "tasks",
    srcs = [
        ":migrations",
        ":public_config",
        "//tasks/web:bundle",
        "//tasks/worker:application_sources",
        "//tasks/worker:node_modules/@ziyixi/edge-auth",
        "//tasks/worker:node_modules/@ziyixi/task-dates",
        "//tasks/worker:typecheck_proto_link",
        "//tasks/worker/src:index",
    ],
    tool = "//tasks/worker:wrangler",
    web = "//tasks/web:bundle",
)

js_library(
    name = "public_config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
)

js_library(
    name = "migrations",
    srcs = glob(["migrations/*.sql"]),
)

exports_files([
    "wrangler.toml",
    "app.toml",
])

source_audit_files(patterns = [
    "*",
    "docs/**",
    "migrations/**",
])
