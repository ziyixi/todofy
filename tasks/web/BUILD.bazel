load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//tasks/web:eslint/package_json.bzl", eslint = "bin")
load("@npm//tasks/web:vite/package_json.bzl", vite = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "vite_bundle", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//tasks:__subpackages__"])

exports_files(
    [
        "package.json",
        "vite.config.ts",
    ],
    visibility = ["//tasks:__subpackages__"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "browser_test_config",
    srcs = ["playwright.config.ts"],
)

js_library(
    name = "test_config",
    srcs = ["vite.config.ts"],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "bundle_proto",
    deps = ["//tasks/web/src:src__main"],
)

workspace_package_link(
    name = "bundle_proto_link",
    src = ":bundle_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

js_library(
    name = "public_assets",
    srcs = glob(["public/**"]),
)

vite.vite_binary(name = "vite")

vite_bundle(
    name = "bundle",
    tool = ":vite",
    deps = [
        ":application_sources",
        ":bundle_proto_link",
        ":node_modules/@base-ui/react",
        ":node_modules/@dnd-kit/abstract",
        ":node_modules/@dnd-kit/collision",
        ":node_modules/@dnd-kit/dom",
        ":node_modules/@dnd-kit/react",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/react-markdown",
        ":node_modules/remark-gfm",
        ":node_modules/vitest",
        ":planning_ui_bundle_link",
        ":public_assets",
        ":task_dates_bundle_link",
        "//:node_modules/@dnd-kit/geometry",
        "//:node_modules/@dnd-kit/state",
        "//tasks/web/src:src__main",
    ],
)

workspace_package_link(
    name = "planning_ui_bundle_link",
    src = "//packages/planning-ui:pkg",
)

workspace_package_link(
    name = "task_dates_bundle_link",
    src = "//packages/task-dates:pkg",
    runtime_dependencies = [
        "chrono-node",
        "rrule",
    ],
)

ts_project(
    name = "types",
    srcs = ["//tasks/web/src:types_srcs"] + ["//tasks/web/test:types_srcs"] + glob(
        ["*.ts"],
        allow_empty = True,
    ),
    no_emit = True,
    deps = [
        ":bundle_proto_link",
        ":node_modules/@playwright/test",
        ":node_modules/@testing-library/react",
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/vite",
        ":node_modules/vitest",
        ":planning_ui_bundle_link",
        ":task_dates_bundle_link",
        "//:node_modules/@types/react",
        "//tasks/web/src:src__main",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

test_suite(
    name = "browser_tests",
    tests = ["//tasks/web/test:browser_tests"],
)

js_library(
    name = "application_sources",
    srcs = ["//tasks/web/src:application_sources_srcs"],
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":types_typecheck_test",
        "//tasks/web/src:check",
        "//tasks/web/test:check",
    ],
)

eslint_test(
    name = "lint",
    data = [
        ":node_modules/@eslint/js",
        ":node_modules/typescript-eslint",
        ":package.json",
    ],
    runner = eslint.eslint_binary,
    sources = ["//tasks/web/src:lint_sources"] + ["//tasks/web/test:lint_sources"] + glob([
        "public/**/*.js",
        "*.ts",
        "*.js",
    ]),
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//tasks/web/src:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":types_typecheck_test"],
)

source_audit_files(
    patterns = [
        "*",
        "public/**",
        "src/**",
        "test/**",
    ],
    deps = [
        "//tasks/web/src:source_audit_files",
        "//tasks/web/test:source_audit_files",
    ],
)
