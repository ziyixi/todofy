# Vite's terminal bundle reads the application tree, including dynamically imported modules and assets.
js_library(
    name = "application_sources",
    srcs = glob(
        ["src/**"],
        exclude = ["**/*.test.*"],
    ),
)

# The native suite includes the package's existing non-manual test rules.
test_suite(name = "check")

# Original ESLint config and source scope, with generated Bazel launchers kept outside the file list.
eslint_test(
    name = "lint",
    data = [
        "package.json",
        ":node_modules/@eslint/js",
        ":node_modules/typescript-eslint",
    ],
    runner = eslint.eslint_test,
    sources = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "public/**/*.js",
        "test/**/*.ts",
        "*.ts",
        "*.js",
    ]),
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "public/**",
            "src/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
