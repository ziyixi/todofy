load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

ts_project(
    name = "types",
    srcs = [
        "build.ts",
        "colors.ts",
    ],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = {"compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "strict": True,
    }},
)

js_library(
    name = "colors",
    srcs = ["colors.ts"],
    visibility = ["//visibility:public"],
    deps = [":types"],
)

js_library(
    name = "build",
    srcs = ["build.ts"],
    visibility = ["//visibility:public"],
    deps = [":types"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [":types_typecheck_test"],
    visibility = ["//tasks:__subpackages__"],
)
