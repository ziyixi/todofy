load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//platform:__subpackages__"])

py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = ["../.."],
    deps = ["//platform/src/personal_cloud:package"],
)

py_library(
    name = "adapters",
    srcs = ["adapters.py"],
    imports = ["../.."],
    deps = [
        ":config",
        ":package",
        "//proto/platform/runtime/v1:python",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["../.."],
    visibility = [
        "//platform:__subpackages__",
        "//tools/vps-bootstrap:__subpackages__",
        "//tools/vps-release:__pkg__",
    ],
    deps = [
        ":package",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
    ],
)

py_library(
    name = "evidence",
    srcs = ["evidence.py"],
    imports = ["../.."],
    deps = [
        ":adapters",
        ":config",
        ":package",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
    ],
)

py_library(
    name = "reader",
    srcs = ["reader.py"],
    imports = ["../.."],
    deps = [
        ":adapters",
        ":config",
        ":evidence",
        ":package",
        "//platform/src/personal_cloud/deployment:kubernetes",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
        "@python_deps//httpx",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    imports = ["../.."],
    deps = [
        ":config",
        ":package",
        ":reader",
        "//platform/src/personal_cloud/deployment:router",
        "//proto:python_runtime",
        "//proto/common/errors/v1:python",
        "//proto/platform/runtime/v1:python",
        "@python_deps//fastapi",
        "@python_deps//starlette",
        "@python_deps//uvicorn",
    ],
)

py_library(
    name = "library",
    deps = [
        ":adapters",
        ":config",
        ":evidence",
        ":package",
        ":reader",
        ":server",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
