load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/python:tests.bzl", "pytest_test", "unittest_test")

package(default_visibility = ["//platform:__subpackages__"])

py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = ["../.."],
)

py_library(
    name = "test_status",
    srcs = ["test_status.py"],
    imports = ["../.."],
    deps = [
        ":package",
        "//platform/src/personal_cloud/status_daemon:adapters",
        "//platform/src/personal_cloud/status_daemon:config",
        "//platform/src/personal_cloud/status_daemon:evidence",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
    ],
)

pytest_test(
    name = "status_daemon_test_codex_gateway",
    srcs = ["test_codex_gateway.py"],
    args = ["$(rootpath test_codex_gateway.py)"],
    config = "//platform:pyproject.toml",
    data = [],
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    imports = [
        ".",
        "..",
        "../..",
        "../../src",
    ],
    deps = [
        ":package",
        "//platform/src/personal_cloud/status_daemon:adapters",
        "//platform/src/personal_cloud/status_daemon:config",
        "//platform/src/personal_cloud/status_daemon:evidence",
        "//proto:python_runtime",
    ],
)

unittest_test(
    name = "status_daemon_test_status",
    size = "small",
    srcs = ["test_status.py"],
    data = ["//platform:pyproject.toml"],
    imports = [
        ".",
        "..",
        "../..",
        "../../src",
    ],
    modules = ["tests.status_daemon.test_status"],
    deps = [
        ":package",
        "//platform/src/personal_cloud/status_daemon:adapters",
        "//platform/src/personal_cloud/status_daemon:config",
        "//platform/src/personal_cloud/status_daemon:evidence",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
    ],
)

unittest_test(
    name = "status_daemon_test_transport",
    size = "small",
    srcs = ["test_transport.py"],
    data = ["//platform:pyproject.toml"],
    imports = [
        ".",
        "..",
        "../..",
        "../../src",
    ],
    modules = ["tests.status_daemon.test_transport"],
    deps = [
        ":package",
        ":test_status",
        "//platform/src/personal_cloud/deployment:kubernetes",
        "//platform/src/personal_cloud/status_daemon:config",
        "//platform/src/personal_cloud/status_daemon:reader",
        "//platform/src/personal_cloud/status_daemon:server",
        "//proto:python_runtime",
        "//proto/platform/runtime/v1:python",
        "@python_deps//fastapi",
        "@python_deps//httpx",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":status_daemon_test_codex_gateway",
        ":status_daemon_test_status",
        ":status_daemon_test_transport",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
