load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:packaging.bzl", "py_package")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/images:images.bzl", "platform_image_identity", "platform_image_resources", "python_runtime_tree")
load("//tools/bazel/python:bootstrap_bundle.bzl", "bootstrap_bundle")
load("//tools/bazel/python:container_test.bzl", "container_image_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release",
    srcs = [
        ":platform",
        "//.github/actions:check-platform/action.yml",
        "//.github/actions:publish-platform/action.yml",
        "//tools/container-release:release_inputs",
    ],
    tags = [
        "artifact://platform:platform",
        "release:image:platform",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "manifests",
    srcs = glob([
        "k3s/**/*.yaml",
        "versions.json",
    ]),
)

py_package(
    name = "image_dependencies",
    packages = ["site-packages"],
    tags = ["manual"],
    deps = ["//platform/src/personal_cloud:library"],
)

pkg_files(
    name = "image_dependency_files",
    srcs = [":image_dependencies"],
    prefix = "opt/personal-cloud/platform/.venv/lib/python3.14/site-packages",
    strip_prefix = strip_prefix.from_root("site-packages"),
    tags = ["manual"],
)

pkg_tar(
    name = "image_dependency_layer",
    srcs = [":image_dependency_files"],
    tags = ["manual"],
)

py_package(
    name = "image_source",
    packages = ["platform/src"],
    tags = ["manual"],
    deps = ["//platform/src/personal_cloud:library"],
)

pkg_files(
    name = "image_source_files",
    srcs = [":image_source"],
    prefix = "opt/personal-cloud/app",
    strip_prefix = strip_prefix.from_root("platform/src"),
    tags = ["manual"],
)

py_package(
    name = "image_proto",
    packages = ["proto/python/src"],
    tags = ["manual"],
    deps = ["//platform/src/personal_cloud:library"],
)

pkg_files(
    name = "image_proto_files",
    srcs = [":image_proto"],
    prefix = "opt/personal-cloud/app",
    strip_prefix = strip_prefix.from_root("proto/python/src"),
    tags = ["manual"],
)

platform_image_resources(
    name = "image_resources",
    kubectl = "//tools/bazel/images:kubectl",
    manifests = glob(["k3s/newsletter/*.yaml"]),
    tags = ["manual"],
)

pkg_files(
    name = "image_resource_file",
    srcs = [":image_resources"],
    prefix = "opt/personal-cloud/app/personal_cloud",
    renames = {":image_resources": "resources.json"},
    tags = ["manual"],
)

pkg_tar(
    name = "image_source_layer",
    srcs = [
        ":image_proto_files",
        ":image_resource_file",
        ":image_source_files",
    ],
    tags = ["manual"],
)

python_runtime_tree(
    name = "image_runtime",
    base = "@python_base_linux_amd64",
    service = "platform",
    tags = ["manual"],
)

pkg_files(
    name = "image_runtime_files",
    srcs = [":image_runtime"],
    renames = {":image_runtime": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_tar(
    name = "image_runtime_layer",
    srcs = [":image_runtime_files"],
    symlinks = {
        "opt/personal-cloud/platform/.venv/bin/python": "/usr/local/bin/python3.14",
        "opt/personal-cloud/platform/.venv/bin/python3": "python",
        "opt/personal-cloud/platform/.venv/bin/python3.14": "python",
    },
    tags = ["manual"],
)

platform_image_identity(
    name = "image_identity",
    tags = ["manual"],
)

pkg_files(
    name = "image_identity_files",
    srcs = [":image_identity"],
    renames = {":image_identity": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_tar(
    name = "image_identity_layer",
    srcs = [":image_identity_files"],
    tags = ["manual"],
)

filegroup(
    name = "image_labels",
    srcs = [":image_identity"],
    output_group = "labels",
    tags = ["manual"],
)

oci_image(
    name = "image",
    base = "@python_base_linux_amd64",
    cmd = ["status-daemon"],
    entrypoint = [
        "python",
        "-m",
        "personal_cloud",
    ],
    env = {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": "/opt/personal-cloud/platform/.venv/bin:$PATH",
        "PYTHONPATH": "/opt/personal-cloud/app",
    },
    exposed_ports = ["8080"],
    labels = ":image_labels",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tars = [
        ":image_runtime_layer",
        ":image_dependency_layer",
        ":image_source_layer",
        ":image_identity_layer",
    ],
    user = "10001:10001",
    workdir = "/opt/personal-cloud",
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["todofy-platform:bazel"],
    tags = ["manual"],
)

filegroup(
    name = "image_tar",
    srcs = [":image_load"],
    output_group = "tarball",
    tags = ["manual"],
)

alias(
    name = "platform",
    actual = ":image_tar",
    tags = ["manual"],
)

test_suite(
    name = "check",
    tests = [
        ":container_test",
        ":ruff_check_test",
        ":ruff_format_test",
        ":tests",
        "//tools/container-release:build_identity_test",
    ],
)

filegroup(
    name = "config",
    srcs = [
        "apparmor/LICENSE",
        "apparmor/personal-cloud-systemd-observer-v1",
        "pyproject.toml",
        "versions.json",
        ":image_resources",
        ":manifests",
    ],
)

filegroup(
    name = "static_deployment_inputs",
    srcs = [
        "app.toml",
        "apparmor/LICENSE",
        "apparmor/personal-cloud-systemd-observer-v1",
        ":manifests",
    ],
)

source_audit_files(
    patterns = [
        "*",
        "apparmor/**",
        "k3s/**",
        "src/**",
        "systemd/**",
        "tests/**",
    ],
    deps = [
        "//platform/checks:source_audit_files",
        "//platform/src/personal_cloud:source_audit_files",
        "//platform/tests:source_audit_files",
    ],
)

filegroup(
    name = "python_lint_inputs",
    srcs = [
        "pyproject.toml",
        "//platform/src/personal_cloud:python_sources",
        "//platform/tests:python_sources",
    ],
)

filegroup(
    name = "bootstrap_sources",
    srcs = [
        ":static_deployment_inputs",
        "//config:cloud.toml",
        "//newsletter/src/newsletter:bootstrap_settings",
        "//tools/cloud-config:python_sources",
        "//tools/vps-bootstrap:python_sources",
        "//tools/vps-release:python_sources",
    ],
)

bootstrap_bundle(
    name = "bootstrap_bundle",
    srcs = ":bootstrap_sources",
)

filegroup(
    name = "container_probe_inputs",
    srcs = ["//tools/platform-build:probe_sources"],
)

container_image_test(
    name = "container_test",
    service = "platform",
    sources = ":container_probe_inputs",
)

alias(
    name = "library",
    actual = "//platform/src/personal_cloud:library",
)

test_suite(
    name = "ruff_check_test",
    tests = ["//platform/checks:ruff_check_test"],
)

test_suite(
    name = "ruff_format_test",
    tests = ["//platform/checks:ruff_format_test"],
)

test_suite(
    name = "tests",
    tests = ["//platform/tests"],
)
