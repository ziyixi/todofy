load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":model-router",
        "//.github/actions:release-model-router/action.yml",
        "//model-router/tools:connection_check",
        "//model-router/tools:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://model-router:model-router",
        "release:worker:model-router",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
        "//model-router/migrations:all",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//model-router/tools:check",
        "//model-router/web:check",
        "//model-router/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "model-router",
    srcs = [
        ":config",
        "//model-router/web:bundle",
        "//model-router/worker:application_sources",
        "//model-router/worker:edge_auth_types_link",
        "//model-router/worker:proto_types_link",
        "//model-router/worker/src:lib",
    ],
    bundle_visibility = ["//model-router:__subpackages__"],
    tool = "//model-router/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//model-router/web:bundle",
)

source_audit_files(patterns = [
    "*",
    "docs/**",
])
