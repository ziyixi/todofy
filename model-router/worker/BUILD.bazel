load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//model-router/worker:eslint/package_json.bzl", eslint = "bin")
load("@npm//model-router/worker:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_link", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//model-router:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//model-router:__subpackages__"],
)

alias(
    name = "package_json",
    actual = ":package_metadata",
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "proto_types_package",
    deps = [
        "//model-router/worker/src:lib",
        "//proto/modelrouter/inference/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/ts:http-client",
        "//proto/ts:http-transcoder",
        "//proto/ts:protobuf",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
    ],
)

workspace_package_link(
    name = "proto_types_link",
    src = ":proto_types_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_types_link",
    src = "//packages/edge-auth:pkg",
)

ts_project(
    name = "typecheck_project",
    srcs = [
        ":vitest.config.ts",
        "//model-router/worker/src:typecheck_project_srcs",
        "//model-router/worker/test:typecheck_project_srcs",
    ],
    data = [":vitest.config.ts"],
    no_emit = True,
    resolve_json_module = True,
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@anthropic-ai/sdk",
        ":node_modules/@cfworker/json-schema",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/jose",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":proto_types_link",
        "//:node_modules/@cloudflare/workers-types",
        "//model-router/tools:backup-restore",
        "//model-router/worker/src:lib",
    ],
)

alias(
    name = "typecheck",
    actual = ":typecheck_project_typecheck",
)

ts_project(
    name = "backup_types",
    srcs = ["//model-router/worker/src:backup_types_srcs"],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = {"compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "skipLibCheck": True,
        "types": ["@cloudflare/workers-types"],
    }},
    deps = [":node_modules/@cloudflare/workers-types"],
)

workspace_link(
    name = "runtime_edge_auth_link",
    src = "//packages/edge-auth:pkg",
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = ["//model-router/worker/src:application_sources_srcs"] + glob([
        "package.json",
        "tsconfig.json",
    ]),
)

test_suite(
    name = "check",
    tests = [
        ":backup_types_typecheck_test",
        ":lint",
        ":typecheck_project_typecheck_test",
        "//model-router/worker/test:check",
    ],
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":edge_auth_types_link",
        ":node_modules/@anthropic-ai/sdk",
        ":node_modules/@cfworker/json-schema",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/jose",
        ":node_modules/miniflare",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":package.json",
        ":proto_types_link",
        ":tsconfig.json",
        "//:node_modules/@cloudflare/workers-types",
        "//model-router/tools:backup-restore",
        "//model-router/worker/src:lib",
        "//tools/workerd-cpu:types",
    ],
    runner = eslint.eslint_binary,
    sources = ["//model-router/worker/src:lint_sources"] + ["//model-router/worker/test:lint_sources"] + glob(
        [
            "scripts/**/*.mjs",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

js_library(
    name = "package_metadata",
    srcs = [":package.json"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//model-router/worker/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":typecheck_project_typecheck_test"],
)

alias(
    name = "lib",
    actual = "//model-router/worker/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
        "test/**",
    ],
    deps = [
        "//model-router/worker/src:source_audit_files",
        "//model-router/worker/test:source_audit_files",
    ],
)
