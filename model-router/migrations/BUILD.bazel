load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "all",
    srcs = glob(["*.sql"]),
)

[js_library(
    name = source + "_data",
    srcs = [source],
) for source in glob(["*.sql"])]

source_audit_files()
