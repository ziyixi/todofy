load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "all",
    srcs = glob(["*.sql"]),
)

[
    js_library(
        name = source + "_data",
        srcs = [source],
    )
    for source in glob(["*.sql"])
]

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
