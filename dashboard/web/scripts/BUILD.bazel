load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//dashboard/web:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "copied_source_files", "proto_vitest_test")
load("//tools/bazel/audit:sources.bzl", "source_audit_files", SOURCE_AUDIT_EXCLUDES = "SOURCE_SUBPACKAGE_AUDIT_EXCLUDES")

package(default_visibility = ["//dashboard:__subpackages__"])

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//dashboard:__subpackages__"],
)

copied_source_files(
    name = "lint_sources",
    srcs = glob(
        ["**/*.mjs"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
)

js_library(
    name = "build_checks",
    srcs = [
        ":check-dist.mjs",
        ":js-budget.mjs",
        ":js-budget.test.mjs",
    ],
    deps = ["//tools/bundle-size:library"],
)

proto_vitest_test(
    name = "scripts_js_budget_test",
    config = "//dashboard/web:test_config",
    data = [
        "//:node_modules/vitest",
        "//dashboard/web:node_modules/@testing-library/jest-dom",
        "//dashboard/web:node_modules/@testing-library/react",
        "//dashboard/web:node_modules/@vitejs/plugin-react",
        "//dashboard/web:node_modules/jsdom",
        "//dashboard/web:node_modules/vite",
        "//dashboard/web:package_json",
        "//dashboard/web:test_config",
        "//dashboard/web/src/test:source_test_setup_ts",
    ],
    project = "dashboard/web",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [":js-budget.test.mjs"],
    deps = [":build_checks"],
)

source_audit_files(
    exclude = SOURCE_AUDIT_EXCLUDES,
    patterns = ["**"],
)

test_suite(name = "check")

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)
