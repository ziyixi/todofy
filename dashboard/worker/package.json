{
  "name": "home-dashboard-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"home\": the owner's ops dashboard for Mail Hero and Todofy (HomeState Durable Object, Ops service bindings).",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //dashboard/worker:typecheck_tests",
    "lint": "bazel test //dashboard/worker:lint",
    "test": "bazel test //dashboard/worker:unit_tests",
    "test:runtime": "bazel test //dashboard/worker:runtime_tests --nocache_test_results",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //dashboard/web:bundle && wrangler dev --assets ../../bazel-bin/dashboard/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "check": "bazel test //dashboard:check"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
