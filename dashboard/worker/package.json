{
  "name": "home-dashboard-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"home\": the owner's ops dashboard for Mail Hero and Todofy (HomeState Durable Object, Ops service bindings).",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/runtime/tsconfig.json",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "pretest:runtime": "node ../../proto/tools/ensure.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "wrangler dev --config ../wrangler.toml --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
