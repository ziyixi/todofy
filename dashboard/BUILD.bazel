load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":dashboard",
        "//.github/actions:release-dashboard/action.yml",
        "//.github/actions:worker-deploy/action.yml",
        "//.github/actions:worker-prepare/action.yml",
        "//dashboard/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://dashboard:dashboard",
        "release:worker:dashboard",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//dashboard/deploy:check",
        "//dashboard/web:check",
        "//dashboard/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "dashboard",
    srcs = [
        ":config",
        "//dashboard/web:bundle",
        "//dashboard/worker:application_sources",
        "//dashboard/worker:edge_auth_types_link",
        "//dashboard/worker:proto_types_link",
        "//dashboard/worker/src:lib",
    ],
    bundle_visibility = ["//dashboard:__subpackages__"],
    tool = "//dashboard/worker:wrangler",
    tools = [":private_catalog_cli"],
    visibility = ["//visibility:public"],
    web = "//dashboard/web:bundle",
)

# The release step's check of PRIVATE_CATALOG runs Home's own parser (deploy/private-catalog.mjs) with plain Node.
js_run_binary(
    name = "private_catalog_cli",
    srcs = [
        "//dashboard/deploy:source_private_catalog_mjs",
        "//dashboard/worker:proto_types_link",
        "//dashboard/worker/src:lib",
        "//tools/cloud-config:worker-secrets",
    ],
    outs = ["tools/private-catalog.mjs"],
    args = [
        "deploy/private-catalog.mjs",
        "tools/private-catalog.mjs",
    ],
    chdir = package_name(),
    tool = "//dashboard/worker:bundle_node",
    visibility = ["//dashboard:__subpackages__"],
)

source_audit_files()
