load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//packages/planning-ui:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//packages/planning-ui:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

js_library(
    name = "lib",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/planning-ui/src:AddStep",
        "//packages/planning-ui/src:App",
        "//packages/planning-ui/src:BetText",
        "//packages/planning-ui/src:ExecutionFields",
        "//packages/planning-ui/src:FocusBlock",
        "//packages/planning-ui/src:FocusView",
        "//packages/planning-ui/src:MailCategories",
        "//packages/planning-ui/src:PlanView",
        "//packages/planning-ui/src:PlanningCalendar",
        "//packages/planning-ui/src:PlanningWeek",
        "//packages/planning-ui/src:QuickTasks",
        "//packages/planning-ui/src:ReviewBoard",
        "//packages/planning-ui/src:StatusMarks",
        "//packages/planning-ui/src:TaskBreadcrumb",
        "//packages/planning-ui/src:TaskDependencies",
        "//packages/planning-ui/src:TaskEditor",
        "//packages/planning-ui/src:WeeklyGoals",
        "//packages/planning-ui/src:WeeklyReview",
        "//packages/planning-ui/src:announce",
        "//packages/planning-ui/src:api",
        "//packages/planning-ui/src:bets",
        "//packages/planning-ui/src:deadlines",
        "//packages/planning-ui/src:dependencies",
        "//packages/planning-ui/src:dependencies_css",
        "//packages/planning-ui/src:domain",
        "//packages/planning-ui/src:drag-announcements",
        "//packages/planning-ui/src:focus_css",
        "//packages/planning-ui/src:i18n",
        "//packages/planning-ui/src:index",
        "//packages/planning-ui/src:mail",
        "//packages/planning-ui/src:model",
        "//packages/planning-ui/src:plan-updates",
        "//packages/planning-ui/src:plan-view-state",
        "//packages/planning-ui/src:planner_css",
        "//packages/planning-ui/src:planning-board_css",
        "//packages/planning-ui/src:planning-outcomes",
        "//packages/planning-ui/src:planning-week_css",
        "//packages/planning-ui/src:review-board_css",
        "//packages/planning-ui/src:review-lanes",
        "//packages/planning-ui/src:styles_css",
        "//packages/planning-ui/src:weekly-goals_css",
        "//packages/planning-ui/src:weekly-review",
        "//packages/planning-ui/src:weekly-review_css",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        ":lib",
        ":package.json",
    ],
    package = "@ziyixi/planning-ui",
    visibility = ["//visibility:public"],
)

proto_package(
    name = "proto_typecheck_package",
    deps = [":lib"],
)

workspace_package_link(
    name = "proto_typecheck_link",
    src = ":proto_typecheck_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

alias(
    name = "planning-ui",
    actual = ":lib",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = ["//packages/planning-ui/test:check"],
    visibility = ["//visibility:public"],
)

source_audit_files(
    patterns = [
        "*",
        "docs/**",
    ],
    deps = [
        "//packages/planning-ui/src:source_audit_files",
        "//packages/planning-ui/test:source_audit_files",
    ],
)

js_library(
    name = "package_metadata",
    srcs = ["package.json"],
)

js_library(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
)

ts_config(
    name = "compiler_config",
    src = "tsconfig.json",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//packages/planning-ui/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = ["//packages/planning-ui/test:typecheck_tests"],
)

ts_project(
    name = "types",
    srcs = [
        "//packages/planning-ui/src:typecheck_sources",
        "//packages/planning-ui/test:typecheck_sources",
    ],
    no_emit = True,
    tsconfig = "//packages/planning-ui:compiler_config",
    deps = [
        "//:node_modules/@types/react",
        "//packages/planning-ui:node_modules/@dnd-kit/collision",
        "//packages/planning-ui:node_modules/@dnd-kit/dom",
        "//packages/planning-ui:node_modules/@dnd-kit/react",
        "//packages/planning-ui:node_modules/@testing-library/react",
        "//packages/planning-ui:node_modules/@types/node",
        "//packages/planning-ui:node_modules/@types/react",
        "//packages/planning-ui:node_modules/@types/react-dom",
        "//packages/planning-ui:node_modules/@vitejs/plugin-react",
        "//packages/planning-ui:node_modules/jsdom",
        "//packages/planning-ui:node_modules/lucide-react",
        "//packages/planning-ui:node_modules/react",
        "//packages/planning-ui:node_modules/react-dom",
        "//packages/planning-ui:node_modules/vite",
        "//packages/planning-ui:node_modules/vitest",
        "//packages/planning-ui:proto_typecheck_link",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)
