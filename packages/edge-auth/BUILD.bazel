load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//packages/edge-auth:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.dom.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//packages/edge-auth:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

npm_package(
    name = "pkg",
    srcs = [
        ":package.json",
        "//packages/edge-auth/src:lib",
    ],
    package = "@ziyixi/edge-auth",
    visibility = ["//visibility:public"],
)

alias(
    name = "edge-auth",
    actual = "//packages/edge-auth/src:lib",
    visibility = ["//visibility:public"],
)

alias(
    name = "lib",
    actual = "//packages/edge-auth/src:lib",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = ["//packages/edge-auth/test:check"],
    visibility = ["//visibility:public"],
)

source_audit_files(
    patterns = [
        "*",
        "docs/**",
    ],
    deps = [
        "//packages/edge-auth/src:source_audit_files",
        "//packages/edge-auth/test:source_audit_files",
    ],
)

js_library(
    name = "package_metadata",
    srcs = ["package.json"],
)

js_library(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
)

ts_config(
    name = "compiler_config",
    src = "tsconfig.json",
)

ts_config(
    name = "dom_compiler_config",
    src = "tsconfig.dom.json",
    deps = [":compiler_config"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//packages/edge-auth/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = ["//packages/edge-auth/test:typecheck_tests"],
)
