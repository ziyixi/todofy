load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//tools/bazel:js.bzl", "copied_source_files")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//packages/edge-auth:__subpackages__"])

exports_files(
    glob(
        [
            "*.ts",
            "*.tsx",
            "*.css",
        ],
        allow_empty = True,
    ),
    visibility = ["//packages/edge-auth:__subpackages__"],
)

js_library(
    name = "lib",
    srcs = glob(["*.ts"]),
    types = glob(["*.ts"]),
    visibility = ["//visibility:public"],
)

ts_project(
    name = "types_dom",
    srcs = glob(["*.ts"]),
    extends = "//packages/edge-auth:compiler_config",
    no_emit = True,
    root_dir = "..",
    tsconfig = "//packages/edge-auth:dom_compiler_config",
    deps = ["//packages/edge-auth:node_modules/@cloudflare/workers-types"],
)

alias(
    name = "typecheck_dom",
    actual = ":types_dom_typecheck",
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

copied_source_files(
    name = "typecheck_sources",
    srcs = [
        "access.ts",
        "bytes.ts",
        "cookies.ts",
        "csrf.ts",
        "headers.ts",
        "index.ts",
        "keys.ts",
        "tokens.ts",
    ],
)
