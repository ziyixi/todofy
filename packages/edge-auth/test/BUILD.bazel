load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//packages/edge-auth:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "vitest_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//packages/edge-auth:__subpackages__"])

exports_files(
    glob(
        [
            "*.ts",
            "*.tsx",
            "*.css",
        ],
        allow_empty = True,
    ),
    visibility = ["//packages/edge-auth:__subpackages__"],
)

ts_project(
    name = "types",
    srcs = ["//packages/edge-auth/src:typecheck_sources"] + glob(["*.ts"]) + ["//packages/edge-auth:vitest_config"],
    no_emit = True,
    root_dir = "..",
    tsconfig = "//packages/edge-auth:compiler_config",
    deps = [
        "//packages/edge-auth:node_modules/@cloudflare/workers-types",
        "//packages/edge-auth:node_modules/vitest",
    ],
)

[vitest_test(
    name = test.replace(".test.ts", "_test"),
    config = "//packages/edge-auth:vitest_config",
    data = [
        ":helpers.ts",
        "//packages/edge-auth:package_metadata",
        "//packages/edge-auth:vitest_config",
        "//packages/edge-auth/src:lib",
    ],
    project = "packages/edge-auth",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [test],
) for test in glob(["*.test.ts"])]

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = [
        ":access_test",
        ":csrf_test",
        ":headers_test",
        ":primitives_test",
    ],
)

test_suite(
    name = "typecheck_tests",
    tests = [
        ":types_typecheck_test",
        "//packages/edge-auth/src:types_dom_typecheck_test",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":typecheck_tests",
        ":unit_tests",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
