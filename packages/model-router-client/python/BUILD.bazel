load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

py_package(
    name = "wheel_files",
    packages = ["packages/model-router-client/python/src"],
    tags = ["manual"],
    deps = ["//packages/model-router-client/python/src/model_router_client:package"],
)

py_wheel(
    name = "wheel",
    distribution = "ziyixi-model-router-client",
    python_requires = ">=3.14",
    requires = ["ziyixi-proto"],
    stamp = 0,
    strip_path_prefixes = ["packages/model-router-client/python/src"],
    tags = ["manual"],
    version = "0.1.0",
    deps = [":wheel_files"],
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
    ],
    deps = [
        "//packages/model-router-client/python/src/model_router_client:source_audit_files",
        "//packages/model-router-client/python/tests:source_audit_files",
    ],
)

alias(
    name = "library",
    actual = "//packages/model-router-client/python/src/model_router_client:library",
)

alias(
    name = "package",
    actual = "//packages/model-router-client/python/src/model_router_client:package",
)

test_suite(
    name = "tests",
    tests = ["//packages/model-router-client/python/tests"],
)
