load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/model-router-client:vitest/package_json.bzl", vitest = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "vitest_test", "workspace_link", "workspace_package_link")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "lib",
    srcs = ["src/index.ts"],
    types = ["src/index.ts"],
    deps = ["//proto/ts:http-client", "//proto/ts:protobuf", "//proto/modelrouter/inference/v1:ts"],
)

npm_package(
    name = "pkg",
    srcs = [":lib", "package.json"],
    package = "@ziyixi/model-router-client",
)

proto_package(
    name = "proto_package",
    deps = [":lib"],
)

workspace_package_link(
    name = "proto_typecheck_link",
    src = ":proto_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_link(
    name = "proto_test_link",
    src = ":proto_package",
)

ts_project(
    name = "types",
    srcs = ["src/index.ts", "test/index.test.ts"],
    no_emit = True,
    deps = [":proto_typecheck_link", ":node_modules/@cloudflare/workers-types", ":node_modules/vitest"],
)

vitest_test(
    name = "client_test",
    runner = vitest.vitest_test,
    tests = ["test/index.test.ts"],
    data = [":lib", ":proto_test_link", "package.json"],
)

alias(name = "typecheck", actual = ":types_typecheck")
