load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/model-router-client:vitest/package_json.bzl", vitest = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "vitest_test", "workspace_link", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "lib",
    srcs = ["src/index.ts"],
    types = ["src/index.ts"],
    visibility = ["//visibility:public"],
    deps = [
        "//proto/modelrouter/inference/v1:ts",
        "//proto/ts:http-client",
        "//proto/ts:protobuf",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    package = "@ziyixi/model-router-client",
    visibility = ["//visibility:public"],
)

proto_package(
    name = "proto_package",
    deps = [":lib"],
)

workspace_package_link(
    name = "proto_typecheck_link",
    src = ":proto_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_link(
    name = "proto_test_link",
    src = ":proto_package",
)

ts_project(
    name = "types",
    srcs = [
        "src/index.ts",
        "test/index.test.ts",
    ],
    no_emit = True,
    deps = [
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/vitest",
        ":proto_typecheck_link",
    ],
)

vitest_test(
    name = "client_test",
    data = [
        "package.json",
        ":lib",
        ":proto_test_link",
    ],
    runner = vitest.vitest_test,
    tests = ["test/index.test.ts"],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

test_suite(
    name = "check",
    visibility = ["//visibility:public"],
)

alias(
    name = "model-router-client",
    actual = ":lib",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "src/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
