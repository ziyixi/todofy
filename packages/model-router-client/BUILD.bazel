load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//packages/model-router-client:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
    ],
    visibility = ["//packages/model-router-client:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

npm_package(
    name = "pkg",
    srcs = [
        ":package.json",
        "//packages/model-router-client/src:lib",
    ],
    package = "@ziyixi/model-router-client",
    visibility = ["//visibility:public"],
)

proto_package(
    name = "proto_package",
    deps = ["//packages/model-router-client/src:lib"],
)

workspace_package_link(
    name = "proto_typecheck_link",
    src = ":proto_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

alias(
    name = "model-router-client",
    actual = "//packages/model-router-client/src:lib",
    visibility = ["//visibility:public"],
)

alias(
    name = "lib",
    actual = "//packages/model-router-client/src:lib",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//packages/model-router-client/python/tests:test_client",
        "//packages/model-router-client/test:check",
    ],
    visibility = ["//visibility:public"],
)

source_audit_files(
    patterns = [
        "*",
        "docs/**",
    ],
    deps = [
        "//packages/model-router-client/src:source_audit_files",
        "//packages/model-router-client/test:source_audit_files",
    ],
)

js_library(
    name = "package_metadata",
    srcs = ["package.json"],
)

ts_config(
    name = "compiler_config",
    src = "tsconfig.json",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//packages/model-router-client/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = ["//packages/model-router-client/test:typecheck_tests"],
)
