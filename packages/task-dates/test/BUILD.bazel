load("@npm//packages/task-dates:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "copied_source_files", "vitest_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//packages/task-dates:__subpackages__"])

exports_files(
    glob(
        [
            "*.ts",
            "*.tsx",
            "*.css",
        ],
        allow_empty = True,
    ),
    visibility = ["//packages/task-dates:__subpackages__"],
)

vitest_test(
    name = "dates_test",
    data = [
        "//packages/task-dates:package_metadata",
        "//packages/task-dates/src:lib",
    ],
    project = "packages/task-dates",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [":dates.test.ts"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = [":dates_test"],
)

test_suite(
    name = "typecheck_tests",
    tests = ["//packages/task-dates:types_typecheck_test"],
)

test_suite(
    name = "check",
    tests = [
        ":typecheck_tests",
        ":unit_tests",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

copied_source_files(
    name = "typecheck_sources",
    srcs = [":dates.test.ts"],
)
