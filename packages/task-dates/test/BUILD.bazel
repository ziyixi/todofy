load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//packages/task-dates:vitest/package_json.bzl", vitest = "bin")
load("//tools/bazel:js.bzl", "vitest_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//packages/task-dates:__subpackages__"])

exports_files(
    glob(
        [
            "*.ts",
            "*.tsx",
            "*.css",
        ],
        allow_empty = True,
    ),
    visibility = ["//packages/task-dates:__subpackages__"],
)

ts_project(
    name = "types",
    srcs = [
        ":dates.test.ts",
        "//packages/task-dates/src:typecheck_sources",
    ],
    no_emit = True,
    root_dir = "..",
    tsconfig = "//packages/task-dates:compiler_config",
    deps = [
        "//packages/task-dates:node_modules/chrono-node",
        "//packages/task-dates:node_modules/rrule",
        "//packages/task-dates:node_modules/vitest",
    ],
)

vitest_test(
    name = "dates_test",
    data = [
        "//packages/task-dates:package_metadata",
        "//packages/task-dates/src:lib",
    ],
    project = "packages/task-dates",
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = [":dates.test.ts"],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = [":dates_test"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":types_typecheck_test"],
)

test_suite(
    name = "check",
    tests = [
        ":typecheck_tests",
        ":unit_tests",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
