    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    imports = ["."],
    deps = [":config"],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + ["//tools/vps-bootstrap/tests:python_sources"],
)

test_suite(
    name = "check",
    tests = ["//tools/vps-bootstrap/tests:check"],
)

source_audit_files(deps = ["//tools/vps-bootstrap/tests:source_audit_files"])
