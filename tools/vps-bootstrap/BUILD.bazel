load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "binaries",
    srcs = ["binaries.py"],
    imports = ["."],
    deps = [
        ":config",
        ":host",
    ],
)

py_library(
    name = "cluster",
    srcs = ["cluster.py"],
    imports = ["."],
    deps = [
        ":binaries",
        ":config",
        ":host",
        ":runner",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["."],
)

py_library(
    name = "firewall",
    srcs = ["firewall.py"],
    imports = ["."],
    deps = [
        ":config",
        ":node_address",
        ":runner",
    ],
)

py_library(
    name = "host",
    srcs = ["host.py"],
    imports = ["."],
    deps = [
        ":config",
        ":runner",
    ],
)

py_library(
    name = "install",
    srcs = ["install.py"],
    imports = ["."],
    deps = [
        ":binaries",
        ":cluster",
        ":config",
        ":firewall",
        ":host",
        ":node_address",
        ":observer_policy",
        ":reader",
    ],
)

