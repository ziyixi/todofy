        ":config",
        ":host",
        ":runner",
    ],
)

py_library(
    name = "prepare",
    srcs = ["prepare.py"],
    imports = ["."],
    deps = [
        ":config",
        ":firewall",
        ":node_address",
        "//tools/vps-release:release_identity",
        "//tools/vps-release:render",
        "@python_deps//pyyaml",
    ],
)

py_library(
    name = "reader",
    srcs = ["reader.py"],
    imports = ["."],
    deps = [
        ":config",
        ":host",
        ":runner",
    ],
)

py_library(
    name = "recover",
    srcs = ["recover.py"],
    imports = ["."],
    deps = [
        ":binaries",
        ":cluster",
        ":config",
        ":host",
        ":node_address",
        ":observer_policy",
