        ":config",
        ":host",
    ],
)

py_library(
    name = "repair_gate",
    srcs = ["repair_gate.py"],
    imports = ["."],
    deps = [
        "//newsletter/src/newsletter:drain",
        "//newsletter/src/newsletter:ownership",
    ],
