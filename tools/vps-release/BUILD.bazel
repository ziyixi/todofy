load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "deploy",
    srcs = ["deploy.py"],
    imports = ["."],
    deps = [
        ":evidence",
        ":release_identity",
        ":transport",
        "//proto/platform/runtime/v1:python",
    ],
)

py_library(
    name = "evidence",
    srcs = ["evidence.py"],
    imports = ["."],
    deps = [":transport"],
)

py_library(
    name = "reconcile",
    srcs = ["reconcile.py"],
    imports = ["."],
    deps = [
        ":deploy",
        ":evidence",
        ":release_identity",
        ":transport",
        "//proto/platform/runtime/v1:python",
    ],
)

py_library(
    name = "release_identity",
    srcs = ["release_identity.py"],
    imports = ["."],
    deps = ["//tools/cloud-config:cloud_profile"],
)

py_library(
    name = "render",
    srcs = ["render.py"],
    imports = ["."],
    deps = [
        ":release_identity",
        "//platform/src/personal_cloud/deployment:resources",
        "//platform/src/personal_cloud/status_daemon:config",
        "//proto/platform/runtime/v1:python",
        "@python_deps//pyyaml",
    ],
)

py_library(
    name = "transport",
    srcs = ["transport.py"],
    imports = ["."],
    deps = [
        "//proto:python_runtime",
        "//proto/common/errors/v1:python",
        "//proto/platform/runtime/v1:python",
        "@python_deps//httpx",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + ["//tools/vps-release/tests:python_sources"],
)

test_suite(
    name = "check",
    tests = ["//tools/vps-release/tests:check"],
)

source_audit_files(deps = ["//tools/vps-release/tests:source_audit_files"])

py_binary(
    name = "deploy_cli",
    srcs = ["deploy.py"],
    legacy_create_init = False,
    main = "deploy.py",
    deps = [":deploy"],
)

py_binary(
    name = "reconcile_cli",
    srcs = ["reconcile.py"],
    legacy_create_init = False,
    main = "reconcile.py",
    deps = [":reconcile"],
)
