load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "library",
    srcs = ["bundle-size.mjs"],
)

source_audit_files(patterns = [
    "*",
    "test/**",
])

tsx.tsx_test(
    name = "bundle-size_test",
    args = [
        "--test",
        "tools/bundle-size/test/bundle-size.test.mjs",
    ],
    data = [
        "test/bundle-size.test.mjs",
        ":library",
    ],
)

test_suite(
    name = "check",
    tests = [":bundle-size_test"],
    visibility = ["//visibility:public"],
)
