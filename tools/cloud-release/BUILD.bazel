load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release_inputs",
    srcs = [
        "assets-session-retry.sh",
        ":artifact",
        "//.github/actions:setup-bazel/action.yml",
        "//.github/actions:setup-workspace/action.yml",
        "//.github/workflows:worker-release.yml",
        "//tools/cf-guard:cli",
        "//tools/cloud-config:worker-deploy",
        "//tools/cloud-config:worker-secrets",
    ],
)

py_library(
    name = "api",
    srcs = ["api.py"],
    imports = ["."],
)

py_library(
    name = "cloudflare",
    srcs = ["cloudflare.py"],
    imports = ["."],
    deps = ["//tools/cloud-release:api"],
)

py_library(
    name = "control",
    srcs = ["control.py"],
    imports = ["."],
    deps = [
        "//tools/cloud-release:api",
        "//tools/cloud-release:cloudflare",
        "//tools/cloud-release:deployments",
    ],
)

py_library(
    name = "deployments",
    srcs = ["deployments.py"],
    imports = ["."],
    deps = ["//tools/cloud-release:api"],
)

py_library(
    name = "vps_record",
    srcs = ["vps_record.py"],
    imports = ["."],
    deps = [
        "//tools/cloud-release:api",
        "//tools/cloud-release:deployments",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + ["//tools/cloud-release/tests:python_sources"],
)

test_suite(
    name = "check",
    tests = ["//tools/cloud-release/tests:check"],
)

source_audit_files(deps = ["//tools/cloud-release/tests:source_audit_files"])

py_library(
    name = "artifact",
    srcs = ["artifact.py"],
    imports = ["."],
    deps = [":control"],
)
