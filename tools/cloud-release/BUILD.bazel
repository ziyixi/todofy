    name = "check",
    tests = [
        ":test_artifact_test",
        ":test_assets_session_retry_test",
        ":test_drift_acceptance_test",
        ":test_release_test",
        ":test_vps_record_test",
        ":test_website_retirement_test",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "tests/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

