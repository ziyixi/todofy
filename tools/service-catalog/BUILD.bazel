load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    imports = ["."],
    deps = ["//tools/cloud-config:cloud_profile"],
)

py_library(
    name = "private_catalog",
    srcs = ["private_catalog.py"],
    imports = ["."],
    deps = [
        ":catalog",
        "//tools/cloud-config:cloud_profile",
        "//tools/cloud-release:cloudflare",
    ],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    imports = ["."],
    deps = [
        ":catalog",
        ":private_catalog",
        "//tools/cloud-config:cloud_profile",
        "//tools/cloud-release:api",
        "//tools/cloud-release:cloudflare",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + [
        "//tools/service-catalog/tests:fixtures",
        "//tools/service-catalog/tests:python_sources",
    ],
)

test_suite(
    name = "check",
    tests = ["//tools/service-catalog/tests:check"],
)

source_audit_files(deps = ["//tools/service-catalog/tests:source_audit_files"])
