load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    imports = ["."],
    deps = ["//tools/cloud-config:cloud_profile"],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    imports = ["."],
    deps = [
        "//tools/cloud-config:cloud_profile",
        "//tools/cloud-release:api",
        "//tools/cloud-release:cloudflare",
        "//tools/service-catalog:catalog",
    ],
)

py_test(
    name = "test_catalog_test",
    srcs = [
        "tests/test_catalog.py",
        "//tools/bazel/python:unittest_main.py",
    ],
    args = ["test_catalog"],
    data = [
        ":python_sources",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "tests",
    ],
    legacy_create_init = False,
    main = "//tools/bazel/python:unittest_main.py",
    deps = ["//tools/service-catalog:catalog"],
)

py_test(
    name = "test_inventory_test",
    srcs = [
        "tests/test_inventory.py",
        "//tools/bazel/python:unittest_main.py",
    ],
    args = ["test_inventory"],
    data = [
        ":python_sources",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "tests",
    ],
    legacy_create_init = False,
    main = "//tools/bazel/python:unittest_main.py",
    deps = [
        "//tools/service-catalog:catalog",
        "//tools/service-catalog:inventory",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
            "tests/*.py",
            "tests/*.json",
        ],
        allow_empty = True,
    ),
)

test_suite(
    name = "check",
    tests = [
        ":test_catalog_test",
        ":test_inventory_test",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "tests/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
