load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")

py_library(
    name = "planner",
    srcs = [
        "plan.py",
        "releases.py",
        "run.py",
    ],
    imports = ["."],
)

py_test(
    name = "tests",
    srcs = ["test_ci.py"],
    legacy_create_init = False,
    main = "test_ci.py",
    deps = [":planner"],
)

test_suite(
    name = "check",
    tests = [
        ":private_diagnostics_test",
        ":release_tests",
        ":tests",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "private_diagnostics",
    srcs = ["private_diagnostics.py"],
    imports = ["."],
)

py_test(
    name = "private_diagnostics_test",
    srcs = ["test_private_diagnostics.py"],
    legacy_create_init = False,
    main = "test_private_diagnostics.py",
    deps = [":private_diagnostics"],
)

py_test(
    name = "release_tests",
    srcs = ["test_releases.py"],
    legacy_create_init = False,
    main = "test_releases.py",
    deps = [":planner"],
)

# Manual: it needs the fixed Bazel and Target Determinator binaries and runs nested Bazel servers.
py_binary(
    name = "graph_test",
    srcs = ["graph_test.py"],
    legacy_create_init = False,
    main = "graph_test.py",
    tags = ["manual"],
    deps = [":planner"],
)

source_audit_files()
