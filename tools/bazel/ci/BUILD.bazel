load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")

py_library(
    name = "planner",
    srcs = [
        "plan.py",
        "releases.py",
        "run.py",
    ],
    imports = ["."],
)

py_test(
    name = "tests",
    srcs = ["test_ci.py"],
    legacy_create_init = False,
    main = "test_ci.py",
    deps = [":planner"],
)

test_suite(
    name = "check",
    tests = [
        ":release_tests",
        ":tests",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "release_tests",
    srcs = ["test_releases.py"],
    legacy_create_init = False,
    main = "test_releases.py",
    deps = [":planner"],
)

source_audit_files()
