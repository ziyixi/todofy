load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

py_library(
    name = "planner",
    srcs = [
        "plan.py",
        "releases.py",
        "run.py",
    ],
    imports = ["."],
)

py_test(
    name = "tests",
    srcs = ["test_ci.py"],
    legacy_create_init = False,
    main = "test_ci.py",
    deps = [":planner"],
)

test_suite(
    name = "check",
    tests = [":tests", ":release_tests"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "release_tests",
    srcs = ["test_releases.py"],
    main = "test_releases.py",
    deps = [":planner"],
    legacy_create_init = False,
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
