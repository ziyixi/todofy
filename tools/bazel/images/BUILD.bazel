load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "images.bzl",
    "docker-public.json",
    "newsletter-entrypoint",
    "newsletter-trigger-entrypoint",
])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "kubectl",
    actual = select({
        ":macos_arm64": "@kubectl_darwin_arm64//file",
        ":linux_x86_64": "@kubectl_linux_amd64//file",
    }),
    tags = ["manual"],
)

py_binary(
    name = "runtime_tree",
    srcs = ["runtime_tree.py"],
    legacy_create_init = False,
)

py_binary(
    name = "gateway_identity",
    srcs = ["gateway_identity.py"],
    legacy_create_init = False,
    deps = ["//codex-gateway:access"],
)

py_binary(
    name = "newsletter_identity",
    srcs = ["newsletter_identity.py"],
    legacy_create_init = False,
    deps = ["//newsletter:console_access"],
)

py_binary(
    name = "newsletter_healthcheck",
    srcs = ["newsletter_healthcheck.py"],
    legacy_create_init = False,
)

py_binary(
    name = "platform_identity",
    srcs = ["platform_identity.py"],
    legacy_create_init = False,
)

py_binary(
    name = "platform_resources",
    srcs = ["platform_resources.py"],
    legacy_create_init = False,
    deps = ["@python_deps//pyyaml"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
