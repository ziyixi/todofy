load("@npm//links/worker:wrangler/package_json.bzl", wrangler = "bin")
load("@npm//proto:@bufbuild/buf/package_json.bzl", buf = "bin")
load("@npm//proto:@bufbuild/protoc-gen-es/package_json.bzl", protoc_gen_es = "bin")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cloudflare.bzl",
    "js.bzl",
    "paths.bzl",
])

buf.buf_binary(name = "buf")

protoc_gen_es.protoc_gen_es_binary(name = "protoc-gen-es")

wrangler.wrangler_binary(
    name = "wrangler",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
)

tsx.tsx_binary(name = "tsx")

test_suite(
    name = "check",
    tests = ["//tools/bazel/test:check"],
)

source_audit_files(deps = [
    "//tools/bazel/js-deps:source_audit_files",
    "//tools/bazel/test:source_audit_files",
])
