load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

exports_files(
    ["workerd-cpu.mts"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "lib",
    srcs = ["workerd-cpu.mts"],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "types",
    srcs = ["workerd-cpu.mts"],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = {
        "compilerOptions": {
            "target": "ES2024",
            "lib": ["ES2024"],
            "module": "ESNext",
            "moduleResolution": "Bundler",
            "strict": True,
            "noUncheckedIndexedAccess": True,
            "skipLibCheck": True,
            "types": ["node"],
            "typeRoots": ["../../proto/node_modules/@types"],
        },
    },
    visibility = ["//visibility:public"],
    deps = ["//proto:node_modules/@types/node"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

tsx.tsx_test(
    name = "workerd-cpu_test",
    args = [
        "--test",
        "tools/workerd-cpu/test/workerd-cpu.test.mts",
    ],
    data = [
        "test/workerd-cpu.test.mts",
        ":lib",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":types_typecheck_test",
        ":workerd-cpu_test",
    ],
    visibility = ["//visibility:public"],
)
