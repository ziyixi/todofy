load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/python:tests.bzl", "unittest_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release_inputs",
    srcs = [
        "image.py",
        ":build",
    ],
    visibility = ["//visibility:public"],
)

