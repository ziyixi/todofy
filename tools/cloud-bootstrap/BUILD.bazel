py_test(
    name = "test_bootstrap_test",
    srcs = [
        "tests/test_bootstrap.py",
        "//tools/bazel/python:unittest_main.py",
    ],
    args = ["test_bootstrap"],
    data = [
        ":python_sources",
        "//tools:repository_test_data",
    ],
    env = {"BAZEL_COPY_WORKSPACE": "1"},
    imports = [
        ".",
        "tests",
    ],
    legacy_create_init = False,
    main = "//tools/bazel/python:unittest_main.py",
    deps = [
        "//tools/cloud-bootstrap:adopt_metadata",
        "//tools/cloud-bootstrap:bootstrap_inventory",
        "//tools/cloud-bootstrap:cloud_api",
        "//tools/cloud-bootstrap:finalize",
        "//tools/cloud-bootstrap:github_config",
