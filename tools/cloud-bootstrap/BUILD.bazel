load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "adopt_metadata",
    srcs = ["adopt_metadata.py"],
    imports = ["."],
    deps = [
        ":cloud_api",
        ":private_input",
    ],
)

py_library(
    name = "bootstrap",
    srcs = ["bootstrap.py"],
    imports = ["."],
    deps = [
        ":bootstrap_inventory",
        ":finalize",
        ":github_config",
        ":github_secrets",
        ":inventory_pr",
        ":private_input",
        ":tofu_bootstrap",
        "//infra/scripts:infra_state",
        "//tools/cloud-config:cloud_profile",
        "//tools/cloud-config:generate",
        "//tools/service-catalog:catalog",
    ],
)

py_library(
    name = "bootstrap_inventory",
    srcs = ["bootstrap_inventory.py"],
    imports = ["."],
    deps = [":private_input"],
)

py_library(
    name = "cloud_api",
    srcs = ["cloud_api.py"],
    imports = ["."],
    deps = [":private_input"],
)

py_library(
    name = "finalize",
    srcs = ["finalize.py"],
    imports = ["."],
    deps = [
        ":private_input",
        "//tools/cloud-release:api",
        "//tools/cloud-release:cloudflare",
        "//tools/cloud-release:control",
        "//tools/cloud-release:deployments",
    ],
)

py_library(
    name = "fresh_collisions",
    srcs = ["fresh_collisions.py"],
    imports = ["."],
    deps = [
        ":cloud_api",
        ":private_input",
    ],
)

py_library(
    name = "github_config",
    srcs = ["github_config.py"],
    imports = ["."],
    deps = [":private_input"],
)

py_library(
    name = "github_secrets",
    srcs = ["github_secrets.py"],
    imports = ["."],
    deps = [":private_input"],
)

py_library(
    name = "inventory_pr",
    srcs = ["inventory_pr.py"],
    imports = ["."],
    deps = [":private_input"],
)

py_library(
    name = "private_input",
    srcs = ["private_input.py"],
    imports = ["."],
)

py_library(
    name = "state_imports",
    srcs = ["state_imports.py"],
    imports = ["."],
    deps = [
        ":private_input",
        "//infra/scripts:infra_state",
    ],
)

py_library(
    name = "tofu_bootstrap",
    srcs = ["tofu_bootstrap.py"],
    imports = ["."],
    deps = [
        ":adopt_metadata",
        ":bootstrap_inventory",
        ":cloud_api",
        ":fresh_collisions",
        ":private_input",
        ":state_imports",
        "//infra/scripts:bootstrap_state",
        "//infra/scripts:infra_state",
        "//tools/cloud-config:generate",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + ["//tools/cloud-bootstrap/tests:python_sources"],
)

test_suite(
    name = "check",
    tests = ["//tools/cloud-bootstrap/tests:check"],
)

source_audit_files(deps = ["//tools/cloud-bootstrap/tests:source_audit_files"])
