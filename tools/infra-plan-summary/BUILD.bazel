load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/python:tests.bzl", "unittest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "summary",
    srcs = ["summary.py"],
    imports = ["."],
)

py_library(
    name = "test_summary",
    srcs = ["test_summary.py"],
    imports = ["."],
    deps = [":summary"],
)

unittest_test(
    name = "test_summary_test",
    srcs = ["test_summary.py"],
    data = [
        ":python_sources",
        "//tools:repository_test_data",
    ],
    imports = ["."],
    modules = ["test_summary"],
    deps = [":summary"],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
            "tests/*.py",
        ],
        allow_empty = True,
    ),
)

test_suite(
    name = "check",
    tests = [":test_summary_test"],
)

source_audit_files()
