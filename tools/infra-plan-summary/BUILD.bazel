load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "summary",
    srcs = ["summary.py"],
    imports = ["."],
)

py_library(
    name = "test_summary",
    srcs = ["test_summary.py"],
    imports = ["."],
    deps = ["//tools/infra-plan-summary:summary"],
)

py_test(
    name = "test_summary_test",
    srcs = [
        "test_summary.py",
        "//tools/bazel/python:unittest_main.py",
    ],
    args = ["test_summary"],
    data = [
        ":python_sources",
        "//tools:repository_test_data",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "//tools/bazel/python:unittest_main.py",
    deps = ["//tools/infra-plan-summary:summary"],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
            "tests/*.py",
        ],
        allow_empty = True,
    ),
)

test_suite(
    name = "check",
    tests = [":test_summary_test"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
