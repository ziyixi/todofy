load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "worker-secrets",
    srcs = [
        "worker-secrets.json",
        "worker-secrets.mjs",
    ],
)

js_library(
    name = "worker-deploy",
    srcs = ["worker-deploy.mjs"],
    deps = [":worker-secrets"],
)

py_library(
    name = "cloud_profile",
    srcs = ["cloud_profile.py"],
    imports = ["."],
)

py_library(
    name = "generate",
    srcs = ["generate.py"],
    imports = ["."],
    deps = [
        ":cloud_profile",
        "//tools/service-catalog:catalog",
    ],
)

py_library(
    name = "outputs",
    srcs = ["outputs.py"],
    imports = ["."],
    deps = [":cloud_profile"],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        [
            "*.py",
            "*.sh",
            "*.mjs",
            "*.json",
        ],
        allow_empty = True,
    ) + ["//tools/cloud-config/tests:python_sources"],
)

test_suite(
    name = "check",
    tests = ["//tools/cloud-config/tests:check"],
)

source_audit_files(deps = ["//tools/cloud-config/tests:source_audit_files"])
