load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "release_probes",
    srcs = glob(["deploy-probes/*.sh"]),
)

filegroup(
    name = "repository_test_sources",
    srcs = [
        "//tools/cloud-release:python_sources",
        "//tools/vps-bootstrap:python_sources",
        "//tools/vps-release:python_sources",
    ],
)

test_suite(
    name = "check",
    tests = [
        "//tools/cloud-bootstrap:check",
        "//tools/cloud-config:check",
        "//tools/cloud-release:check",
        "//tools/container-release:build_identity_test",
        "//tools/infra-plan-summary:check",
        "//tools/service-catalog:check",
        "//tools/vps-bootstrap:check",
        "//tools/vps-release:check",
    ],
)

filegroup(
    name = "repository_test_data",
    srcs = [
        "//:python_repository_test_data",
        "//codex-gateway:config",
        "//dashboard:config",
        "//dashboard/worker/src:catalog_inputs",
        "//fleet:config",
        "//infra:config",
        "//links:config",
        "//mail-hero:config",
        "//mailsort:config",
        "//model-router:config",
        "//newsletter:config",
        "//newsletter:python_sources",
        "//newsletter-console:config",
        "//personal-mcp:config",
        "//platform:static_deployment_inputs",
        "//recall:config",
        "//storage:config",
        "//tasks:config",
        "//todofy:config",
        "//watch:config",
        "//website:config",
        "//website/content:site.config.ts",
        "//website/relay/deploy:retire-secrets.py",
    ],
)

source_audit_files(
    patterns = [
        "*",
        "deploy-probes/**",
    ],
    deps = [
        "//tools/bazel:source_audit_files",
        "//tools/bazel/audit:source_audit_files",
        "//tools/bazel/browser:source_audit_files",
        "//tools/bazel/ci:source_audit_files",
        "//tools/bazel/images:source_audit_files",
        "//tools/bazel/lint:source_audit_files",
        "//tools/bazel/python:source_audit_files",
        "//tools/bundle-size:source_audit_files",
        "//tools/cf-guard:source_audit_files",
        "//tools/cloud-bootstrap:source_audit_files",
        "//tools/cloud-config:source_audit_files",
        "//tools/cloud-release:source_audit_files",
        "//tools/container-release:source_audit_files",
        "//tools/infra-plan-summary:source_audit_files",
        "//tools/platform-build:source_audit_files",
        "//tools/service-catalog:source_audit_files",
        "//tools/vps-bootstrap:source_audit_files",
        "//tools/vps-release:source_audit_files",
        "//tools/workerd-cpu:source_audit_files",
    ],
