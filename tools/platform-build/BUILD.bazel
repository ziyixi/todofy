load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "smoke_systemd",
    srcs = ["smoke_systemd.py"],
    imports = ["."],
    deps = [
        "//platform:observer",
        "//platform:observer_systemd_snapshot",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "tests/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
