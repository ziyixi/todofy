{
  "name": "fleet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal Fleet owner status UI",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "typecheck": "bazel test //fleet/web:typecheck_tests",
    "lint": "bazel test //fleet/web:lint",
    "test": "bazel test //fleet/web:unit_tests",
    "build": "bazel build //fleet/web:bundle",
    "check": "bazel test //fleet:check"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@ziyixi/proto": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
