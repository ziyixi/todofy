proto_vitest_test(
    name = "report_test",
    data = [
        "package.json",
        ":node_modules/vitest",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["test/report.test.ts"],
    deps = [
        ":health",
        ":report",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
    ],
)

ts_project(
    name = "types",
    srcs = [
        "src/env.ts",
        "src/health.ts",
        "src/http.ts",
        "src/index.ts",
        "src/metrics.ts",
        "src/newsletter-config.ts",
        "src/ops.ts",
        "src/receipt.ts",
        "src/report.ts",
        "src/runtime.ts",
        "src/state.ts",
        "test/cloudflare-workers.ts",
        "test/codex-gateway.test.ts",
        "test/deploy.test.ts",
        "test/metrics.test.ts",
        "test/newsletter-config.test.ts",
        "test/report.test.ts",
        "vitest.config.ts",
        "vitest.runtime.config.ts",
    ],
    data = [
        "vitest.config.ts",
        "vitest.runtime.config.ts",
    ],
    no_emit = True,
    resolve_json_module = True,
    deps = [
        ":edge_auth_types_link",
        ":lib",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/vitest",
        ":proto_types_link",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//contracts:fleet-report-v1/fixtures/node_metrics.json_data",
        "//fleet/deploy:vars",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

ts_project(
    name = "web_declarations",
    srcs = ["src/newsletter-config.ts"],
    declaration = True,
    emit_declaration_only = True,
    extends = "tsconfig.json",
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": False},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":node_modules/@cloudflare/workers-types",
        ":proto_types_link",
    ],
)

js_library(
    name = "newsletter_config_web",
    srcs = ["src/newsletter-config.ts"],
    deps = [":web_declarations"],
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = glob([
        "src/**",
        "package.json",
        "tsconfig.json",
    ]),
)

test_suite(name = "check")

js_library(
    name = "runtime_helpers",
    srcs = [
        "test/runtime/harness.ts",
        "test/runtime/tsconfig.json",
    ],
    types = glob(
        ["test/runtime/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
)

workerd_vitest_test(
    name = "runtime_metrics_test",
    data = [
        ":test_support",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//contracts:fleet-report-v1/fixtures/node_metrics.json_data",
    ],
    runner = vitest.vitest_test,
    tests = ["test/runtime/metrics.test.ts"],
)

workerd_vitest_test(
    name = "runtime_receipt_test",
    data = [
        ":test_support",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
    ],
    runner = vitest.vitest_test,
    tests = ["test/runtime/receipt.test.ts"],
)

eslint_test(
    name = "lint",
    data = [
        "package.json",
        "test/runtime/tsconfig.json",
        "tsconfig.json",
        ":edge_auth_types_link",
        ":lib",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/miniflare",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":proto_types_link",
        ":runtime_helpers",
        "//:node_modules/@cloudflare/workers-types",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//contracts:fleet-report-v1/fixtures/node_metrics.json_data",
        "//fleet/deploy:vars",
        "//tools/workerd-cpu:types",
    ],
    runner = eslint.eslint_test,
    sources = glob([
        "src/**/*.ts",
        "test/**/*.ts",
        "*.js",
        "*.ts",
    ]),
)

ts_config(
    name = "worker_config",
    src = "tsconfig.json",
)

ts_config(
    name = "runtime_config",
    src = "test/runtime/tsconfig.json",
    deps = [":worker_config"],
)

ts_project(
    name = "runtime_types",
    srcs = [":proto_types_package_wire_types"] + glob(["test/runtime/**/*.ts"]),
    extends = ":runtime_config",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":edge_auth_types_link",
        ":lib",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":proto_types_link",
        ":test_support",
        "//:node_modules/@cloudflare/workers-types",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//contracts:fleet-report-v1/fixtures/node_metrics.json_data",
    ],
)

js_library(
    name = "test_support",
    srcs = glob(
        ["test/**"],
        exclude = [
            "test/runtime/**",
            "test/smoke/**",
            "**/*.test.ts",
        ],
    ),
    types = glob(
        ["test/**/*.ts"],
        exclude = [
            "test/runtime/**",
            "test/smoke/**",
            "**/*.test.ts",
        ],
    ),
)

js_library(
    name = "package_metadata",
    srcs = ["package.json"],
)

js_library(
    name = "entry_metadata",
    srcs = ["src/index.ts"],
)

js_library(
    name = "runtime_metadata",
    srcs = ["test/runtime/harness.ts"],
)

js_library(
    name = "env_metadata",
    srcs = ["src/env.ts"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "src/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
)

test_suite(
    name = "typecheck_tests",
    tests = [
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
    ],
)

test_suite(
    name = "runtime_tests",
    tests = [":runtime_" + file.removeprefix("test/runtime/").removesuffix(".test.ts") + "_test" for file in glob(["test/runtime/*.test.ts"])],
)
