load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//fleet/worker:eslint/package_json.bzl", eslint = "bin")
load("@npm//fleet/worker:vitest/package_json.bzl", vitest = "bin")
load("@npm//fleet/worker:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "proto_vitest_test", "workerd_vitest_test", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//fleet:__subpackages__"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "metrics",
    srcs = ["src/metrics.ts"],
    types = ["src/metrics.ts"],
    deps = ["//proto/fleet/telemetry/v1:ts"],
)

js_library(
    name = "runtime",
    srcs = ["src/runtime.ts"],
    types = ["src/runtime.ts"],
    deps = [
        "//proto/fleet/telemetry/v1:ts",
        "//proto/platform/runtime/v1:ts",
    ],
)

js_library(
    name = "report",
    srcs = ["src/report.ts"],
    types = ["src/report.ts"],
    deps = [
        ":metrics",
        ":runtime",
        "//proto/fleet/telemetry/v1:ts",
        "//proto/ts:wire-json",
    ],
)

js_library(
    name = "newsletter-config",
    srcs = ["src/newsletter-config.ts"],
    types = ["src/newsletter-config.ts"],
    deps = ["//proto/fleet/telemetry/v1:ts"],
)

js_library(
    name = "health",
    srcs = ["src/health.ts"],
    types = ["src/health.ts"],
    deps = [
        ":newsletter-config",
        ":report",
        ":runtime",
        "//proto/ops/v1:ts",
    ],
)

js_library(
    name = "module_group_5",
    srcs = [
        "src/env.ts",
        "src/state.ts",
    ],
    types = [
        "src/env.ts",
        "src/state.ts",
    ],
    deps = [
        ":health",
        ":metrics",
        ":report",
        "//proto/fleet/ui/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/ts:wire-json",
    ],
)

alias(
    name = "env",
    actual = ":module_group_5",
)

alias(
    name = "state",
    actual = ":module_group_5",
)

js_library(
    name = "receipt",
    srcs = ["src/receipt.ts"],
    types = ["src/receipt.ts"],
    deps = [
        ":module_group_5",
        ":report",
    ],
)

js_library(
    name = "http",
    srcs = ["src/http.ts"],
    types = ["src/http.ts"],
    deps = [
        ":metrics",
        ":module_group_5",
        ":receipt",
        ":report",
        "//packages/edge-auth:lib",
        "//proto/fleet/ui/v1:ts",
        "//proto/ts:http-transcoder",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
    ],
)

js_library(
    name = "ops",
    srcs = ["src/ops.ts"],
    types = ["src/ops.ts"],
    deps = [
        ":module_group_5",
        "//proto/ops/v1:ts",
    ],
)

js_library(
    name = "index",
    srcs = ["src/index.ts"],
    types = ["src/index.ts"],
    deps = [
        ":http",
        ":module_group_5",
        ":ops",
    ],
)

js_library(
    name = "lib",
    deps = [
        ":health",
        ":http",
        ":index",
        ":metrics",
        ":module_group_5",
        ":newsletter-config",
        ":ops",
        ":receipt",
        ":report",
        ":runtime",
    ],
)

proto_package(
    name = "proto_types_package",
    deps = [
        ":lib",
        "//proto/fleet/telemetry/v1:ts",
        "//proto/fleet/ui/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/platform/runtime/v1:ts",
        "//proto/ts:http-transcoder",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
    ],
)

workspace_package_link(
    name = "proto_types_link",
    src = ":proto_types_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_types_link",
    src = "//packages/edge-auth:pkg",
)

proto_vitest_test(
    name = "codex-gateway_test",
    data = [
        "package.json",
        ":node_modules/vitest",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["test/codex-gateway.test.ts"],
    deps = [
        ":health",
        ":report",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
    ],
)

proto_vitest_test(
    name = "deploy_test",
    data = [
        "package.json",
        ":node_modules/vitest",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["test/deploy.test.ts"],
    deps = ["//fleet/deploy:vars"],
)

