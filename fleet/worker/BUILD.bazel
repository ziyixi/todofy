    name = "metrics_test",
    data = [
        "package.json",
        ":node_modules/vitest",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["test/metrics.test.ts"],
    deps = [
        ":metrics",
        ":report",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//contracts:fleet-report-v1/fixtures/node_metrics.json_data",
        "//proto/fleet/telemetry/v1:ts",
    ],
)

proto_vitest_test(
    name = "newsletter-config_test",
    data = [
        "package.json",
        ":node_modules/vitest",
    ],
    runner = vitest.vitest_test,
    tags = ["unit"],
    tests = ["test/newsletter-config.test.ts"],
    deps = [
        ":health",
        ":report",
        "//contracts:fleet-report-v1/fixtures/healthy.json_data",
        "//proto/fleet/telemetry/v1:ts",
    ],
