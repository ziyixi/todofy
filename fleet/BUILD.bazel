load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":fleet",
        "//.github/actions:release-fleet/action.yml",
        "//fleet/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://fleet:fleet",
        "release:worker:fleet",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//fleet/deploy:check",
        "//fleet/web:check",
        "//fleet/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "fleet",
    srcs = [
        ":config",
        "//fleet/web:bundle",
        "//fleet/worker:application_sources",
        "//fleet/worker:edge_auth_types_link",
        "//fleet/worker:proto_types_link",
        "//fleet/worker/src:lib",
    ],
    bundle_visibility = ["//fleet:__subpackages__"],
    tool = "//fleet/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//fleet/web:bundle",
)

source_audit_files(patterns = [
    "*",
    "observer/**",
])
