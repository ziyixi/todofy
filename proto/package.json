{
  "name": "@ziyixi/proto-toolchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The pinned protobuf toolchain of this repository (buf, protoc-gen-es, the protobuf-es runtime) and the checks of the proto/ module. Apps consume ./ts (TypeScript) and ./python (Python), never this package.",
  "scripts": {
    "ensure": "node tools/ensure.mjs",
    "lint": "bazel test //proto:format_test //proto:lint_test",
    "api-lint": "bazel test //proto:api_lint_test //proto/tools/api-linter/googleapis:googleapis_test",
    "breaking": "bazel run //proto:breaking --",
    "typecheck": "bazel build //proto:typecheck",
    "test": "bazel test //proto:check",
    "test:python": "bazel test //proto/test/python:tests",
    "check:deterministic": "bazel test //proto:determinism_test",
    "schema": "bazel run //proto:write_schemas",
    "check:schema": "bazel test //proto:schema_test",
    "selftest": "bazel test //proto:rules_selftest"
  },
  "dependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "js-yaml": "catalog:"
  }
}
