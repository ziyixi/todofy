{
  "name": "@ziyixi/proto-toolchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The pinned protobuf toolchain of this repository (buf, protoc-gen-es, the protobuf-es runtime) and the checks of the proto/ module. Apps consume ./ts (TypeScript) and ./python (Python), never this package.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "generate": "node tools/ensure.mjs --force",
    "ensure": "node tools/ensure.mjs",
    "lint": "buf format --diff --exit-code && buf lint",
    "api-lint": "sh scripts/api-lint.sh",
    "breaking": "sh scripts/breaking.sh",
    "typecheck": "node tools/ensure.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node tools/ensure.mjs && vitest run && npm run test:python",
    "test:python": "node tools/ensure.mjs && uv run --no-project --python 3.14 python -m unittest discover -s test/python -t test/python",
    "check:deterministic": "node tools/ensure.mjs --check-deterministic",
    "schema": "buf build --exclude-imports --exclude-source-info -o -#format=json | python3 tools/gen_schema.py",
    "check:schema": "buf build --exclude-imports --exclude-source-info -o -#format=json | python3 tools/gen_schema.py --check",
    "selftest": "sh scripts/rules-selftest.sh"
  },
  "dependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
