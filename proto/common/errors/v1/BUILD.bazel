load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["errors.proto"],
    strip_import_prefix = "/proto",
    deps = [],
)

alias(
    name = "ts",
    actual = "//proto/ts:common_errors_v1_ts",
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:common_errors_v1_py",
)

exports_files(["errors.proto"])

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
