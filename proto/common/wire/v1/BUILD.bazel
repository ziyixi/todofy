load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["wire.proto"],
    strip_import_prefix = "/proto",
    deps = ["@protobuf//:descriptor_proto"],
)

alias(
    name = "ts",
    actual = "//proto/ts:common_wire_v1_ts",
)

exports_files(["wire.proto"])

source_audit_files()
