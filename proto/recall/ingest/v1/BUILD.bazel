load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["diagnostic.proto", "ingest.proto"],
    strip_import_prefix = "/proto",
    deps = ["//proto/common/wire/v1:proto", "@googleapis//:google_api_field_behavior_proto", "@protobuf//:timestamp_proto"],
)

alias(name = "ts", actual = "//proto/ts:recall_ingest_v1_ts")

exports_files(['diagnostic.proto', 'ingest.proto'])
