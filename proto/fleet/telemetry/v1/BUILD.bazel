load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["host_report.proto"],
    strip_import_prefix = "/proto",
    deps = ["//proto/common/wire/v1:proto", "//proto/platform/runtime/v1:proto", "@googleapis//:google_api_field_behavior_proto", "@protobuf//:timestamp_proto"],
)

alias(name = "ts", actual = "//proto/ts:fleet_telemetry_v1_ts")
alias(name = "python", actual = "//proto/python/src/ziyixi_proto:fleet_telemetry_v1_py")

exports_files(['host_report.proto'])
