load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["report.proto"],
    strip_import_prefix = "/proto",
    deps = [
        "//proto/common/wire/v1:proto",
        "@googleapis//:google_api_field_behavior_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:todofy_report_v1_ts",
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:todofy_report_v1_py",
)

exports_files(["report.proto"])

source_audit_files()
