    strip_import_prefix = "/proto",
    deps = ["@googleapis//:google_api_annotations_proto", "@googleapis//:google_api_client_proto", "@googleapis//:google_api_field_behavior_proto", "@googleapis//:google_api_resource_proto", "@protobuf//:timestamp_proto"],
