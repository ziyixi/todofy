load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["mail_service.proto"],
    strip_import_prefix = "/proto",
    deps = [
        "@googleapis//:google_api_annotations_proto",
        "@googleapis//:google_api_client_proto",
        "@googleapis//:google_api_field_behavior_proto",
        "@googleapis//:google_api_resource_proto",
        "@protobuf//:timestamp_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:todofy_mail_v1_ts",
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:todofy_mail_v1_py",
)

exports_files(["mail_service.proto"])

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
