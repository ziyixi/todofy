load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = [
        "errors.proto",
        "history.proto",
        "mail_event.proto",
        "reports.proto",
        "status.proto",
        "todofy_ui_service.proto",
    ],
    strip_import_prefix = "/proto",
    deps = [
        "//proto/modelrouter/inference/v1:proto",
        "//proto/todofy/report/v1:proto",
        "@googleapis//:google_api_annotations_proto",
        "@googleapis//:google_api_client_proto",
        "@googleapis//:google_api_field_behavior_proto",
        "@googleapis//:google_api_field_info_proto",
        "@googleapis//:google_api_resource_proto",
        "@protobuf//:field_mask_proto",
        "@protobuf//:timestamp_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:todofy_ui_v1_ts",
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:todofy_ui_v1_py",
)

exports_files([
    "errors.proto",
    "history.proto",
    "mail_event.proto",
    "reports.proto",
    "status.proto",
    "todofy_ui_service.proto",
])

source_audit_files()
