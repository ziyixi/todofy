load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "materialize_js",
    srcs = ["ensure.mjs"],
)

filegroup(
    name = "generation_inputs",
    srcs = [
        "BUILD.bazel",
        "bazel_codegen.py",
        "bazel_image.py",
        "ensure.mjs",
        "gen_py.py",
        "gen_wire_ts.py",
        "materialize.py",
        "wire_rules.py",
    ],
)

py_binary(
    name = "materialize",
    srcs = ["materialize.py"],
    legacy_create_init = False,
)

py_test(
    name = "bazel_inputs_test",
    srcs = [
        "bazel_codegen.py",
        "test_bazel_inputs.py",
    ],
    data = ["//proto:buf.gen.yaml"],
    imports = ["."],
    legacy_create_init = False,
    main = "test_bazel_inputs.py",
    deps = ["@python_deps//pyyaml"],
)

exports_files([
    "schema_golden.py",
    "bazel_checks.py",
    "bazel_breaking.py",
    "write_schemas.py",
    "bazel_selftest.py",
    "determinism_test.py",
    "bazel_codegen.py",
])

py_library(
    name = "breaking_rules",
    srcs = [
        "profile_breaking.py",
        "retired.py",
    ],
    data = ["//proto:reviewed-rules.json"],
    imports = ["."],
    deps = [":wire_rules"],
)

py_binary(
    name = "bazel_image",
    srcs = ["bazel_image.py"],
    legacy_create_init = False,
)

py_library(
    name = "generators",
    deps = [
        ":python_generator",
        ":schema_generator",
        ":ts_generator",
    ],
)

py_library(
    name = "wire_rules",
    srcs = ["wire_rules.py"],
    imports = ["."],
)

[
    py_library(
        name = language + "_generator",
        srcs = [source],
        imports = ["."],
        deps = [":wire_rules"],
    )
    for language, source in [
        ("ts", "gen_wire_ts.py"),
        ("python", "gen_py.py"),
        ("schema", "gen_schema.py"),
    ]
]

[
    py_binary(
        name = "bazel_" + language + "_codegen",
        srcs = ["bazel_codegen.py"],
        legacy_create_init = False,
        main = "bazel_codegen.py",
        deps = [":" + language + "_generator"] + (["@python_deps//pyyaml"] if language == "ts" else []),
    )
    for language in [
        "ts",
        "python",
        "schema",
    ]
]

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

py_test(
    name = "generated_identity_test",
    srcs = ["generated_identity_test.py"],
    args = [
        "$(locations //proto/ts:todofy_ui_v1_ts_generate)",
        "$(locations //proto/ts:modelrouter_inference_v1_ts_generate)",
        "$(locations //proto/python/src/ziyixi_proto:todofy_ui_v1_py_generate)",
        "$(locations //proto/python/src/ziyixi_proto:modelrouter_inference_v1_py_generate)",
    ],
    data = [
        "//proto/python/src/ziyixi_proto:modelrouter_inference_v1_py_generate",
        "//proto/python/src/ziyixi_proto:todofy_ui_v1_py_generate",
        "//proto/ts:modelrouter_inference_v1_ts_generate",
        "//proto/ts:todofy_ui_v1_ts_generate",
    ],
    legacy_create_init = False,
    main = "generated_identity_test.py",
)

py_test(
    name = "materialization_test",
    srcs = ["test_materialization.py"],
    legacy_create_init = False,
    main = "test_materialization.py",
    deps = ["//proto/python:build_backend"],
)

py_test(
    name = "materialization_inputs_test",
    srcs = ["materialization_inputs_test.py"],
    args = [
        "--manifest",
        "$(location //proto:materialized)/manifest.json",
        "--project",
        "$(location //proto/python:pyproject.toml)",
    ],
    data = [
        "//proto:materialized",
        "//proto/python:pyproject.toml",
    ],
    legacy_create_init = False,
    main = "materialization_inputs_test.py",
)
