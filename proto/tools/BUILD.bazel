        "--google-rpc-image",
        "$(location //proto:google_rpc_image)",
        "--materialized",
        "$(location //proto:materialized)",
    ],
    data = [
        "//proto:buf.gen.yaml",
        "//proto:google_rpc_image",
        "//proto:image",
        "//proto:materialized",
        "//tools/bazel:buf",
        "//tools/bazel:protoc-gen-es",
    ],
    legacy_create_init = False,
    main = "//proto/tools:determinism_test.py",
    deps = [
        "//proto/tools:generators",
        "@python_deps//pyyaml",
    ],
)
