load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//proto/bazel:packages.bzl", "PROTO_SOURCES")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "materialize_js",
    srcs = ["ensure.mjs"],
)

filegroup(
    name = "generation_inputs",
    srcs = [
        "BUILD.bazel",
        "bazel_codegen.py",
        "bazel_image.py",
        "ensure.mjs",
        "gen_py.py",
        "gen_wire_ts.py",
        "materialize.py",
        "wire_rules.py",
    ],
)

py_binary(
    name = "materialize",
    srcs = ["materialize.py"],
    legacy_create_init = False,
)

py_test(
    name = "bazel_inputs_test",
    srcs = [
        "bazel_codegen.py",
        "test_bazel_inputs.py",
    ],
    data = ["//proto:buf.gen.yaml"],
    imports = ["."],
    legacy_create_init = False,
    main = "test_bazel_inputs.py",
    deps = [
        ":generators",
        "@python_deps//pyyaml",
    ],
)

exports_files([
    "schema_golden.py",
    "bazel_checks.py",
    "bazel_breaking.py",
    "write_schemas.py",
    "bazel_selftest.py",
    "determinism_test.py",
    "bazel_codegen.py",
])

py_library(
    name = "breaking_rules",
    srcs = [
        "profile_breaking.py",
        "retired.py",
    ],
    data = ["//proto:reviewed-rules.json"],
    imports = ["."],
    deps = [":wire_rules"],
)

py_binary(
    name = "bazel_image",
    srcs = ["bazel_image.py"],
    legacy_create_init = False,
)

py_library(
    name = "generators",
    deps = [
        ":python_generator",
        ":schema_generator",
        ":ts_generator",
    ],
)

py_library(
    name = "wire_rules",
    srcs = ["wire_rules.py"],
    imports = ["."],
)

[py_library(
    name = language + "_generator",
    srcs = [source],
    imports = ["."],
    deps = [":wire_rules"],
) for (language, source) in [
    ("ts", "gen_wire_ts.py"),
    ("python", "gen_py.py"),
    ("schema", "gen_schema.py"),
]]

[py_binary(
    name = "bazel_" + language + "_codegen",
    srcs = ["bazel_codegen.py"],
    legacy_create_init = False,
    main = "bazel_codegen.py",
    deps = [":" + language + "_generator"] + (["@python_deps//pyyaml"] if language == "ts" else []),
) for language in [
    "ts",
    "python",
    "schema",
]]

source_audit_files()

py_test(
    name = "generated_identity_test",
    srcs = ["generated_identity_test.py"],
    args = [
        "$(locations //proto/ts:todofy_ui_v1_ts_generate)",
        "$(locations //proto/ts:modelrouter_inference_v1_ts_generate)",
        "$(locations //proto/python/src/ziyixi_proto:todofy_ui_v1_py_generate)",
        "$(locations //proto/python/src/ziyixi_proto:modelrouter_inference_v1_py_generate)",
    ],
    data = [
        "//proto/python/src/ziyixi_proto:modelrouter_inference_v1_py_generate",
        "//proto/python/src/ziyixi_proto:todofy_ui_v1_py_generate",
        "//proto/ts:modelrouter_inference_v1_ts_generate",
        "//proto/ts:todofy_ui_v1_ts_generate",
    ],
    legacy_create_init = False,
    main = "generated_identity_test.py",
)

py_test(
    name = "materialization_test",
    srcs = ["test_materialization.py"],
    legacy_create_init = False,
    main = "test_materialization.py",
    deps = ["//proto/python:build_backend"],
)

py_test(
    name = "materialization_inputs_test",
    srcs = ["materialization_inputs_test.py"],
    args = [
        "--manifest",
        "$(location //proto:materialized)/manifest.json",
        "--project",
        "$(location //proto/python:pyproject.toml)",
    ],
    data = [
        "//proto:materialized",
        "//proto/python:pyproject.toml",
    ],
    legacy_create_init = False,
    main = "materialization_inputs_test.py",
)

py_binary(
    name = "breaking",
    srcs = ["//proto/tools:bazel_breaking.py"],
    args = [
        "--buf",
        "$(location //tools/bazel:buf)",
        "--image",
        "$(location //proto:image)",
        "--config",
        "$(location //proto:buf.yaml)",
        "--retired",
        "$(location //proto:retired.json)",
    ],
    data = [
        "//proto:buf.yaml",
        "//proto:image",
        "//proto:retired.json",
        "//tools/bazel:buf",
    ],
    env = {
        "BAZEL_BINDIR": ".",
        "JS_BINARY__NO_CD_BINDIR": "1",
    },
    legacy_create_init = False,
    main = "//proto/tools:bazel_breaking.py",
    deps = ["//proto/tools:breaking_rules"],
)

py_test(
    name = "schema_test",
    srcs = ["//proto/tools:schema_golden.py"],
    args = [
        "--generated",
        "$(locations //proto:schemas)",
        "--expected",
    ] + [
        "$(location //contracts:platform-runtime-v1/platform-runtime-v1.schema.json)",
        "$(location //contracts:fleet-report-v1/fleet-report-v1.schema.json)",
        "$(location //contracts:ops-v1/ops-v1.schema.json)",
        "$(location //contracts:mail-received-v1/mail-received-v1.schema.json)",
        "$(location //contracts:recall-archive-v1/recall-archive-v1.schema.json)",
        "$(location //todofy/api:summary-v1.schema.json)",
        "$(location //todofy/api:recommendation-v1.schema.json)",
    ],
    data = ["//proto:schemas"] + [
        "//contracts:fleet-report-v1/fleet-report-v1.schema.json",
        "//contracts:mail-received-v1/mail-received-v1.schema.json",
        "//contracts:ops-v1/ops-v1.schema.json",
        "//contracts:platform-runtime-v1/platform-runtime-v1.schema.json",
        "//contracts:recall-archive-v1/recall-archive-v1.schema.json",
        "//todofy/api:recommendation-v1.schema.json",
        "//todofy/api:summary-v1.schema.json",
    ],
    legacy_create_init = False,
    main = "//proto/tools:schema_golden.py",
)

py_test(
    name = "lint_test",
    srcs = ["//proto/tools:bazel_checks.py"],
    args = [
        "lint",
        "--buf",
        "$(location //tools/bazel:buf)",
        "--config",
        "$(location //proto:buf.yaml)",
        "--image",
        "$(location //proto:image)",
    ],
    data = [
        "//proto:buf.yaml",
        "//proto:image",
        "//tools/bazel:buf",
    ],
    env = {
        "BAZEL_BINDIR": ".",
        "JS_BINARY__NO_CD_BINDIR": "1",
    },
    legacy_create_init = False,
    main = "//proto/tools:bazel_checks.py",
)

py_test(
    name = "format_test",
    srcs = ["//proto/tools:bazel_checks.py"],
    args = [
        "format",
        "--buf",
        "$(location //tools/bazel:buf)",
        "--config",
        "$(location //proto:buf.yaml)",
    ],
    data = [
        "//proto:buf.yaml",
        "//proto:sources",
        "//tools/bazel:buf",
    ],
    env = {
        "BAZEL_BINDIR": ".",
        "JS_BINARY__NO_CD_BINDIR": "1",
    },
    legacy_create_init = False,
    main = "//proto/tools:bazel_checks.py",
