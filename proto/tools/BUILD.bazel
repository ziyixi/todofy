py_test(
    name = "api_lint_test",
    srcs = ["//proto/tools:bazel_checks.py"],
    args = [
        "api-lint",
        "--buf",
        "$(location //tools/bazel:buf)",
        "--config",
        "$(location //proto:buf.yaml)",
        "--image",
        "$(location //proto:image)",
        "--api-linter",
        "$(location //proto/tools/api-linter:api-linter)",
        "--googleapis-check",
        "$(location //proto/tools/api-linter/googleapis:googleapis-check)",
    ] + [arg for source in PROTO_SOURCES for arg in [
        "--source",
        source,
    ]],
    data = [
        "//proto:buf.yaml",
        "//proto:image",
        "//proto/tools/api-linter",
        "//proto/tools/api-linter/googleapis:googleapis-check",
        "//tools/bazel:buf",
    ],
    env = {
        "BAZEL_BINDIR": ".",
        "JS_BINARY__NO_CD_BINDIR": "1",
    },
    legacy_create_init = False,
    main = "//proto/tools:bazel_checks.py",
)

py_binary(
    name = "write_schemas",
    srcs = ["//proto/tools:write_schemas.py"],
    args = ["$(locations //proto:schemas)"],
    data = ["//proto:schemas"],
    legacy_create_init = False,
    main = "//proto/tools:write_schemas.py",
    deps = ["//proto/tools:schema_generator"],
)

py_test(
    name = "determinism_test",
    srcs = [
        "//proto/tools:bazel_codegen.py",
        "//proto/tools:determinism_test.py",
    ],
    args = [
        "--buf",
        "$(location //tools/bazel:buf)",
        "--plugin",
        "$(location //tools/bazel:protoc-gen-es)",
        "--config",
        "$(location //proto:buf.gen.yaml)",
        "--image",
