load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = [
        "errors.proto",
        "runtime.proto",
        "runtime_service.proto",
    ],
    strip_import_prefix = "/proto",
    deps = [
        "//proto/common/wire/v1:proto",
        "@googleapis//:google_api_annotations_proto",
        "@googleapis//:google_api_client_proto",
        "@googleapis//:google_api_field_behavior_proto",
        "@googleapis//:google_api_field_info_proto",
        "@googleapis//:google_api_resource_proto",
        "@protobuf//:timestamp_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:platform_runtime_v1_ts",
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:platform_runtime_v1_py",
)

exports_files([
    "errors.proto",
    "runtime.proto",
    "runtime_service.proto",
])

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
