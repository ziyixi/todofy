load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//proto/bazel:codegen.bzl", "proto_codegen", "proto_image", "proto_source_files")
load("//proto/bazel:materialize.bzl", "materialized_proto")
load("//proto/bazel:packages.bzl", "PROTO_LIBRARIES", "PROTO_SOURCES")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "package.json",
        "vitest.config.ts",
    ],
    visibility = ["//proto:__subpackages__"],
)

materialized_proto(
    name = "materialized",
    inputs = [":generation_inputs"],
    python = [
        ":python",
        "//proto/prototest/v1:python",
    ],
    typescript = "//proto/ts:pkg",
)

ts_config(
    name = "compiler_config",
    src = ":tsconfig.json",
)

npm_link_all_packages(name = "node_modules")

proto_source_files(
    name = "all_proto_sources",
    protos = PROTO_LIBRARIES,
)

filegroup(
    name = "generation_inputs",
    srcs = [
        ":BUILD.bazel",
        ":buf.gen.yaml",
        ":buf.lock",
        ":buf.yaml",
        ":package.json",
        ":sources",
        "//:.bazelrc",
        "//:.bazelversion",
        "//:.python-version",
        "//:MODULE.bazel",
        "//:MODULE.bazel.lock",
        "//:package.json",
        "//:pnpm-lock.yaml",
        "//:pnpm-workspace.yaml",
        "//:uv.lock",
        "//proto/bazel:BUILD.bazel",
        "//proto/bazel:codegen.bzl",
        "//proto/bazel:materialize.bzl",
        "//proto/bazel:packages.bzl",
        "//proto/bazel:repositories.bzl",
        "//proto/bazel:ts_package.bzl",
        "//proto/python:source_audit_files",
        "//proto/python/src/ziyixi_proto:source_audit_files",
        "//proto/tools:generation_inputs",
        "//proto/ts:source_audit_files",
        "//tools/bazel:BUILD.bazel",
    ] + [label.removesuffix(":proto") + ":BUILD.bazel" for label in PROTO_LIBRARIES],
)

alias(
    name = "python",
    actual = "//proto/python/src/ziyixi_proto:all_python",
)

alias(
    name = "python_runtime",
    actual = "//proto/python/src/ziyixi_proto:runtime",
)

alias(
    name = "ts",
    actual = "//proto/ts:all_ts",
)

py_package(
    name = "python_wheel_files",
    packages = ["proto.python.src.ziyixi_proto"],
    tags = ["manual"],
    deps = [":python"],
)

py_wheel(
    name = "python_wheel",
    distribution = "ziyixi-proto",
    python_requires = ">=3.14",
    stamp = 0,
    strip_path_prefixes = ["proto/python/src"],
    tags = ["manual"],
    version = "0.0.0",
    deps = [":python_wheel_files"],
)

proto_codegen(
    name = "fleet_telemetry_v1_schema",
    outs = ["schema/fleet-report-v1.schema.json"],
    format = "schema",
    output_paths = {"schema/fleet-report-v1.schema.json": "../contracts/fleet-report-v1/fleet-report-v1.schema.json"},
    proto_package = "fleet.telemetry.v1",
    protos = ["//proto/fleet/telemetry/v1:proto"],
    sources = ["fleet/telemetry/v1/host_report.proto"],
)

proto_codegen(
    name = "mailhero_webhook_v1_schema",
    outs = ["schema/mail-received-v1.schema.json"],
    format = "schema",
    output_paths = {"schema/mail-received-v1.schema.json": "../contracts/mail-received-v1/mail-received-v1.schema.json"},
    proto_package = "mailhero.webhook.v1",
    protos = ["//proto/mailhero/webhook/v1:proto"],
    sources = ["mailhero/webhook/v1/mail_received.proto"],
)

proto_codegen(
    name = "ops_v1_schema",
    outs = ["schema/ops-v1.schema.json"],
    format = "schema",
    output_paths = {"schema/ops-v1.schema.json": "../contracts/ops-v1/ops-v1.schema.json"},
    proto_package = "ops.v1",
    protos = ["//proto/ops/v1:proto"],
    sources = ["ops/v1/ops.proto"],
)

proto_codegen(
    name = "platform_runtime_v1_schema",
    outs = ["schema/platform-runtime-v1.schema.json"],
    format = "schema",
    output_paths = {"schema/platform-runtime-v1.schema.json": "../contracts/platform-runtime-v1/platform-runtime-v1.schema.json"},
    proto_package = "platform.runtime.v1",
    protos = ["//proto/platform/runtime/v1:proto"],
    sources = [
        "platform/runtime/v1/runtime.proto",
        "platform/runtime/v1/errors.proto",
        "platform/runtime/v1/runtime_service.proto",
    ],
)

proto_codegen(
    name = "recall_archive_v1_schema",
    outs = ["schema/recall-archive-v1.schema.json"],
    format = "schema",
    output_paths = {"schema/recall-archive-v1.schema.json": "../contracts/recall-archive-v1/recall-archive-v1.schema.json"},
    proto_package = "recall.archive.v1",
    protos = ["//proto/recall/archive/v1:proto"],
    sources = ["recall/archive/v1/archive.proto"],
)

proto_codegen(
    name = "todofy_report_v1_schema",
    outs = [
        "schema/recommendation-v1.schema.json",
        "schema/summary-v1.schema.json",
    ],
    format = "schema",
    output_paths = {
        "schema/recommendation-v1.schema.json": "../todofy/api/recommendation-v1.schema.json",
        "schema/summary-v1.schema.json": "../todofy/api/summary-v1.schema.json",
    },
    proto_package = "todofy.report.v1",
    protos = ["//proto/todofy/report/v1:proto"],
    sources = ["todofy/report/v1/report.proto"],
)

filegroup(
    name = "schemas",
    srcs = [
        ":fleet_telemetry_v1_schema",
        ":mailhero_webhook_v1_schema",
        ":ops_v1_schema",
        ":platform_runtime_v1_schema",
        ":recall_archive_v1_schema",
        ":todofy_report_v1_schema",
    ],
)

exports_files([
    "buf.yaml",
    "buf.gen.yaml",
    "buf.lock",
    "retired.json",
    "reviewed-rules.json",
    "tsconfig.json",
])

filegroup(
    name = "sources",
    srcs = ["//proto/" + source.rsplit("/", 1)[0] + ":" + source.rsplit("/", 1)[1] for source in PROTO_SOURCES],
)

proto_image(
    name = "image",
    out = "image.binpb",
    protos = PROTO_LIBRARIES,
    sources = PROTO_SOURCES,
)

proto_image(
    name = "google_rpc_image",
    out = "google-rpc-image.json",
    protos = [
        "@googleapis//:google_rpc_code_proto",
        "@googleapis//:google_rpc_error_details_proto",
        "@googleapis//:google_rpc_status_proto",
    ],
    sources = [],
)

test_suite(
    name = "tests",
    tests = [
        ":ts_project_typecheck_test",
        "//proto/scripts:rules_selftest",
        "//proto/test:tests",
        "//proto/test/python:tests",
        "//proto/tools:api_lint_test",
        "//proto/tools:bazel_inputs_test",
        "//proto/tools:determinism_test",
        "//proto/tools:format_test",
        "//proto/tools:generated_identity_test",
        "//proto/tools:lint_test",
        "//proto/tools:materialization_inputs_test",
        "//proto/tools:materialization_test",
        "//proto/tools:schema_test",
        "//proto/tools/api-linter/googleapis:googleapis_test",
        "//proto/ts:recall_ingest_v1_types_typecheck_test",
    ],
)

test_suite(
    name = "check",
    tests = [":tests"],
)

alias(
    name = "breaking",
    actual = "//proto/tools:breaking",
)

alias(
    name = "write_schemas",
    actual = "//proto/tools:write_schemas",
)

alias(
    name = "typecheck",
    actual = ":ts_project_typecheck",
)

source_audit_files(deps = [
    "//proto/scripts:source_audit_files",
    "//proto/test:source_audit_files",
])

js_library(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
)

test_suite(
    name = "format_test",
    tests = ["//proto/tools:format_test"],
)

test_suite(
    name = "lint_test",
    tests = ["//proto/tools:lint_test"],
)

test_suite(
    name = "api_lint_test",
    tests = ["//proto/tools:api_lint_test"],
)

test_suite(
    name = "determinism_test",
    tests = ["//proto/tools:determinism_test"],
)

test_suite(
    name = "schema_test",
    tests = ["//proto/tools:schema_test"],
)

test_suite(
    name = "rules_selftest",
    tests = ["//proto/scripts:rules_selftest"],
)

ts_project(
    name = "ts_project",
    srcs = [
        ":vitest_config",
        "//proto/test:typecheck_sources",
    ],
    no_emit = True,
    tsconfig = "//proto:compiler_config",
    deps = [
        "//proto:node_modules/@bufbuild/protobuf",
        "//proto:node_modules/@cloudflare/workers-types",
        "//proto:node_modules/@types/node",
        "//proto:node_modules/vitest",
        "//proto/ts:all_ts",
    ],
)
