py_binary(
    name = "breaking",
    srcs = ["//proto/tools:bazel_breaking.py"],
    args = [
        "--buf",
        "$(location //tools/bazel:buf)",
        "--image",
        "$(location :image)",
        "--config",
        "$(location :buf.yaml)",
        "--retired",
        "$(location :retired.json)",
    ],
    data = [
        ":buf.yaml",
        ":image",
        ":retired.json",
        "//tools/bazel:buf",
    ],
    env = {
        "BAZEL_BINDIR": ".",
        "JS_BINARY__NO_CD_BINDIR": "1",
    },
    legacy_create_init = False,
    main = "//proto/tools:bazel_breaking.py",
    deps = ["//proto/tools:breaking_rules"],
)

