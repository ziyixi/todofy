load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = [
        "backup.proto",
        "consolidation.proto",
        "errors.proto",
        "flow.proto",
        "label.proto",
        "mailsort_ui_service.proto",
        "prompt.proto",
        "replay.proto",
        "review.proto",
        "status.proto",
    ],
    strip_import_prefix = "/proto",
    deps = [
        "//proto/modelrouter/inference/v1:proto",
        "@googleapis//:google_api_annotations_proto",
        "@googleapis//:google_api_client_proto",
        "@googleapis//:google_api_field_behavior_proto",
        "@googleapis//:google_api_field_info_proto",
        "@googleapis//:google_api_resource_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:field_mask_proto",
        "@protobuf//:timestamp_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:mailsort_ui_v2_ts",
)

exports_files([
    "backup.proto",
    "consolidation.proto",
    "errors.proto",
    "flow.proto",
    "label.proto",
    "mailsort_ui_service.proto",
    "prompt.proto",
    "replay.proto",
    "review.proto",
    "status.proto",
])

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
