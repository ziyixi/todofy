load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["mail_received.proto"],
    strip_import_prefix = "/proto",
    deps = ["//proto/common/wire/v1:proto", "@googleapis//:google_api_field_behavior_proto"],
)

alias(name = "ts", actual = "//proto/ts:mailhero_webhook_v1_ts")
alias(name = "python", actual = "//proto/python/src/ziyixi_proto:mailhero_webhook_v1_py")

exports_files(['mail_received.proto'])
