          "b c"
        ],
        "genre": "poetry",
        "genres": [
          "fiction",
          "science"
        ],
        "author": {
          "display_name": "Ada",
          "birth_year": 1815
        },
        "min_rating": 4.5,
        "hardcover": true,
        "subtitle": ""
      },
      "expect": {
        "method": "GET",
        "url": "/v1/shelves/s1/books?page_size=10&page_token=t%26u&tags=a&tags=b%20c&genre=poetry&genres=fiction&genres=science&author.display_name=Ada&author.birth_year=1815&min_rating=4.5&hardcover=true&subtitle=",
