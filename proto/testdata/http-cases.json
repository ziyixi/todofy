      }
    },
    {
      "name": "DELETE takes no body",
      "request": {
        "method": "DELETE",
        "path": "/v1/shelves/s1/books/b1",
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "allow_missing": true
        }
      },
      "expect": {
        "status": 400,
        "reason": "BAD_REQUEST"
      }
    },
    {
      "name": "another method on a known path is 405 with Allow",
      "request": {
        "method": "PUT",
        "path": "/v1/shelves/s1/books/b1"
      },
