        "allow": "GET, HEAD, PATCH, DELETE, OPTIONS"
      }
    },
    {
      "name": "a verb path read with GET is 405",
      "request": {
        "method": "GET",
        "path": "/v1/shelves/s1/books/b1:archive"
      },
      "expect": {
        "status": 405,
        "reason": "METHOD_NOT_ALLOWED",
        "allow": "POST, OPTIONS"
      }
    },
    {
      "name": "HEAD is GET without the body",
      "request": {
        "method": "HEAD",
        "path": "/v1/shelves/s1/books/b1"
      },
