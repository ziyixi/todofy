  "encode": [
    {
      "name": "path and query",
      "rpc": "GetBook",
      "input": {
        "name": "shelves/s1/books/b1",
        "view": "full",
        "include_labels": true
      },
      "expect": {
        "method": "GET",
        "url": "/v1/shelves/s1/books/b1?view=full&include_labels=true",
        "body": null
      }
    },
    {
      "name": "a multi-segment variable keeps its slashes and encodes the rest",
      "rpc": "GetBook",
      "input": {
        "name": "shelves/s 1/books/b:1"
      },
      "expect": {
        "method": "GET",
        "url": "/v1/shelves/s%201/books/b%3A1",
        "body": null
      }
    },
    {
      "name": "non-ASCII is encoded as UTF-8",
      "rpc": "GetBook",
      "input": {
        "name": "shelves/书/books/b"
      },
      "expect": {
        "method": "GET",
        "url": "/v1/shelves/%E4%B9%A6/books/b",
        "body": null
      }
    },
    {
      "name": "a value that does not fit its pattern is refused",
      "rpc": "GetBook",
      "input": {
        "name": "books/b1"
      },
      "expect": {
        "error": true
      }
    },
    {
      "name": "an empty path value is refused",
      "rpc": "GetBook",
      "input": {
        "name": "",
        "view": "full"
      },
      "expect": {
        "error": true
      }
    },
    {
      "name": "a body field, the rest in the query",
      "rpc": "CreateBook",
      "input": {
        "parent": "shelves/s1",
        "book_id": "b9",
        "book": {
          "title": "T"
        }
      },
      "expect": {
        "method": "POST",
        "url": "/v1/shelves/s1/books?book_id=b9",
        "body": {
          "title": "T"
        }
      }
    },
    {
      "name": "a path field leaves the body",
      "rpc": "UpdateBook",
      "input": {
        "book": {
          "name": "shelves/s1/books/b1",
          "title": "New"
        },
        "request_id": "0d8f7a9e-1c2b-4d3e-8f4a-5b6c7d8e9f0a"
      },
      "expect": {
        "method": "PATCH",
        "url": "/v1/shelves/s1/books/b1?request_id=0d8f7a9e-1c2b-4d3e-8f4a-5b6c7d8e9f0a",
        "body": {
          "title": "New"
        }
      }
    },
    {
      "name": "body * with a verb",
      "rpc": "ArchiveBook",
      "input": {
        "name": "shelves/s1/books/b1",
        "force": true,
        "request_id": "0d8f7a9e-1c2b-4d3e-8f4a-5b6c7d8e9f0a"
      },
      "expect": {
        "method": "POST",
        "url": "/v1/shelves/s1/books/b1:archive",
        "body": {
          "force": true,
          "request_id": "0d8f7a9e-1c2b-4d3e-8f4a-5b6c7d8e9f0a"
        }
      }
    },
    {
      "name": "DELETE without a body",
      "rpc": "DeleteBook",
      "input": {
        "name": "shelves/s1/books/b1",
        "allow_missing": true
      },
      "expect": {
        "method": "DELETE",
        "url": "/v1/shelves/s1/books/b1?allow_missing=true",
        "body": null
      }
    },
    {
      "name": "every kind of query parameter, in field-number order",
      "rpc": "ListBooks",
