    {
      "name": "an update with a mask sends the mask in the query and the masked fields in the body",
      "rpc": "UpdateShelf",
      "input": {
        "shelf": {
          "name": "shelves/s1",
          "theme": "T"
        },
        "update_mask": "theme"
