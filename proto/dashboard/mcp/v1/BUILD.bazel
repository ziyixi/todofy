    name = "proto",
    srcs = ["home_service.proto"],
    strip_import_prefix = "/proto",
    deps = ["//proto/common/wire/v1:proto", "//proto/dashboard/ui/v1:proto", "@googleapis//:google_api_field_behavior_proto"],
)

alias(name = "ts", actual = "//proto/ts:dashboard_mcp_v1_ts")

exports_files(['home_service.proto'])
