load("@rules_python//python:defs.bzl", "py_library")
load("//proto/bazel:codegen.bzl", "proto_codegen", "python_namespace")

package(default_visibility = ["//visibility:public"])

python_namespace(
    name = "namespace",
    paths = ["common", "common/errors", "common/errors/v1", "fleet", "fleet/telemetry", "fleet/telemetry/v1", "mailhero", "mailhero/webhook", "mailhero/webhook/v1", "modelrouter", "modelrouter/inference", "modelrouter/inference/v1", "newsletter", "newsletter/ui", "newsletter/ui/v1", "ops", "ops/v1", "platform", "platform/runtime", "platform/runtime/v1", "todofy", "todofy/mail", "todofy/mail/v1", "todofy/report", "todofy/report/v1", "todofy/ui", "todofy/ui/v1"],
