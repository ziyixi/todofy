filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["*"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
