load("@rules_python//python:defs.bzl", "py_library")
load("//proto/bazel:codegen.bzl", "proto_codegen", "python_namespace")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:public"])

python_namespace(
    name = "namespace",
    paths = [
        "common",
        "common/errors",
        "common/errors/v1",
        "fleet",
        "fleet/telemetry",
        "fleet/telemetry/v1",
        "mailhero",
        "mailhero/webhook",
        "mailhero/webhook/v1",
        "modelrouter",
        "modelrouter/inference",
        "modelrouter/inference/v1",
        "newsletter",
        "newsletter/ui",
        "newsletter/ui/v1",
        "ops",
        "ops/v1",
        "platform",
        "platform/runtime",
        "platform/runtime/v1",
        "todofy",
        "todofy/mail",
        "todofy/mail/v1",
        "todofy/report",
        "todofy/report/v1",
        "todofy/ui",
        "todofy/ui/v1",
    ],
)

python_namespace(
    name = "test_namespace",
    paths = [
        "prototest",
        "prototest/v1",
    ],
)

py_library(
    name = "runtime",
    srcs = [
        "__init__.py",
        "http_routes.py",
        "rpc_status.py",
        "wire_json.py",
        ":namespace",
    ],
    imports = [".."],
)

proto_codegen(
    name = "common_errors_v1_py_generate",
    outs = ["common/errors/v1/errors_pb.py"],
    format = "python",
    proto_package = "common.errors.v1",
    protos = ["//proto/common/errors/v1:proto"],
    sources = ["common/errors/v1/errors.proto"],
)

py_library(
    name = "common_errors_v1_py",
    srcs = [":common_errors_v1_py_generate"],
    imports = [".."],
    deps = [":runtime"],
)

proto_codegen(
    name = "fleet_telemetry_v1_py_generate",
    outs = ["fleet/telemetry/v1/host_report_pb.py"],
    format = "python",
    proto_package = "fleet.telemetry.v1",
    protos = ["//proto/fleet/telemetry/v1:proto"],
    sources = ["fleet/telemetry/v1/host_report.proto"],
)

py_library(
    name = "fleet_telemetry_v1_py",
    srcs = [":fleet_telemetry_v1_py_generate"],
    imports = [".."],
    deps = [
        ":platform_runtime_v1_py",
