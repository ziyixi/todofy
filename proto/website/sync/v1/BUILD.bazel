load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "proto",
    srcs = ["sync.proto"],
    strip_import_prefix = "/proto",
    deps = [
        "//proto/common/wire/v1:proto",
        "@googleapis//:google_api_field_behavior_proto",
        "@googleapis//:google_api_field_info_proto",
    ],
)

alias(
    name = "ts",
    actual = "//proto/ts:website_sync_v1_ts",
)

exports_files(["sync.proto"])

source_audit_files()
