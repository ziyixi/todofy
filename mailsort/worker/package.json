{
  "name": "mailsort-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"mailsort\": the owner's Gmail sorting (MailsortState, one SQLite Durable Object that schedules itself with setAlarm) and its owner API (mailsort.ui.v2) behind Access.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //mailsort/worker:typecheck_tests",
    "lint": "bazel test //mailsort/worker:lint",
    "test": "bazel test //mailsort/worker:unit_tests",
    "test:runtime": "bazel test //mailsort/worker:runtime_tests --nocache_test_results",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //mailsort/web:bundle && wrangler dev --assets ../../bazel-bin/mailsort/web/dist --config ../wrangler.test.toml --ip 127.0.0.1 --port 8795 --local-upstream 127.0.0.1:8795",
    "test:smoke": "bazel test //mailsort/worker:smoke_test",
    "check": "bazel test //mailsort:check"
  },
  "dependencies": {
    "@ziyixi/model-router-client": "workspace:*",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
