{
  "name": "mailsort-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"mailsort\": the owner's Gmail sorting (MailsortState, one SQLite Durable Object that schedules itself with setAlarm) and its owner API (mailsort.ui.v2) behind Access.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/runtime/tsconfig.json && tsc --noEmit -p test/smoke/tsconfig.json",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "pretest:runtime": "node ../../proto/tools/ensure.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "wrangler dev --config ../wrangler.test.toml --ip 127.0.0.1 --port 8795 --local-upstream 127.0.0.1:8795",
    "pretest:smoke": "node ../../proto/tools/ensure.mjs",
    "test:smoke": "node test/smoke/smoke.mts"
  },
  "dependencies": {
    "@ziyixi/model-router-client": "workspace:*",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
