load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":mailsort",
        "//.github/actions:release-mailsort/action.yml",
        "//mailsort/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://mailsort:mailsort",
        "release:worker:mailsort",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//mailsort/deploy:check",
        "//mailsort/tools:check",
        "//mailsort/web:check",
        "//mailsort/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "mailsort",
    srcs = [
        ":config",
        "//mailsort/prompts:personal-rules",
        "//mailsort/prompts:priority-classification",
        "//mailsort/web:bundle",
        "//mailsort/worker:application_sources",
        "//mailsort/worker:edge_auth_types_link",
        "//mailsort/worker:model_router_client_types_link",
        "//mailsort/worker:proto_types_link",
        "//mailsort/worker/src:lib",
    ],
    bundle_visibility = ["//mailsort:__subpackages__"],
    tool = "//mailsort/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//mailsort/web:bundle",
)

js_library(
    name = "test_config",
    srcs = ["wrangler.test.toml"],
    visibility = ["//mailsort:__subpackages__"],
)

source_audit_files()
