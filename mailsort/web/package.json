{
  "name": "mailsort-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The UI of the owner's Gmail sorting (Chinese, mobile first, no framework), built into ../web/dist and served by the Worker \"mailsort\".",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "typecheck": "bazel test //mailsort/web:typecheck_tests",
    "lint": "bazel test //mailsort/web:lint",
    "test": "bazel test //mailsort/web:unit_tests",
    "build": "bazel build //mailsort/web:bundle",
    "check:dist": "bazel build //mailsort/web:bundle",
    "check": "bazel test //mailsort:check"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*",
    "d3-sankey": "catalog:",
    "d3-shape": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/d3-sankey": "catalog:",
    "@types/d3-shape": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
