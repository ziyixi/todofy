py_library(
    name = "guard_lib",
    srcs = ["//.github/scripts:infra_guard.py"],
    imports = ["../../.github/scripts"],
)

test_suite(
    name = "check",
    tests = [
        ":test_apply_diagnostics",
        ":test_infra_state",
        ":test_local_tfvars",
        ":test_platform_export",
        ":test_reconcile",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
