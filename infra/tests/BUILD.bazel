unittest_test(
    name = "test_reconcile",
    srcs = ["test_reconcile.py"],
    data = [
        "//infra:python_sources",
        "//infra:variables.tf",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "../scripts",
    ],
    modules = ["test_reconcile"],
    deps = [
        "//infra/scripts:infra_state",
        "//infra/scripts:reconcile_policy",
    ],
