load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")
load("//tools/bazel/python:tests.bzl", "unittest_test")

package(default_visibility = ["//visibility:public"])

unittest_test(
    name = "test_apply_diagnostics",
    srcs = ["test_apply_diagnostics.py"],
    data = [
        "//infra:python_sources",
        "//infra:variables.tf",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "../scripts",
    ],
    modules = ["test_apply_diagnostics"],
    deps = [
        "//infra/scripts:apply_diagnostics",
        "//infra/scripts:infra_state",
    ],
)

unittest_test(
    name = "test_infra_state",
    srcs = ["test_infra_state.py"],
    data = [
        "//infra:python_sources",
        "//infra:variables.tf",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "../scripts",
    ],
    modules = ["test_infra_state"],
    deps = [
        "//infra/scripts:bootstrap_state",
        "//infra/scripts:infra_state",
    ],
)

unittest_test(
    name = "test_local_tfvars",
    srcs = ["test_local_tfvars.py"],
    data = [
        "//infra:python_sources",
        "//infra:variables.tf",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "../scripts",
    ],
    modules = ["test_local_tfvars"],
    deps = [],
)

unittest_test(
    name = "test_platform_export",
    srcs = ["test_platform_export.py"],
    data = [
        "//infra:python_sources",
        "//infra:variables.tf",
        "//tools:repository_test_data",
    ],
    imports = [
        ".",
        "../scripts",
    ],
    modules = ["test_platform_export"],
