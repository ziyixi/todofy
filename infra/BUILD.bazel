load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:public"])

_CONFIG_INPUTS = glob([
    "*.tf",
    ".terraform.lock.hcl",
    "local.tfvars.example",
    ".gitignore",
]) + ["BUILD.bazel"] + [
    "//infra/scripts:apply_diagnostics.py",
    "//infra/scripts:bootstrap_state.py",
    "//infra/scripts:infra_state.py",
    "//infra/scripts:local_tfvars.py",
    "//infra/scripts:platform_export.py",
    "//infra/scripts:reconcile_policy.py",
    "//infra/scripts:reviewed_plans.py",
    "//infra/tests:test_apply_diagnostics.py",
    "//infra/tests:test_infra_state.py",
    "//infra/tests:test_local_tfvars.py",
    "//infra/tests:test_platform_export.py",
    "//infra/tests:test_reconcile.py",
]

filegroup(
    name = "python_sources",
    srcs = [
        "//infra/scripts:python_sources",
        "//infra/tests:python_sources",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":config_guard_test",
        ":format_validate_test",
        "//.github/scripts:infra_guard_cases_test",
        "//infra/tests:check",
    ],
)

filegroup(
    name = "config",
    srcs = _CONFIG_INPUTS,
)

py_test(
    name = "config_guard_test",
    srcs = ["//tools/bazel/python:check_infra.py"],
    args = ["$(rootpath " + source + ")" for source in _CONFIG_INPUTS],
    data = _CONFIG_INPUTS,
    legacy_create_init = False,
    main = "//tools/bazel/python:check_infra.py",
    deps = ["//infra/tests:guard_lib"],
)

py_test(
    name = "format_validate_test",
    srcs = ["//tools/bazel/python:check_infra.py"],
    args = [
        "--tofu",
        "$(rootpath //tools/bazel/python:tofu)",
        "--provider-files",
        "$(rootpaths //tools/bazel/python:cloudflare_provider)",
        "--platform",
    ] + select({
        "//tools/bazel/images:macos_arm64": ["darwin_arm64"],
        "//tools/bazel/images:linux_x86_64": ["linux_amd64"],
    }) + ["--"] + ["$(rootpath " + source + ")" for source in _CONFIG_INPUTS],
    data = _CONFIG_INPUTS + [
        "//tools/bazel/python:cloudflare_provider",
        "//tools/bazel/python:tofu",
    ],
    legacy_create_init = False,
    main = "//tools/bazel/python:check_infra.py",
    deps = ["//infra/tests:guard_lib"],
)

source_audit_files(deps = [
    "//infra/scripts:source_audit_files",
    "//infra/tests:source_audit_files",
])
