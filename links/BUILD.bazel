load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":links",
        "//.github/actions:release-links/action.yml",
        "//links/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://links:links",
        "release:worker:links",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "migrations/0001_init.sql",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//links/deploy:check",
        "//links/tools:check",
        "//links/web:check",
        "//links/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "links",
    srcs = [
        ":config",
        "//links/web:bundle",
        "//links/worker:application_sources",
        "//links/worker:edge_auth_types_link",
        "//links/worker:proto_types_link",
        "//links/worker/src:lib",
    ],
    bundle_visibility = ["//links:__subpackages__"],
    tool = "//links/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//links/web:bundle",
)

source_audit_files(patterns = [
    "*",
    "docs/**",
    "migrations/**",
])
