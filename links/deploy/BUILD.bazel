load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//links:__subpackages__"])

tsx.tsx_test(
    name = "deploy-vars_test",
    args = [
        "--test",
        "test/deploy-vars.test.mjs",
    ],
    chdir = "links/deploy",
    data = [
        "test/deploy-vars.test.mjs",
        ":source_deploy_vars_mjs",
        "//links:config",
        "//links/worker:package_metadata",
    ],
)

tsx.tsx_test(
    name = "wrangler-config_test",
    args = [
        "--test",
        "test/wrangler-config.test.mjs",
    ],
    chdir = "links/deploy",
    data = [
        "test/wrangler-config.test.mjs",
        ":source_deploy_vars_mjs",
        "//links:config",
        "//links/worker:node_modules/wrangler",
        "//links/worker:package_metadata",
        "//links/worker/src:entry_metadata",
        "//links/worker/test:runtime_metadata",
    ],
)

tsx.tsx_test(
    name = "bundle-size_test",
    args = [
        "--test",
        "test/bundle-size.test.mjs",
    ],
    chdir = "links/deploy",
    data = [
        "test/bundle-size.test.mjs",
        ":source_bundle_size_mjs",
        "//links/worker:package_metadata",
        "//tools/bundle-size:library",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":bundle-size_test",
        ":bundle_budget_test",
        ":deploy-vars_test",
        ":wrangler-config_test",
    ],
)

js_test(
    name = "bundle_budget_test",
    args = ["$(rootpath //links:worker_bundle)"],
    data = [
        ":source_bundle_size_mjs",
        "//links:worker_bundle",
    ],
    entry_point = "bundle-size.mjs",
    preserve_symlinks_main = False,
)

js_library(
    name = "source_deploy_vars_mjs",
    srcs = ["deploy-vars.mjs"],
    visibility = [
        "//links:__subpackages__",
        "//tools/cloud-config:__pkg__",
        "//tools/cloud-config/tests:__pkg__",
    ],
    deps = ["//tools/cloud-config:worker-deploy"],
)

js_library(
    name = "source_bundle_size_mjs",
    srcs = ["bundle-size.mjs"],
    deps = ["//tools/bundle-size:library"],
)

source_audit_files(patterns = [
    "*",
    "test/**",
])
