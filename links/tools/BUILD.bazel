load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//website:tsx/package_json.bzl", tsx = "bin")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//links:__subpackages__"])

ts_project(
    name = "restore_types",
    srcs = ["backup-restore.ts"],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = {"compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "allowImportingTsExtensions": True,
        "skipLibCheck": True,
        "types": ["node"],
        "typeRoots": ["../worker/node_modules/@types"],
    }},
    deps = ["//links/worker:node_modules/@types/node"],
)

js_library(
    name = "backup-restore",
    srcs = ["backup-restore.ts"],
    deps = [":restore_types"],
)

tsx.tsx_test(
    name = "backup-restore_test",
    args = [
        "--test",
        "test/backup-restore.test.mjs",
    ],
    chdir = "links/tools",
    data = [
        "test/backup-restore.test.mjs",
        ":source_backup_restore_ts",
        "//links:config",
        "//links/worker:package_metadata",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":backup-restore_test",
        ":restore_types_typecheck_test",
    ],
)

js_library(
    name = "source_backup_restore_ts",
    srcs = ["backup-restore.ts"],
    deps = [],
)

source_audit_files(patterns = [
    "*",
    "test/**",
])
