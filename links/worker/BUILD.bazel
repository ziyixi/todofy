load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//links/worker:eslint/package_json.bzl", eslint = "bin")
load("@npm//links/worker:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//links:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.runtime.config.ts",
    ],
    visibility = ["//links:__subpackages__"],
)

alias(
    name = "package_json",
    actual = ":package_metadata",
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "runtime_test_config",
    srcs = ["vitest.runtime.config.ts"],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "proto_types_package",
    deps = [
        "//links/worker/src:lib",
        "//proto/common/errors/v1:ts",
        "//proto/links/ui/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/ts:field-mask",
        "//proto/ts:filter",
        "//proto/ts:http-transcoder",
        "//proto/ts:page-token",
        "//proto/ts:protobuf",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
    ],
)

workspace_package_link(
    name = "proto_types_link",
    src = ":proto_types_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_types_link",
    src = "//packages/edge-auth:pkg",
)

ts_project(
    name = "types",
    srcs = [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
        "//links/worker/src:types_srcs",
        "//links/worker/test:types_srcs",
    ],
    data = [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
    ],
    no_emit = True,
    resolve_json_module = True,
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/vitest",
        ":proto_types_link",
        "//links/worker/src:lib",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

ts_project(
    name = "web_limits_types",
    srcs = ["//links/worker/src:web_limits_types_srcs"],
    declaration = True,
    emit_declaration_only = True,
    extends = ":tsconfig.json",
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": False},
        "include": [],
        "exclude": [],
    },
    deps = [":node_modules/@cloudflare/workers-types"],
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = ["//links/worker/src:application_sources_srcs"] + glob([
        "package.json",
        "tsconfig.json",
    ]),
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
        ":web_limits_types_typecheck_test",
        "//links/worker/test:check",
    ],
)

ts_config(
    name = "worker_config",
    src = ":tsconfig.json",
)

ts_config(
    name = "runtime_config",
    src = "//links/worker/test:source_runtime_tsconfig_json",
    deps = [":worker_config"],
)

ts_project(
    name = "runtime_types",
    srcs = [":proto_types_package_wire_types"] + ["//links/worker/test:runtime_types_srcs"],
    extends = ":runtime_config",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":proto_types_link",
        "//:node_modules/@cloudflare/workers-types",
        "//links/tools:restore_types",
        "//links/worker/src:lib",
        "//links/worker/test:test_support",
        "//tools/workerd-cpu:types",
    ],
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/miniflare",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":package.json",
        ":proto_types_link",
        ":tsconfig.json",
        "//:node_modules/@cloudflare/workers-types",
        "//links/tools:restore_types",
        "//links/worker/src:lib",
        "//links/worker/test:lint_data",
        "//links/worker/test:runtime_helpers",
        "//links/worker/test:test_support",
        "//tools/workerd-cpu:types",
    ],
    runner = eslint.eslint_binary,
    sources = ["//links/worker/src:lint_sources"] + ["//links/worker/test:lint_sources"] + glob(
        [
            "scripts/**/*.mjs",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

js_library(
    name = "package_metadata",
    srcs = [":package.json"],
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//links/worker/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [
        ":runtime_types_typecheck_test",
        ":types_typecheck_test",
    ],
)

test_suite(
    name = "runtime_tests",
    tests = ["//links/worker/test:runtime_tests"],
)

alias(
    name = "lib",
    actual = "//links/worker/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
        "test/**",
    ],
    deps = [
        "//links/worker/src:source_audit_files",
        "//links/worker/test:source_audit_files",
    ],
)
