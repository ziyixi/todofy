{
  "name": "links-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"links\": the owner's short links on s.ziyixi.science (one D1 read per redirect) and their owner API (links.ui.v1) behind Access.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/runtime/tsconfig.json",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "pretest:runtime": "node ../../proto/tools/ensure.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "wrangler dev --config ../wrangler.toml --ip 127.0.0.1 --port 8790 --local-upstream 127.0.0.1:8790"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "file:../../packages/edge-auth",
    "@ziyixi/proto": "file:../../proto/ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "miniflare": "5.20260926.0-alpha",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
