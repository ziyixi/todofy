{
  "name": "links-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker \"links\": the owner's short links on s.ziyixi.science (one D1 read per redirect) and their owner API (links.ui.v1) behind Access.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //links/worker:typecheck_tests",
    "lint": "bazel test //links/worker:lint",
    "test": "bazel test //links/worker:unit_tests",
    "test:runtime": "bazel test //links/worker:runtime_tests --nocache_test_results",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "bazel build //links/web:bundle && wrangler dev --assets ../../bazel-bin/links/web/dist --config ../wrangler.toml --ip 127.0.0.1 --port 8790 --local-upstream 127.0.0.1:8790",
    "check": "bazel test //links:check"
  },
  "dependencies": {
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
