{
  "name": "links-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The launcher of the owner's short links (Chinese, no framework), built into ../web/dist/_ and served by the Worker \"links\" under /_/.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "prebuild": "node ../../proto/tools/ensure.mjs",
    "build": "tsc --noEmit && vite build && node scripts/finish-dist.mjs",
    "check:dist": "node scripts/finish-dist.mjs"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
