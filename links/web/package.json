{
  "name": "links-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The launcher of the owner's short links (Chinese, no framework), built into ../web/dist/_ and served by the Worker \"links\" under /_/.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "typecheck": "bazel test //links/web:typecheck_tests",
    "lint": "bazel test //links/web:lint",
    "test": "bazel test //links/web:unit_tests",
    "build": "bazel build //links/web:bundle",
    "check:dist": "bazel build //links/web:bundle",
    "check": "bazel test //links:check"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
