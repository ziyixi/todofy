load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//links/web:eslint/package_json.bzl", eslint = "bin")
load("@npm//links/web:vite/package_json.bzl", vite = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "vite_bundle", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//links:__subpackages__"])

exports_files(
    [
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
    visibility = ["//links:__subpackages__"],
)

js_library(
    name = "source_index_html",
    srcs = ["index.html"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "test_config",
    srcs = ["vite.config.ts"],
)

npm_link_all_packages(name = "node_modules")

js_library(
    name = "application_sources",
    srcs = ["//links/web/src:application_sources_srcs"] + glob(
        [
            "public/**",
            "index.html",
            "_headers",
            "_redirects",
        ],
        allow_empty = True,
    ),
)

proto_package(
    name = "bundle_proto",
    deps = [
        "//links/web/src:lib",
        "//proto/common/errors/v1:ts",
        "//proto/links/ui/v1:ts",
        "//proto/ts:field-mask",
        "//proto/ts:http-client",
        "//proto/ts:http-transcoder",
        "//proto/ts:page-token",
        "//proto/ts:protobuf",
        "//proto/ts:protobuf-wkt",
        "//proto/ts:rpc-status",
        "//proto/ts:wire-json",
    ],
)

workspace_package_link(
    name = "bundle_proto_link",
    src = ":bundle_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

vite.vite_binary(name = "vite")

vite_bundle(
    name = "bundle",
    out_dir = "dist/_",
    postbuild = "//links/web/scripts:finish-dist.mjs",
    tool = ":vite",
    deps = [
        ":application_sources",
        ":bundle_proto_link",
        ":node_modules/vite",
        ":node_modules/vitest",
        "//links/web/scripts:build_checks",
        "//links/web/src:lib",
    ],
)

ts_project(
    name = "typecheck_project",
    srcs = [
        ":bundle_proto_wire_types",
        ":vite.config.ts",
        "//links/web/src:typecheck_project_srcs",
    ],
    extends = ":tsconfig.json",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "compilerOptions": {"noEmit": True},
        "include": [],
        "exclude": [],
    },
    deps = [
        ":bundle_proto_link",
        ":node_modules/@types/node",
        ":node_modules/vite",
        ":node_modules/vitest",
        "//links/worker/src:limits_web",
    ],
)

alias(
    name = "typecheck",
    actual = ":typecheck_project_typecheck",
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":typecheck_project_typecheck_test",
        "//links/web/src:check",
    ],
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":bundle_proto_link",
        ":node_modules/@eslint/js",
        ":node_modules/@types/node",
        ":node_modules/eslint",
        ":node_modules/jsdom",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vite",
        ":node_modules/vitest",
        ":package.json",
        ":tsconfig.json",
        "//links/web/scripts:build_checks",
        "//links/worker/src:limits_web",
    ],
    runner = eslint.eslint_binary,
    sources = ["//links/web/src:lint_sources"] + ["//links/web/scripts:lint_sources"] + glob(
        [
            "test/**/*.ts",
            "test/**/*.mts",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//links/web/src:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":typecheck_project_typecheck_test"],
)

alias(
    name = "lib",
    actual = "//links/web/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "scripts/**",
        "src/**",
    ],
    deps = [
        "//links/web/scripts:source_audit_files",
        "//links/web/src:source_audit_files",
    ],
)
