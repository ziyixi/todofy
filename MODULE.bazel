module(name = "personal_cloud")

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "yq.bzl", version = "0.3.4")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.9.0")
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    public_hoist_packages = {
        "@types/react": [""],
        "@cloudflare/workers-types": [""],
        "@dnd-kit/state": [""],
        "@dnd-kit/geometry": [""],
    },
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "6.0.3")
use_repo(typescript, "npm_typescript")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.single_version_override(
    python_version = "3.14.7",
    sha256 = {
        "aarch64-apple-darwin": "eded2b762929116a4e68ad1128e55f0728f502e93c90454e3b5f79da7a2cda40",
        "x86_64-unknown-linux-gnu": "490953e4a7e97a6ed64d0f0bd04f2d4d9a7bb45368890d3fa32ba05d0ff5c48f",
    },
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260814/cpython-{python_version}+20260814-{platform}-install_only.tar.gz"],
)
python.override(minor_mapping = {"3.14": "3.14.7"})
python.toolchain(
    is_default = True,
    python_version = "3.14.7",
)
use_repo(python, "python_3_14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.14",
    uv_lock = "//:uv.lock",
    enable_implicit_namespace_pkgs = True,
    target_platforms = ["osx_aarch64", "linux_x86_64"],
)
use_repo(pip, "python_deps")

googleapis = use_repo_rule("//proto/bazel:repositories.bzl", "googleapis_repository")
googleapis(name = "googleapis")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//proto/tools/api-linter:go.mod")
use_repo(
    go_deps,
    "com_github_googleapis_api_linter_v2",
    "com_google_cloud_go_longrunning",
    "org_golang_google_genproto",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_protobuf",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_base",
    image = "docker.io/library/python",
    digest = "sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56",
    platforms = ["linux/amd64"],
    config = "//tools/bazel/images:docker-public.json",
)
use_repo(oci, "python_base", "python_base_linux_amd64")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "newsletter_fonts",
    urls = ["https://deb.debian.org/debian/pool/main/f/fonts-noto-cjk/fonts-noto-cjk_20220127+repack1-1_all.deb"],
    sha256 = "4a2515eb6db3978b897fef9709ed0d2b1f4c6c4df4d83d6c4ef65f71f1b1f502",
    type = "deb",
    build_file_content = 'exports_files(["data.tar.xz"],visibility=["//visibility:public"])',
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "kubectl_linux_amd64",
    urls = ["https://dl.k8s.io/release/v1.36.1/bin/linux/amd64/kubectl"],
    sha256 = "629d3f410e09bf49b64ae7079f7f0bda1191efed311f7d37fdbab0ad5b0ec2b7",
    executable = True,
)
http_file(
    name = "kubectl_darwin_arm64",
    urls = ["https://dl.k8s.io/release/v1.36.1/bin/darwin/arm64/kubectl"],
    sha256 = "9092778abaef3079449da4cd70ded0e4be112480c93efcdeace3155968d1d133",
    executable = True,
)

yq = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
use_repo(yq, "yq_darwin_arm64", "yq_darwin_amd64", "yq_linux_amd64", "yq_linux_arm64")
