    name = "tests",
    tests = [
        ":tests_test_access",
        ":tests_test_failure_errors",
        ":tests_test_gateway",
        ":tests_test_home",
        ":tests_test_modelrouter",
        ":tests_test_process_cleanup",
    ],
)

py_package(
    name = "image_dependencies",
    packages = ["site-packages"],
    tags = ["manual"],
    deps = [":library"],
)

py_package(
    name = "image_executable_dependencies",
    packages = [
        "site-packages/codex_cli_bin/bin/",
        "site-packages/codex_cli_bin/codex-path/",
    ],
    tags = ["manual"],
    deps = [":library"],
)

pkg_files(
    name = "image_dependency_files",
    srcs = [":image_dependencies"],
    excludes = [":image_executable_dependencies"],
    prefix = "opt/codex-gateway/.venv/lib/python3.14/site-packages",
    strip_prefix = strip_prefix.from_root("site-packages"),
    tags = ["manual"],
)

pkg_files(
    name = "image_executable_dependency_files",
    srcs = [":image_executable_dependencies"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "opt/codex-gateway/.venv/lib/python3.14/site-packages",
    strip_prefix = strip_prefix.from_root("site-packages"),
    tags = ["manual"],
)

pkg_tar(
    name = "image_dependency_layer",
    srcs = [
        ":image_dependency_files",
        ":image_executable_dependency_files",
    ],
    tags = ["manual"],
)

py_package(
    name = "image_source",
    packages = ["codex-gateway/src"],
    tags = ["manual"],
    deps = [":library"],
)

pkg_files(
    name = "image_source_files",
    srcs = [":image_source"],
    prefix = "opt/codex-gateway/app",
    strip_prefix = strip_prefix.from_root("codex-gateway/src"),
    tags = ["manual"],
)

py_package(
    name = "image_proto",
    packages = ["proto/python/src"],
    tags = ["manual"],
    deps = [":library"],
)

pkg_files(
    name = "image_proto_files",
    srcs = [":image_proto"],
    prefix = "opt/codex-gateway/app",
    strip_prefix = strip_prefix.from_root("proto/python/src"),
    tags = ["manual"],
)

pkg_files(
    name = "image_public_config",
    srcs = [
        "//:config/cloud.toml",
        "//:config/resources.toml",
    ],
    prefix = "opt/codex-gateway/public-build-config",
    strip_prefix = strip_prefix.from_root("config"),
    tags = ["manual"],
)

pkg_tar(
    name = "image_source_layer",
    srcs = [
        ":image_proto_files",
        ":image_public_config",
        ":image_source_files",
    ],
    tags = ["manual"],
)

python_runtime_tree(
    name = "image_runtime",
    base = "@python_base_linux_amd64",
    service = "codex-gateway",
    tags = ["manual"],
)

pkg_files(
    name = "image_runtime_files",
    srcs = [":image_runtime"],
    renames = {":image_runtime": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_mkdirs(
    name = "image_home",
    attributes = pkg_attributes(
        gid = 10001,
        mode = "0755",
        uid = 10001,
    ),
    dirs = ["home/codex-gateway"],
    tags = ["manual"],
)

pkg_tar(
    name = "image_runtime_layer",
    srcs = [
        ":image_home",
        ":image_runtime_files",
    ],
    symlinks = {
        "opt/codex-gateway/.venv/bin/python": "/usr/local/bin/python3.14",
        "opt/codex-gateway/.venv/bin/python3": "python",
        "opt/codex-gateway/.venv/bin/python3.14": "python",
    },
    tags = ["manual"],
)

gateway_image_identity(
    name = "image_identity",
    profile = "//:config/cloud.toml",
    resources = "//:config/resources.toml",
    tags = ["manual"],
)

pkg_files(
    name = "image_identity_files",
    srcs = [":image_identity"],
    renames = {":image_identity": REMOVE_BASE_DIRECTORY},
    tags = ["manual"],
)

pkg_tar(
    name = "image_identity_layer",
    srcs = [":image_identity_files"],
    tags = ["manual"],
)

filegroup(
    name = "image_labels",
    srcs = [":image_identity"],
    output_group = "labels",
    tags = ["manual"],
)

oci_image(
    name = "image",
    base = "@python_base_linux_amd64",
    entrypoint = [
        "python",
        "-m",
        "codex_gateway",
    ],
    env = {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": "/opt/codex-gateway/.venv/bin:$PATH",
        "PYTHONPATH": "/opt/codex-gateway/app",
        "HOME": "/home/codex-gateway",
    },
    exposed_ports = ["8080"],
    labels = ":image_labels",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tars = [
        ":image_runtime_layer",
        ":image_dependency_layer",
        ":image_source_layer",
        ":image_identity_layer",
    ],
    user = "10001:10001",
    workdir = "/opt/codex-gateway",
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["todofy-codex-gateway:bazel"],
    tags = ["manual"],
)

filegroup(
    name = "image_tar",
    srcs = [":image_load"],
    output_group = "tarball",
    tags = ["manual"],
)

alias(
    name = "codex-gateway",
    actual = ":image_tar",
    tags = ["manual"],
)

test_suite(
    name = "check",
    tests = [
        ":container_test",
        ":ruff_check_test",
        ":ruff_format_test",
        ":tests",
        "//tools/container-release:build_identity_test",
    ],
)

filegroup(
    name = "config",
    srcs = [
        "app.toml",
        "pyproject.toml",
        "//:config/cloud.toml",
        "//:config/resources.toml",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "python_lint_inputs",
    srcs = glob([
        "src/**/*.py",
        "tests/**/*.py",
    ]) + ["pyproject.toml"],
)

[
    py_test(
        name = "ruff_" + command + "_test",
        srcs = ["//tools/bazel/python:check_ruff.py"],
        args = [
            "$(rootpath @python_deps//ruff:data)",
            "$(rootpath //:pyproject.toml)",
            command,
        ] + (["--check"] if command == "format" else []) + [
            "codex-gateway/src",
            "codex-gateway/tests",
        ],
        data = [
            ":python_lint_inputs",
            "//:pyproject.toml",
            "@python_deps//ruff:data",
        ] + [],
        legacy_create_init = False,
        main = "//tools/bazel/python:check_ruff.py",
    )
    for command in [
        "check",
        "format",
    ]
]

filegroup(
    name = "container_probe_inputs",
    srcs = ["tests/image_probe.py"],
)

container_image_test(
    name = "container_test",
    service = "codex-gateway",
    sources = ":container_probe_inputs",
)
