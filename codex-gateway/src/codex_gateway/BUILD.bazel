load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//codex-gateway:__subpackages__"])

py_library(
    name = "__main__",
    srcs = ["__main__.py"],
    imports = [".."],
    deps = [
        ":app",
        ":package",
        "@python_deps//uvicorn",
    ],
)

py_library(
    name = "_launch",
    srcs = ["_launch.py"],
    imports = [".."],
    deps = [
        ":package",
        "@python_deps//openai_codex_cli_bin",
    ],
)

py_library(
    name = "access",
    srcs = ["access.py"],
    imports = [".."],
    visibility = [
        "//codex-gateway:__subpackages__",
        "//tools/bazel/images:__pkg__",
    ],
    deps = [
        ":package",
        "@python_deps//cryptography",
        "@python_deps//pyjwt",
    ],
)

py_library(
    name = "app",
    srcs = [
        "app.py",
        "model_api.py",
    ],
    imports = [".."],
    deps = [
        ":access",
        ":modelrouter",
        ":package",
        "//proto:python_runtime",
        "//proto/modelrouter/inference/v1:python",
        "@python_deps//fastapi",
    ],
)

py_library(
    name = "model_events",
    srcs = ["model_events.py"],
    imports = [".."],
    deps = [
        ":package",
        "//proto/modelrouter/inference/v1:python",
        "@python_deps//openai_codex",
    ],
)

py_library(
    name = "modelrouter",
    srcs = ["modelrouter.py"],
    imports = [".."],
    deps = [
        ":model_events",
        ":package",
        ":runtime",
        "//proto:python_runtime",
        "//proto/modelrouter/inference/v1:python",
        "@python_deps//jsonschema",
        "@python_deps//openai_codex",
    ],
)

py_library(
    name = "package",
    srcs = ["__init__.py"],
    imports = [".."],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    imports = [".."],
    deps = [
        ":package",
        "//proto:python_runtime",
        "//proto/modelrouter/inference/v1:python",
        "@python_deps//openai_codex",
    ],
)

py_library(
    name = "library",
    deps = [
        ":__main__",
        ":_launch",
        ":access",
        ":app",
        ":model_events",
        ":modelrouter",
        ":package",
        ":runtime",
    ],
)

filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
