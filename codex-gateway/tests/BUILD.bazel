filegroup(
    name = "python_sources",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(
        ["**"],
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
    visibility = ["//visibility:public"],
)
