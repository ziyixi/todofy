{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/ops-v1/ops-v1.schema.json",
  "title": "ops-v1: the typed operations surface of Mail Hero, Todofy and Lab",
  "description": "Every input and output of the named WorkerEntrypoint \"Ops\" of each app, one $defs entry each (README.md maps methods to entries). Generated from proto/ops/v1/ops.proto by proto/tools/gen_schema.py: do not edit. Outputs are closed so that nothing but codes, numbers, booleans and timestamps can leave an app; consumers still ignore fields they do not know.",
  "$defs": {
    "Timestamp": {
      "description": "RFC 3339 UTC with Z, optional milliseconds.",
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z)$(?!\\n)"
    },
    "Code": {
      "description": "A closed-vocabulary identifier: signal codes, counter and metric names, reasons. Never free text.",
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]{0,47})$(?!\\n)"
    },
    "EventId": {
      "description": "A mail.received.v1 event_id as Mail Hero writes it (lowercase UUID).",
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?!\\n)"
    },
    "RunId": {
      "description": "The dashboard's name for one canary run, e.g. canary-2026-09-29. Also the mail.received.v1 canary.run_id.",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63})$(?!\\n)"
    },
    "HttpsUrl": {
      "description": "An https URL with a lowercase host and a plain path; no query, fragment, credentials or port.",
      "type": "string",
      "maxLength": 300,
      "pattern": "^(?:https://[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?/[A-Za-z0-9._~/-]{0,200})$(?!\\n)"
    },
    "Source": {
      "description": "Where a report item comes from: an app (mail-hero, todofy, lab), dashboard, cloudflare.",
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]{0,31})$(?!\\n)"
    },
    "Health": {
      "enum": [
        "ok",
        "degraded",
        "down"
      ]
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "GuardLevel": {
      "enum": [
        "normal",
        "shed"
      ]
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "busy",
        "unavailable"
      ]
    },
    "StartCanaryResult_State": {
      "enum": [
        "queued",
        "paused",
        "unavailable"
      ]
    },
    "CanaryDelivery_State": {
      "enum": [
        "delivered",
        "pending",
        "paused",
        "failed",
        "unknown"
      ]
    },
    "CanaryResult_State": {
      "enum": [
        "not_seen",
        "processing",
        "ok",
        "failed"
      ]
    },
    "StatusRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "OpsStatus": {
      "type": "object",
      "required": [
        "version",
        "app",
        "generated_at",
        "health",
        "modes",
        "guard",
        "signals",
        "counters",
        "last_backup_at",
        "ui_url",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": "ops-v1"
        },
        "app": {
          "enum": [
            "mail-hero",
            "todofy",
            "lab"
          ]
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "health": {
          "$ref": "#/$defs/Health"
        },
        "modes": {
          "type": "object",
          "required": [
            "maintenance"
          ],
          "maxProperties": 12,
          "propertyNames": {
            "$ref": "#/$defs/Code"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "guard": {
          "$ref": "#/$defs/GuardState"
        },
        "signals": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Signal"
          }
        },
        "counters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/Code"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "last_backup_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_url": {
          "oneOf": [
            {
              "$ref": "#/$defs/HttpsUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Code"
          }
        }
      },
      "additionalProperties": false
    },
    "Signal": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "metrics"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "metrics": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "$ref": "#/$defs/Code"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "GuardState": {
      "type": "object",
      "required": [
        "level",
        "reason",
        "until",
        "set_at",
        "deferred"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/GuardLevel"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "set_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deferred": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Code"
          }
        }
      },
      "additionalProperties": false
    },
    "SetGuardInput": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "level",
            "reason",
            "until"
          ],
          "properties": {
            "level": {
              "const": "normal"
            },
            "reason": {
              "$ref": "#/$defs/Code"
            },
            "until": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "level",
            "reason",
            "until"
          ],
          "properties": {
            "level": {
              "const": "shed"
            },
            "reason": {
              "$ref": "#/$defs/Code"
            },
            "until": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "StartCanaryInput": {
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        }
      },
      "additionalProperties": false
    },
    "StartCanaryResult": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "event_id",
            "state"
          ],
          "properties": {
            "event_id": {
              "$ref": "#/$defs/EventId"
            },
            "state": {
              "const": "queued"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "event_id",
            "state",
            "reason"
          ],
          "properties": {
            "event_id": {
              "type": "null"
            },
            "state": {
              "const": "paused"
            },
            "reason": {
              "enum": [
                "send_paused",
                "settings_paused",
                "endpoint_paused",
                "endpoint_blocked"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "event_id",
            "state",
            "reason"
          ],
          "properties": {
            "event_id": {
              "type": "null"
            },
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "maintenance",
                "backup_active",
                "no_endpoint",
                "capacity"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CanaryDeliveryRequest": {
      "type": "object",
      "required": [
        "event_id"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "additionalProperties": false
    },
    "CanaryDelivery": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "attempts",
            "delivered_at"
          ],
          "properties": {
            "state": {
              "const": "delivered"
            },
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "last_http_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "delivered_at": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "attempts"
          ],
          "properties": {
            "state": {
              "const": "pending"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "last_http_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "error_code": {
              "$ref": "#/$defs/Code"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "attempts"
          ],
          "properties": {
            "state": {
              "const": "paused"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "last_http_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "error_code": {
              "$ref": "#/$defs/Code"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "attempts",
            "error_code"
          ],
          "properties": {
            "state": {
              "const": "failed"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "last_http_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "error_code": {
              "$ref": "#/$defs/Code"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "attempts"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "attempts": {
              "const": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CanaryResultRequest": {
      "type": "object",
      "required": [
        "event_id"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "additionalProperties": false
    },
    "CanaryResult": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "not_seen"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "processing"
            },
            "waiting_code": {
              "enum": [
                "maintenance",
                "processing_paused",
                "backup_active",
                "retry_wait"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "completed_at"
          ],
          "properties": {
            "state": {
              "const": "ok"
            },
            "completed_at": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "completed_at",
            "error_code"
          ],
          "properties": {
            "state": {
              "const": "failed"
            },
            "completed_at": {
              "$ref": "#/$defs/Timestamp"
            },
            "error_code": {
              "$ref": "#/$defs/Code"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "OpsReport": {
      "type": "object",
      "required": [
        "generated_at",
        "items"
      ],
      "properties": {
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/OpsReportItem"
          }
        },
        "dashboard_url": {
          "$ref": "#/$defs/HttpsUrl"
        }
      },
      "additionalProperties": false
    },
    "OpsReportItem": {
      "type": "object",
      "required": [
        "source",
        "code",
        "severity",
        "since",
        "metrics"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "code": {
          "$ref": "#/$defs/Code"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        },
        "metrics": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "$ref": "#/$defs/Code"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "OpsReportReceipt": {
      "type": "object",
      "required": [
        "stored",
        "generated_at",
        "item_count"
      ],
      "properties": {
        "stored": {
          "type": "boolean"
        },
        "generated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "additionalProperties": false
    }
  }
}
