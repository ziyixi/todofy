load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

package(default_visibility = ["//visibility:public"])

# Each consumer depends on the exact schema/fixture it reads.
_ASSETS = glob(["**/*.json", "**/*.yaml", "**/fixtures/**"], allow_empty = True)

exports_files(_ASSETS)
exports_files(["ops-v1/ops-v1.ts", "ops-v1/validate.mjs"])

ts_project(
    name = "ops_v1_types",
    srcs = ["ops-v1/ops-v1.ts"],
    declaration = True,
    emit_declaration_only = True,
    tsconfig = {
        "compilerOptions": {
            "target": "ES2024",
            "module": "ESNext",
            "moduleResolution": "Bundler",
            "strict": True,
            "skipLibCheck": True,
        },
    },
)

js_library(
    name = "ops-v1/runtime",
    srcs = ["ops-v1/ops-v1.ts"],
    deps = [":ops_v1_types"],
)
js_library(name = "ops-v1/validate", srcs = ["ops-v1/validate.mjs"])
js_library(name = "ops-v1/readme", srcs = ["ops-v1/README.md"])
js_library(name = "ops-v1/fixtures", srcs = glob(["ops-v1/fixtures/**"]))
js_library(name = "ops-v1/invalid", srcs = glob(["ops-v1/fixtures/invalid/*/*.json"]))

[
    js_library(name = asset + "_data", srcs = [asset], types = [asset] if asset.endswith(".json") else [])
    for asset in _ASSETS
]

filegroup(
    name = "fixtures",
    srcs = _ASSETS,
)
