{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mail-hero.local/schema/mail-received-v1.schema.json",
  "title": "Mail Hero mail.received.v1 event",
  "type": "object",
  "required": ["type", "event_id", "received_at", "message"],
  "properties": {
    "type": {"const": "mail.received.v1"},
    "event_id": {"type": "string", "format": "uuid"},
    "received_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "canary": {
      "description": "Present only on synthetic end-to-end canary events (contracts/ops-v1). Consumers MUST NOT cause external side effects (tasks, messages, reports) for an event that carries it. An event whose canary is present but unreadable must not cause side effects either: reject it (4xx) or handle it as a canary.",
      "type": "object",
      "required": ["run_id"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?!\\n)"}
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["id", "from", "to", "subject", "sent_at", "rfc_message_id", "text", "attachments"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "from": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/address"}},
        "to": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/address"}},
        "subject": {"type": "string"},
        "sent_at": {"type": ["string", "null"], "format": "date-time"},
        "rfc_message_id": {"type": ["string", "null"]},
        "text": {"type": "string"},
        "text_truncated": {"type": "boolean"},
        "original_text_bytes": {"type": "integer", "minimum": 0, "description": "UTF-8 size of normalized plaintext before UI/webhook truncation; not raw MIME size."},
        "html_omitted": {"type": "boolean"},
        "needs_review": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "content_policy_version": {"type": "string"},
        "attachments_omitted_count": {"type": "integer", "minimum": 0, "description": "Attachment records omitted beyond the 100-record metadata cap. Excludes listed records whose byte copies were omitted."},
        "attachments": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/attachment"}}
      },
      "anyOf": [
        {"properties": {"subject": {"pattern": "\\S"}}},
        {"properties": {"text": {"pattern": "\\S"}}}
      ],
      "allOf": [{"if": {"required": ["text_truncated"], "properties": {"text_truncated": {"const": true}}}, "then": {"required": ["original_text_bytes"]}}],
      "additionalProperties": true
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": ["address", "name"],
      "properties": {
        "address": {"type": "string"},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "required": ["filename", "content_type", "size"],
      "properties": {
        "filename": {"type": "string"},
        "content_type": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "storage_status": {"enum": ["stored", "omitted"], "description": "Copy status at event creation, not a promise of perpetual availability."},
        "omitted_reason": {"enum": ["size_limit", "message_size_limit", "inline_image", "capacity"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
