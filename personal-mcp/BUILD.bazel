load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":personal-mcp",
        "//.github/actions:release-personal-mcp/action.yml",
        "//personal-mcp/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://personal-mcp:personal-mcp",
        "release:worker:personal-mcp",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//personal-mcp/deploy:check",
        "//personal-mcp/tools:check",
        "//personal-mcp/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "personal-mcp",
    srcs = [
        ":config",
        "//personal-mcp/worker:application_sources",
        "//personal-mcp/worker:edge_auth_types_link",
        "//personal-mcp/worker:proto_types_link",
        "//personal-mcp/worker/src:lib",
    ],
    tool = "//personal-mcp/worker:wrangler",
    visibility = ["//visibility:public"],
)

source_audit_files(patterns = [
    "*",
    "docs/**",
    "plugin/**",
])
