{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "vitest.runtime.config.ts"]
}
