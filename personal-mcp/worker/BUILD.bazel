    deps = ["//proto/ts:http-client", "//proto/ts:wire-json", "//proto/watch/ui/v1:ts", ":events", ":watch", ":work-store"],
)

js_library(
    name = "restore",
    srcs = ["src/restore.ts"],
    types = ["src/restore.ts"],
    deps = [":backup", ":events"],
)

js_library(
    name = "module_group_15",
    srcs = ["src/auth.ts", "src/env.ts", "src/ops.ts", "src/store.ts"],
    types = ["src/auth.ts", "src/env.ts", "src/ops.ts", "src/store.ts"],
    deps = ["//packages/edge-auth:lib", "//proto/ops/v1:ts", "//proto/ts:http-client", "//proto/ts:protobuf", "//proto/ts:wire-json", ":backup", ":content", ":events", ":node_modules/@modelcontextprotocol/server", ":restore", ":server", ":watch", ":watch-events", ":webhook", ":work-store"],
)

alias(name = "auth", actual = ":module_group_15")
alias(name = "env", actual = ":module_group_15")
alias(name = "ops", actual = ":module_group_15")
alias(name = "store", actual = ":module_group_15")
js_library(
    name = "index",
    srcs = ["src/index.ts"],
    types = ["src/index.ts"],
    deps = [":module_group_15"],
)

js_library(name = "lib", deps = [":backup", ":content", ":events", ":index", ":module_group_15", ":recall", ":restore", ":server", ":source-tools", ":tasks", ":watch", ":watch-events", ":webhook", ":work-model", ":work-read", ":work-store", ":work-tools"])

