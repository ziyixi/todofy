    name = "watch_test",
    runner = vitest.vitest_test,
    tests = ["test/watch.test.ts"],
    deps = [":watch", ":work-model", ":work-store"],
    data = [":node_modules/@modelcontextprotocol/server", ":node_modules/vitest", "package.json"],
