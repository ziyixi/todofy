    types = ["src/source-tools.ts"],
    deps = ["//proto/ts:http-client", ":node_modules/@modelcontextprotocol/server"],
)

js_library(
    name = "recall",
    srcs = ["src/recall.ts"],
    types = ["src/recall.ts"],
    deps = ["//proto/recall/ui/v1:ts", "//proto/ts:http-client", "//proto/ts:wire-json", ":node_modules/@modelcontextprotocol/server", ":node_modules/zod", ":source-tools"],
