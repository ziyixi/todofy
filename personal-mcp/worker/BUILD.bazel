    name = "types",
    srcs = ["src/auth.ts", "src/backup.ts", "src/content.ts", "src/env.ts", "src/events.ts", "src/index.ts", "src/ops.ts", "src/recall.ts", "src/restore.ts", "src/server.ts", "src/source-tools.ts", "src/store.ts", "src/tasks.ts", "src/watch-events.ts", "src/watch.ts", "src/webhook.ts", "src/work-model.ts", "src/work-read.ts", "src/work-store.ts", "src/work-tools.ts", "test/auth.test.ts", "test/backup.test.ts", "test/content.test.ts", "test/events.test.ts", "test/tasks.test.ts", "test/watch-events.test.ts", "test/watch.test.ts", "test/webhook.test.ts", "test/work.test.ts", "vitest.config.ts", "vitest.runtime.config.ts"],
