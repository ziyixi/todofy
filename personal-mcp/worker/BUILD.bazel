load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//personal-mcp/worker:eslint/package_json.bzl", eslint = "bin")
load("@npm//personal-mcp/worker:wrangler/package_json.bzl", wrangler = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//personal-mcp:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.runtime.config.ts",
    ],
    visibility = ["//personal-mcp:__subpackages__"],
)

alias(
    name = "package_json",
    actual = ":package_metadata",
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "runtime_test_config",
    srcs = ["vitest.runtime.config.ts"],
)

npm_link_all_packages(name = "node_modules")

proto_package(
    name = "proto_types_package",
    deps = [
        "//personal-mcp/worker/src:lib",
        "//proto/dashboard/mcp/v1:ts",
        "//proto/ops/v1:ts",
        "//proto/recall/ui/v1:ts",
        "//proto/tasks/ui/v1:ts",
        "//proto/todofy/mail/v1:ts",
        "//proto/ts:http-client",
        "//proto/ts:protobuf",
        "//proto/ts:wire-json",
        "//proto/watch/ui/v1:ts",
    ],
)

workspace_package_link(
    name = "proto_types_link",
    src = ":proto_types_package",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

workspace_package_link(
    name = "edge_auth_types_link",
    src = "//packages/edge-auth:pkg",
)

ts_project(
    name = "types",
    srcs = [":proto_types_package_wire_types"] + (["//personal-mcp/worker/src:types_srcs"] + ["//personal-mcp/worker/test:types_srcs"] + glob(["*.config.ts"])),
    data = [
        ":vitest.config.ts",
        ":vitest.runtime.config.ts",
    ],
    no_emit = True,
    deps = [
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@modelcontextprotocol/server",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/miniflare",
        ":node_modules/standardwebhooks",
        ":node_modules/vitest",
        ":node_modules/zod",
        ":proto_types_link",
        "//:node_modules/@cloudflare/workers-types",
        "//personal-mcp/worker/src:lib",
        "//personal-mcp/worker/test:runtime_helpers",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

wrangler.wrangler_binary(name = "wrangler")

js_library(
    name = "application_sources",
    srcs = ["//personal-mcp/worker/src:application_sources_srcs"] + glob([
        "package.json",
        "tsconfig.json",
    ]),
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":types_typecheck_test",
        "//personal-mcp/worker/test:check",
    ],
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":edge_auth_types_link",
        ":node_modules/@cloudflare/workers-types",
        ":node_modules/@eslint/js",
        ":node_modules/@modelcontextprotocol/server",
        ":node_modules/@types/node",
        ":node_modules/esbuild",
        ":node_modules/eslint",
        ":node_modules/miniflare",
        ":node_modules/standardwebhooks",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":node_modules/wrangler",
        ":node_modules/zod",
        ":package.json",
        ":proto_types_link",
        ":tsconfig.json",
        "//:node_modules/@cloudflare/workers-types",
        "//personal-mcp/worker/src:lib",
        "//personal-mcp/worker/test:runtime_helpers",
        "//tools/workerd-cpu:types",
    ],
    runner = eslint.eslint_binary,
    sources = ["//personal-mcp/worker/src:lint_sources"] + ["//personal-mcp/worker/test:lint_sources"] + glob(
        [
            "scripts/**/*.mjs",
            "*.js",
            "*.ts",
        ],
        allow_empty = True,
    ),
)

js_library(
    name = "package_metadata",
    srcs = [":package.json"],
)

ts_config(
    name = "worker_config",
    src = ":tsconfig.json",
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//personal-mcp/worker/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":types_typecheck_test"],
)

test_suite(
    name = "runtime_tests",
    tests = ["//personal-mcp/worker/test:runtime_tests"],
)

alias(
    name = "lib",
    actual = "//personal-mcp/worker/src:lib",
)

source_audit_files(
    patterns = [
        "*",
        "src/**",
        "test/**",
    ],
    deps = [
        "//personal-mcp/worker/src:source_audit_files",
        "//personal-mcp/worker/test:source_audit_files",
    ],
)
