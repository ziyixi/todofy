    types = ["src/work-store.ts"],
    deps = [":node_modules/zod", ":work-model", ":work-read"],
)

js_library(
    name = "work-tools",
    srcs = ["src/work-tools.ts"],
    types = ["src/work-tools.ts"],
    deps = [":node_modules/@modelcontextprotocol/server", ":work-model", ":work-store"],
)

