    deps = [":edge_auth_types_link", ":lib", ":node_modules/@cloudflare/workers-types", ":node_modules/@modelcontextprotocol/server", ":node_modules/@types/node", ":node_modules/standardwebhooks", ":node_modules/vitest", ":node_modules/zod", ":proto_types_link"],
