workspace_package_link(name = "proto_types_link", src = ":proto_types_package", runtime_dependencies = ["@bufbuild/protobuf"])
workspace_package_link(name = "edge_auth_types_link", src = "//packages/edge-auth:pkg")
workspace_link(name = "auth_test_edge_auth_link", src = "//packages/edge-auth:pkg")
proto_vitest_test(
    name = "auth_test",
    runner = vitest.vitest_test,
    tests = ["test/auth.test.ts"],
    deps = [":module_group_15"],
    data = [":auth_test_edge_auth_link", ":node_modules/vitest", "package.json"],
)

