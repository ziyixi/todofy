{
  "name": "personal-mcp-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run --config vitest.config.ts",
    "pretest:runtime": "node ../../proto/tools/ensure.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@ziyixi/edge-auth": "workspace:*",
    "@ziyixi/proto": "workspace:*",
    "standardwebhooks": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
