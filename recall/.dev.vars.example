# Local development only. Copy to recall/.dev.vars (gitignored; wrangler reads the .dev.vars next to the config) and
# run, from worker/: npm run dev (http://127.0.0.1:8797, with ../wrangler.test.toml). Synthetic values only; never a real
# owner address, key or token.
BUILD_SHA=dev
# Loopback-only login bypass (http://localhost, 127.0.0.1 or [::1] without cf-ray; 503 anywhere else).
DEV_AUTH_BYPASS=true
ACCESS_OWNER=owner@example.com
# A locally generated 64-hex key, e.g. `openssl rand -hex 32`:
# The machine tokens: make them in the local UI (设置 → 插件口令), as in production.
# A loopback fake of Dropbox for 设置 → 备份到 Dropbox (honored only with DEV_AUTH_BYPASS=true), e.g. the smoke run's:
# DEV_DROPBOX_ORIGIN=http://127.0.0.1:8798
