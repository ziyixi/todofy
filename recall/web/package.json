{
  "name": "recall-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The UI of the owner's browsing record (Chinese, mobile first, no framework): the timeline, the search and the settings, built into ../web/dist and served by the Worker \"recall\".",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "vite",
    "typecheck": "bazel test //recall/web:typecheck_tests",
    "lint": "bazel test //recall/web:lint",
    "test": "bazel test //recall/web:unit_tests",
    "build": "bazel build //recall/web:bundle",
    "check:dist": "bazel build //recall/web:bundle",
    "check": "bazel test //recall:check"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
