{
  "name": "recall-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "recall's Chrome extension (Manifest V3, no runtime dependency): visits with their focus, page texts after ten seconds of focus, scrubbed and uploaded to the Worker \"recall\". Built into dist/ and a zip; installed into ~/recall-extension.",
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "typecheck": "bazel test //recall/extension:typecheck_tests",
    "lint": "bazel test //recall/extension:lint",
    "test": "bazel test //recall/extension:unit_tests",
    "build": "bazel build //recall/extension:extension_artifact",
    "install-extension": "node scripts/install.mjs",
    "test:browser": "bazel test //recall/extension:browser_tests",
    "check": "bazel test //recall:check"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
