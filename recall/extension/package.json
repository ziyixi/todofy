{
  "name": "recall-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "recall's Chrome extension (Manifest V3, no runtime dependency): visits with their focus, page texts after ten seconds of focus, scrubbed and uploaded to the Worker \"recall\". Built into dist/ and a zip; installed into ~/recall-extension.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "tsc --noEmit",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint .",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "prebuild": "node ../../proto/tools/ensure.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "install-extension": "node scripts/install.mjs",
    "test:browser": "node test/options-browser-runner.mjs"
  },
  "dependencies": {
    "@ziyixi/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
