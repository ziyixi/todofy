js_library(
    name = "build_assets",
    srcs = glob([
        "src/*.html",
        "src/*.css",
    ]),
)

test_suite(name = "check")

proto_package(
    name = "build_proto",
    deps = [
        ":src__capture-script",
        ":src__options",
        ":src__probe-script",
        ":src__sw",
        "//proto/ts:protobuf-wkt",
    ],
)

workspace_package_link(
    name = "build_proto_link",
    src = ":build_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

expand_template(
    name = "build_identity",
    out = "build_identity.json",
    stamp = -1,
    stamp_substitutions = {
        "__COMMIT__": "{{BUILD_EMBED_LABEL}}",
        "__TIME__": "{{BUILD_TIMESTAMP}}",
    },
    substitutions = {
        "__COMMIT__": "dev",
        "__TIME__": "946684800",
    },
    template = ['{"commit":"__COMMIT__","time":"__TIME__"}'],
)

js_binary(
    name = "builder",
    data = [
        "package.json",
        ":scripts__build",
    ],
    entry_point = "scripts/bazel-build.mjs",
)

js_run_binary(
    name = "extension_artifact",
    srcs = [
        "package.json",
        ":application_sources",
        ":build_assets",
        ":build_identity",
        ":build_proto_link",
        ":scripts__build",
    ],
    args = ["build_identity.json"],
    chdir = "recall/extension",
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["dist"],
    tool = ":builder",
)

ts_project(
    name = "types",
    srcs = glob([
        "src/*.ts",
        "test/*.ts",
    ]) + [
        "vitest.config.ts",
        ":build_proto_wire_types",
    ],
    no_emit = True,
    deps = [
        ":build_proto_link",
        ":node_modules/@types/chrome",
        ":node_modules/@types/node",
        ":node_modules/fake-indexeddb",
        ":node_modules/vitest",
        "//recall/shared:denylist",
        "//recall/shared:diagnostic",
        "//recall/shared:scrub",
        "//recall/shared:segment",
        "//recall/shared:url",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

js_library(
    name = "smoke_sources",
    srcs = [
        "test/fake-chrome.ts",
        "test/smoke-upload.ts",
    ],
    deps = [
        ":build_proto_link",
        ":node_modules/fake-indexeddb",
        ":src__browser",
        ":src__capture",
        ":src__db",
        ":src__focus",
        ":src__store",
    ],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "scripts/**",
            "src/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
