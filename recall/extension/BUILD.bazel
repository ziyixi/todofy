load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//recall/extension:eslint/package_json.bzl", eslint = "bin")
load("//proto/bazel:ts_package.bzl", "proto_package")
load("//tools/bazel:js.bzl", "workspace_package_link")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES", "source_audit_files")
load("//tools/bazel/lint:defs.bzl", "eslint_test")

package(default_visibility = ["//recall:__subpackages__"])

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//recall:__subpackages__"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

js_library(
    name = "test_config",
    srcs = ["vitest.config.ts"],
)

js_library(
    name = "build_config",
    srcs = ["tsconfig.json"],
)

npm_link_all_packages(name = "node_modules")

js_library(
    name = "application_sources",
    srcs = ["//recall/extension/src:application_sources_srcs"],
)

test_suite(
    name = "check",
    tests = [
        ":lint",
        ":types_typecheck_test",
        "//recall/extension/test:check",
    ],
)

proto_package(
    name = "build_proto",
    deps = [
        "//proto/ts:protobuf-wkt",
        "//recall/extension/src:src__capture-script",
        "//recall/extension/src:src__options",
        "//recall/extension/src:src__probe-script",
        "//recall/extension/src:src__sw",
    ],
)

workspace_package_link(
    name = "build_proto_link",
    src = ":build_proto",
    runtime_dependencies = ["@bufbuild/protobuf"],
)

expand_template(
    name = "build_identity",
    out = "build_identity.json",
    stamp = -1,
    stamp_substitutions = {
        "__COMMIT__": "{{BUILD_EMBED_LABEL}}",
        "__TIME__": "{{BUILD_TIMESTAMP}}",
    },
    substitutions = {
        "__COMMIT__": "dev",
        "__TIME__": "946684800",
    },
    template = ['{"commit":"__COMMIT__","time":"__TIME__"}'],
)

js_run_binary(
    name = "extension_artifact",
    srcs = [
        ":application_sources",
        ":build_config",
        ":build_identity",
        ":build_proto_link",
        ":package.json",
        "//recall/extension/scripts:scripts__build",
        "//recall/extension/src:build_assets",
    ],
    args = ["build_identity.json"],
    chdir = "recall/extension",
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["dist"],
    tool = "//recall/extension/scripts:builder",
)

ts_project(
    name = "types",
    srcs = ["//recall/extension/src:types_srcs"] + ["//recall/extension/test:types_srcs"] + [
        ":build_proto_wire_types",
        ":vitest.config.ts",
    ],
    no_emit = True,
    deps = [
        ":build_proto_link",
        ":node_modules/@types/chrome",
        ":node_modules/@types/node",
        ":node_modules/fake-indexeddb",
        ":node_modules/vitest",
        "//recall/shared:denylist",
        "//recall/shared:diagnostic",
        "//recall/shared:scrub",
        "//recall/shared:segment",
        "//recall/shared:url",
    ],
)

alias(
    name = "typecheck",
    actual = ":types_typecheck",
)

eslint_test(
    name = "lint",
    data = [
        ":application_sources",
        ":build_proto_link",
        ":node_modules/@eslint/js",
        ":node_modules/@types/chrome",
        ":node_modules/@types/node",
        ":node_modules/eslint",
        ":node_modules/fake-indexeddb",
        ":node_modules/typescript",
        ":node_modules/typescript-eslint",
        ":node_modules/vitest",
        ":package.json",
        ":tsconfig.json",
        "//recall/extension/test:smoke_sources",
        "//recall/shared:denylist",
        "//recall/shared:diagnostic",
        "//recall/shared:scrub",
        "//recall/shared:segment",
        "//recall/shared:url",
    ],
    runner = eslint.eslint_binary,
    sources = ["//recall/extension/src:lint_sources"] + ["//recall/extension/test:lint_sources"] + ["//recall/extension/scripts:lint_sources"] + glob(
        [
            "*.ts",
            "*.js",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ),
)

test_suite(
    name = "unit_tests",
    tags = ["unit"],
    tests = ["//recall/extension/test:unit_tests"],
)

test_suite(
    name = "typecheck_tests",
    tests = [":types_typecheck_test"],
)

test_suite(
    name = "browser_tests",
    tags = ["browser"],
    tests = ["//recall/extension/test:browser_tests"],
)

source_audit_files(
    patterns = [
        "*",
        "scripts/**",
        "src/**",
        "test/**",
    ],
    deps = [
        "//recall/extension/scripts:source_audit_files",
        "//recall/extension/src:source_audit_files",
        "//recall/extension/test:source_audit_files",
    ],
)
