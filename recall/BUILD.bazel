load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel/audit:sources.bzl", "SOURCE_AUDIT_EXCLUDES")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":worker_artifact",
        "//:.github/actions/release-recall/action.yml",
        "//recall/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://recall:worker_artifact",
        "release:worker:recall",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//recall/deploy:check",
        "//recall/extension:check",
        "//recall/shared:check",
        "//recall/web:check",
        "//recall/worker:check",
    ],
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "worker_bundle",
    srcs = [
        ":config",
        "//recall/web:bundle",
        "//recall/worker:application_sources",
        "//recall/worker:edge_auth_types_link",
        "//recall/worker:lib",
        "//recall/worker:proto_types_link",
    ],
    args = [
        "deploy",
        "--dry-run",
        "--config",
        "wrangler.toml",
        "--outdir",
        "worker_bundle",
    ],
    chdir = "recall",
    env = {
        "CI": "true",
        "WRANGLER_SEND_METRICS": "false",
    },
    include_transitive_types = True,
    include_types = True,
    out_dirs = ["worker_bundle"],
    tool = "//recall/worker:wrangler",
    visibility = ["//recall:__subpackages__"],
)

pkg_files(
    name = "worker_files",
    srcs = [":worker_bundle"],
    prefix = "worker",
    strip_prefix = strip_prefix.from_pkg("worker_bundle"),
)

pkg_files(
    name = "config_files",
    srcs = [":config"],
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "web_files",
    srcs = ["//recall/web:bundle"],
    prefix = "web/dist",
    strip_prefix = strip_prefix.from_root("recall/web/dist"),
)

pkg_tar(
    name = "worker_artifact",
    srcs = [
        ":config_files",
        ":web_files",
        ":worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "extension_files",
    srcs = ["//recall/extension:extension_artifact"],
    prefix = "extension",
    strip_prefix = strip_prefix.from_root("recall/extension/dist"),
)

pkg_tar(
    name = "extension_artifact",
    srcs = [":extension_files"],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "recall",
    srcs = [
        ":config_files",
        ":extension_files",
        ":web_files",
        ":worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

js_library(
    name = "test_config",
    srcs = ["wrangler.test.toml"],
    visibility = ["//recall:__subpackages__"],
)

filegroup(
    name = "source_audit_files",
    srcs = glob(
        [
            "*",
            "docs/**",
        ],
        allow_empty = True,
        exclude = SOURCE_AUDIT_EXCLUDES,
    ) + glob(
        [
            ".env.example",
            ".env.*.example",
            ".dev.vars.example",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "extension_release",
    srcs = [":extension_artifact"],
    tags = [
        "artifact://recall:extension_artifact",
        "release:extension:recall",
    ],
    visibility = ["//visibility:public"],
)
