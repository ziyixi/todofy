load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel:cloudflare.bzl", "worker_artifact")
load("//tools/bazel/audit:sources.bzl", "source_audit_files")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "release",
    srcs = [
        ":worker_artifact",
        "//.github/actions:release-recall/action.yml",
        "//recall/deploy:source_deploy_vars_mjs",
        "//tools:release_probes",
        "//tools/cloud-release:release_inputs",
    ],
    tags = [
        "artifact://recall:worker_artifact",
        "release:worker:recall",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "config",
    srcs = [
        "app.toml",
        "wrangler.toml",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        "//recall/deploy:check",
        "//recall/extension:check",
        "//recall/shared:check",
        "//recall/web:check",
        "//recall/worker:check",
    ],
    visibility = ["//visibility:public"],
)

worker_artifact(
    name = "worker_artifact",
    srcs = [
        ":config",
        "//recall/web:bundle",
        "//recall/worker:application_sources",
        "//recall/worker:edge_auth_types_link",
        "//recall/worker:proto_types_link",
        "//recall/worker/src:lib",
    ],
    bundle_visibility = ["//recall:__subpackages__"],
    tool = "//recall/worker:wrangler",
    visibility = ["//visibility:public"],
    web = "//recall/web:bundle",
)

pkg_files(
    name = "extension_files",
    srcs = ["//recall/extension:extension_artifact"],
    prefix = "extension",
    strip_prefix = strip_prefix.from_root("recall/extension/dist"),
)

pkg_tar(
    name = "extension_artifact",
    srcs = [":extension_files"],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "recall",
    srcs = [
        ":config_files",
        ":extension_files",
        ":web_files",
        ":worker_files",
    ],
    extension = "tar.gz",
    stamp = 0,
    visibility = ["//visibility:public"],
)

js_library(
    name = "test_config",
    srcs = ["wrangler.test.toml"],
    visibility = ["//recall:__subpackages__"],
)

source_audit_files(patterns = [
    "*",
    "docs/**",
])

filegroup(
    name = "extension_release",
    srcs = [":extension_artifact"],
    tags = [
        "artifact://recall:extension_artifact",
        "release:extension:recall",
    ],
    visibility = ["//visibility:public"],
)
