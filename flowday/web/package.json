{
  "name": "flowday",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node ../../proto/tools/ensure.mjs",
    "predev": "node ../../proto/tools/ensure.mjs",
    "dev": "next dev",
    "prebuild": "node ../../proto/tools/ensure.mjs",
    "build": "next build",
    "check:export": "node scripts/check-export.mjs",
    "prelint": "node ../../proto/tools/ensure.mjs",
    "lint": "eslint",
    "pretypecheck": "node ../../proto/tools/ensure.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node ../../proto/tools/ensure.mjs",
    "test": "vitest run",
    "pretest:unit": "node ../../proto/tools/ensure.mjs",
    "test:unit": "vitest run __tests__/unit",
    "pretest:integration": "node ../../proto/tools/ensure.mjs",
    "test:integration": "vitest run __tests__/integration",
    "pretest:ui": "node ../../proto/tools/ensure.mjs",
    "test:ui": "TZ=UTC playwright test",
    "pretest:ui:headed": "node ../../proto/tools/ensure.mjs",
    "test:ui:headed": "TZ=UTC playwright test --headed",
    "test:imports": "bash scripts/check-refactor-imports.sh",
    "prescreenshots:readme": "node ../../proto/tools/ensure.mjs",
    "screenshots:readme": "node scripts/generate-readme-screenshots.mjs",
    "prescreenshots:readme:check": "node ../../proto/tools/ensure.mjs",
    "screenshots:readme:check": "node scripts/generate-readme-screenshots.mjs --check",
    "prescreenshots:ui": "node ../../proto/tools/ensure.mjs",
    "screenshots:ui": "node scripts/generate-ui-goldens.mjs",
    "prescreenshots:ui:check": "node ../../proto/tools/ensure.mjs",
    "screenshots:ui:check": "node scripts/generate-ui-goldens.mjs --check",
    "pretest:watch": "node ../../proto/tools/ensure.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/react": "^0.3.2",
    "@ziyixi/proto": "file:../../proto/ts",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
